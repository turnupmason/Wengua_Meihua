  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "巽",
      "text": "方位取东南，场所依巽参木器之内。若尚未准备好原物描述，可先把确知记号整理清，再托人查曾经使用的木制柜盒。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:16.991Z",
      "textSha256": "55b186ae93a78f1278b95b057882208f4aeb4d0d5fa313d95e76a7446120cb5d"
    },
    {
      "movingLine": 2,
      "changedTrigram": "离",
      "text": "南方与明窗、文书旁是变离给出的线索。若旧查法暂接不上，可先核原来工作台或文件收存的实际记录，能补看的地方留明。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:16.992Z",
      "textSha256": "fa8f5954ba1ed4384615252d989f0f1f0acf8acb37102db0855d0730681050df"
    },
    {
      "movingLine": 3,
      "changedTrigram": "兑",
      "text": "传统方向取西，场所可参泽畔、破壁。若需要沿原路补查，可先问清实际停留处的招领渠道，再由相应人员核安全可见范围。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:16.992Z",
      "textSha256": "5851ba5bb0e968de4df2c9a2d6a2d7e479f3b77523c633f13ec673bb2e8e112d"
    },
    {
      "movingLine": 4,
      "changedTrigram": "离",
      "text": "取象可看南方，离列明窗及文书之侧。若先整理好查找资料，可请原经手者按最后一次收放核文件台，把容易混淆的物件分清。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:16.992Z",
      "textSha256": "1c5f820d4fd3b9029f7f427d4cff5a95b6c0d2e4ee9a0e66e489b41075bb182b"
    },
    {
      "movingLine": 5,
      "changedTrigram": "巽",
      "text": "东南与木器之内是传统提示。若原线索牵出某个确实用过的木柜，可先请对方核具体层格，问实存放动作以后再认原物。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:16.992Z",
      "textSha256": "7b63d7208ff5ac7048f302a31d2252896373092300c9a3f120c14f40e7fdca30"
    },
    {
      "movingLine": 6,
      "changedTrigram": "坤",
      "text": "方位偏西南，坤在原典指仓储、方器等处。若查验渠道已经打开，可请原处核最后确知的方盒或储物格，落实到实物再领取。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:16.992Z",
      "textSha256": "965afcd96fafca90fdd092bd7a37c6223457840243fc433d10cad29aef4bbd8d"
    }
  ]
}
