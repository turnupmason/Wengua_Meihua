  "primaryId": 38,
  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "坎",
      "text": "方位取象在北，水边、鱼盐之地是坎的场所。若原经过涉及相应店铺，可先问其收拾与招领情况，来去消息要接到同一次实际停留。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:21.027Z",
      "textSha256": "1bc611704e032338a5d3eaee9030611eda75b20df54dca930add82c7de884093"
    },
    {
      "movingLine": 2,
      "changedTrigram": "震",
      "text": "东方及闹市、大途可供变震补查。若原来联系不顺，可从确实路过并停留的一处问起，先接通能核到实物的对口渠道。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:21.028Z",
      "textSha256": "30f4f554fde438d7cfb83321e977f2b523c6a89794a10a4ed78d6160f0d9e915"
    },
    {
      "movingLine": 3,
      "changedTrigram": "乾",
      "text": "传统方位取西北，乾列高处、圆器之中。前后说法不同时，可先核物品究竟是否进过那个容器，再请原处辨看独有记号。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:21.028Z",
      "textSha256": "1a583060a3f22f29cf989d25719bccb5c0d96b1a2fcaa4b4e8cb627d4408594f"
    },
    {
      "movingLine": 4,
      "changedTrigram": "艮",
      "text": "东北是变艮的方向，近路边、岩石旁是场所象。若找得到可信协查者，可将真实路旁停留点说明，请其核看当时的收存记录。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:21.028Z",
      "textSha256": "3cef0d9f29fa26646118c8181c4b6689bc1d63251cc14ad2e891bc4ddc788a4e"
    },
    {
      "movingLine": 5,
      "changedTrigram": "乾",
      "text": "方位可参西北，场所见圆器内部或高处。若原来隔开的经手环节能够接上，可请掌管者核实际用过的收纳物，让消息有实物依据。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:21.028Z",
      "textSha256": "7d85d586e6a59251ab8d4a061d30606a248b51de1ba3f8425a1430c7b4dd348d"
    },
    {
      "movingLine": 6,
      "changedTrigram": "震",
      "text": "取象偏东，闹市、道路属于原典列象。起初觉得可疑的答复，可先对照实际经过再核相应场所，把猜想与亲见分开后续查。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:21.028Z",
      "textSha256": "bcb4b08f4df808fa23760b17c588150ac8079cdb80f13a281087c48c2230e859"
    }
  ]
}
