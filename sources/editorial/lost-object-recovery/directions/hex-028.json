  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "乾",
      "text": "方位取象偏西北，乾列高处、圆器之中。若要补查原收纳，可先核实际用过的圆盒或高层格，请能安全接触的人把里面看清。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:17.688Z",
      "textSha256": "2a6fbdbacd020393150a8434f5623f3580f3e115cfdf842ba10257d94c9a0058"
    },
    {
      "movingLine": 2,
      "changedTrigram": "艮",
      "text": "东北与近路边、岩石旁是变艮的场所提示。若有人能补出旧行程的新实据，可从对应停留点问起，补查仍以最后真实携物经过为线。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:17.688Z",
      "textSha256": "2e3921759261c5154e064582e6310795b58e0d99928075b80b809241fc2c06b9"
    },
    {
      "movingLine": 3,
      "changedTrigram": "坎",
      "text": "传统方向为北，坎列水边、酒醋之旁。已有行程若相合，可请原场所补核收拾记录，托查之前把物品记号与那次停留说准。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:17.689Z",
      "textSha256": "b670bcce83dfe4787f15e16dbcd48e4eaa0aadc9e30cd9c8f9eee638e0ce2e15"
    },
    {
      "movingLine": 4,
      "changedTrigram": "坎",
      "text": "取象可参北方，场所见水边、鱼盐之地。若已找到能承接实查的人，可将实际经过的对应场所问清，查询范围贴着原记录走。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:17.689Z",
      "textSha256": "aa98c770de64ed2bc627cd25a88b93c547151ab06c2db786cab5e33d8d2bd8b8"
    },
    {
      "movingLine": 5,
      "changedTrigram": "震",
      "text": "东方及闹市、大途属于变震取象。若新的答复只是表面相像，可先核是哪次真实停留、看见了什么，再向相应招领处辨物。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:17.689Z",
      "textSha256": "5b50e33634a65845c4527dc9f8da9e4f246ef2d9d1685a8a9a8af0825de2bec9"
    },
    {
      "movingLine": 6,
      "changedTrigram": "乾",
      "text": "传统方向取西北，圆器之中、高处可作对照。若仍想深入补查，可先请原处核真实用过的容器与层格，实查条件和权限问明再办。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:17.689Z",
      "textSha256": "1793875265a516e371ae9794d49fc248bca096a062f655f4ad4e5aabd8cff718"
    }
  ]
}
