  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "离",
      "text": "传统方向参南，明窗、文书之侧是离象场所。零碎消息宜先落到实际使用过的一处台面，问明那次整理以后东西如何收起。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:06.471Z",
      "textSha256": "33c048c29fef5f17d6b8f0c83083b44ba5efd7e86129e475d44cf655c59e1c95"
    },
    {
      "movingLine": 2,
      "changedTrigram": "巽",
      "text": "东南是变巽的方位，场所看木器之内。若临时停留处仍可联系，可请原经手者核确实用过的木柜或木盒，按原记号辨认。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:06.472Z",
      "textSha256": "a21269ac7d23f880c8f853b44002a1d27b29a99f1e5bc1e80d7d2705f68ec6ba"
    },
    {
      "movingLine": 3,
      "changedTrigram": "坤",
      "text": "方位取西南，坤列仓储、方器。若原来的暂存依托已变，可先核当时实际用过的储物格及转交记录，接清能继续查的一段。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:06.472Z",
      "textSha256": "2624405acef911d1be10a50770b69c637bbc0bb55dc3ad6ad92bb8337d8d6cf2"
    },
    {
      "movingLine": 4,
      "changedTrigram": "艮",
      "text": "东北与近路边、岩石旁是变艮提示。原路线若有对应停留，可请场所方补问招领与收拾，问到消息以后仍需实看才好认物。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:06.472Z",
      "textSha256": "47cca14e34aad0fc7191330fcb64cb8ecd005876f71c488f488d6634925d49bb"
    },
    {
      "movingLine": 5,
      "changedTrigram": "乾",
      "text": "传统取象偏西北，圆器之中、高处可供参照。若已有较好的协查回复，可再请原处核具体容器和物件特征，把消息接到同一原物。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:06.472Z",
      "textSha256": "701b56a62acb39ef3889ef8526ecad74a8ef037e22a1629c3beb784fdb49fcb4"
    },
    {
      "movingLine": 6,
      "changedTrigram": "震",
      "text": "方位可看东方，场所见闹市、大途。若前面的线索后来落空，可先回核实际行程中的停留点，向对应管理方确认招领记录是否同件。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:06.472Z",
      "textSha256": "fe8b7cf1425d11a22e7022795fcdc8d8effb50c3cba30f8b549e3414b5f52128"
    }
  ]
}
