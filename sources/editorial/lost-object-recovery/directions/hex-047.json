  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "兑",
      "text": "传统方向取西，兑列泽畔、败垣。原行程若能对应，可先请场所管理方核安全可见的停留处，询查所需记录宜保存完整。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.910Z",
      "textSha256": "39a4df28163ef2faa76a00dc8985f84c682a1f8f61e6a4fbbe0e32684ab6eb5e"
    },
    {
      "movingLine": 2,
      "changedTrigram": "坤",
      "text": "方位可参西南，仓储、方器属于坤的场所象。若原处仍能联系，可请熟悉收存的人核实际用过的方盒，把难接的交接环节问明。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.911Z",
      "textSha256": "83e55306477135edaf7fdad13ed6547347f98032f4bcf0f8bba803e3ebe7e7d9"
    },
    {
      "movingLine": 3,
      "changedTrigram": "巽",
      "text": "东南与木器之内是变巽所列。若某处收纳只是猜想，可先核当时是否真的用过那个木柜或木箱，确认后再请有条件的人补看。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.911Z",
      "textSha256": "2ad6b66da51947c59fffff2cf1afecd54befb7f1c2d74323df2f94b0625e5445"
    },
    {
      "movingLine": 4,
      "changedTrigram": "坎",
      "text": "传统取象偏北，水边、酒醋之旁可供对照。若协查进展较慢，可向实际经过的相应场所问收存记录，先核能确认的一段。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.911Z",
      "textSha256": "e27f40853a133f178940777f983cc1adef93ac794bd48a45808185a475824842"
    },
    {
      "movingLine": 5,
      "changedTrigram": "震",
      "text": "方位参东方，场所看道路、闹市。若查询渠道受限，可把最后实际停留点与原物记号交给对口管理方，问清有无招领实物。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.911Z",
      "textSha256": "7381e588f0fb786b64a78062612c2c7d7e4c12462930c7c1889114c23d247559"
    },
    {
      "movingLine": 6,
      "changedTrigram": "乾",
      "text": "西北与高处、圆器之中是变乾的取象。若旧线仍缠住查找，可回核真正用过的容器与层格，找出能实际补看的部分再行动。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.911Z",
      "textSha256": "15df858058b800967e44fd0ce6cfc97500ce5f79b28c1edfd45096e6e32b5d31"
    }
  ]
}
