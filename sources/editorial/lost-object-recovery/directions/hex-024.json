  "primaryId": 24,
  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "坤",
      "text": "取象可参西南，场所依坤看方器和仓储。若刚发现遗失且原收放仍清楚，可先折回实际用过的方盒或储物处，及时补看遗漏。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:18:00.750Z",
      "textSha256": "c2a02d37c4df197d66f9320f991abefa345ab5cf4a6796adcc430a68eb74f74c"
    },
    {
      "movingLine": 2,
      "changedTrigram": "兑",
      "text": "传统方向取西，兑列泽畔、败垣。若可信经手者能协查，可请其核实际经过的相应场所，原物记号与最后亲见时间交清楚。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:18:00.751Z",
      "textSha256": "e84c919e626ced981e66c6243d3b6cadedea6c02694e82606c0bbe3b9f7b7425"
    },
    {
      "movingLine": 3,
      "changedTrigram": "离",
      "text": "南方及明窗、文书之侧是变离的提示。若前次查看有遗漏，可回核确实用过的文件台，按当时整理次序补看，重复查询也要有新据。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:18:00.751Z",
      "textSha256": "47a81ab05b321ce59ab42300e849cfe56ab660c2e23a8b026f54a5ab7716584f"
    },
    {
      "movingLine": 4,
      "changedTrigram": "震",
      "text": "方位参东方，场所可看闹市、大途。可从自己已经确认的携物路线折回，向真实停留处问招领，同行者的猜测另留待核。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:18:00.751Z",
      "textSha256": "d3272fe75521efe37c98fe758afa79b82734f5eae4632168f2d6b30b23aec998"
    },
    {
      "movingLine": 5,
      "changedTrigram": "坎",
      "text": "北方是传统取象，水边、鱼盐之地也在原典中。若相应场所确在原行程里，可据出行与使用记录补问，让回查有具体凭据。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:18:00.751Z",
      "textSha256": "e0bc040585a1effcc132b44339ded27129e97e5a4d1ac332396edb6bac1ce568"
    },
    {
      "movingLine": 6,
      "changedTrigram": "艮",
      "text": "东北与近路边、岩石旁是变艮的场所象。若查找已走偏，可先重排确知行程，只把有实际停留依据的相应处列入补看。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:18:00.751Z",
      "textSha256": "d81a9a3fc150ae4a1c00ce75f04286808e3cf6eaf265f9910046ff710d095336"
    }
  ]
}
