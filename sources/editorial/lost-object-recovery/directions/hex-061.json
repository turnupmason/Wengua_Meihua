  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "坎",
      "text": "传统方向取北，水边、酒醋之旁是坎的场所象。可将可信的使用记录作为起点，原路线若有相应停留，就请场所方核当时收存。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:44.262Z",
      "textSha256": "3ea3f6dbd097029feb9f8f983f1cb1b07d7ce24fc913d83fbd9b3ba9b7844efb"
    },
    {
      "movingLine": 2,
      "changedTrigram": "震",
      "text": "方位可参东方，场所见闹市、大途。若原经手者能真实回应，可按共同确认的行程向相应停留处补问，让辨物资料接到实看。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:44.263Z",
      "textSha256": "4e1a658826a160add92f73d1cf0ad1ac3225ba57f4d32df3ad40a3d701af5e31"
    },
    {
      "movingLine": 3,
      "changedTrigram": "乾",
      "text": "西北与圆器之中、高处属于变乾的传统取象。消息起落较大时，可先核原物是否真进过对应容器，再请能接触的人补看。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:44.263Z",
      "textSha256": "54b17fe1609b3e604b99b3423129db6ecf25a43ffbfe5e3197f63ed7586c7df4"
    },
    {
      "movingLine": 4,
      "changedTrigram": "乾",
      "text": "传统方向偏西北，乾列高处与圆器。若要舍去无据的牵扯，可专核实际收放用过的盒格，亲见记录与转述分别留准。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:44.263Z",
      "textSha256": "54899968d127a8679ad9949ba948e70e2ed4d35df63b6c11c9745daabeb10fce"
    },
    {
      "movingLine": 5,
      "changedTrigram": "艮",
      "text": "方位取东北，艮列近路边、岩石旁。若协查联系能够持续，可将真实停留点与物品记号给同一对口人，请其补核原处招领。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:44.263Z",
      "textSha256": "3048e34464eae462b639768f81372c0944e02620a937677d4f08410e6467769c"
    },
    {
      "movingLine": 6,
      "changedTrigram": "坎",
      "text": "北方及水边、鱼盐之地是变坎提示。若只有声称见过的消息，可先核是否对应真实行程，再请原场所查看同件物品的细节。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:44.263Z",
      "textSha256": "893a3ce148fce76469dcbba907f7967d82575c03c5b51d04b4ea9b5db62563de"
    }
  ]
}
