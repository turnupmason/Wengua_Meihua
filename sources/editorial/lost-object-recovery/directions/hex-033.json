{
  "primaryId": 33,
  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "离",
      "text": "传统方向偏南，场所可参明窗、文书旁。先从最后确知使用过的文件台回核，若要托人补看，把物品记号与当时动作说具体。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:23.191Z",
      "textSha256": "7f6975d01f558297f0888c2b89e79d745773c73a7bcfddbdc855035f58c3d4d7"
    },
    {
      "movingLine": 2,
      "changedTrigram": "巽",
      "text": "方位取东南，巽列木器之内。确实使用过的木柜或木盒宜查得扎实，先核当时放进哪一层、之后谁曾整理，再按实际所见辨物。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:23.191Z",
      "textSha256": "57dfafcd08228e6b3b0bef532920437e5e180dc49cdc5dfa482b54e742500ab3"
    },
    {
      "movingLine": 3,
      "changedTrigram": "坤",
      "text": "西南与仓储、方器是变坤给出的线索。若只能处理局部查验，可先请原处补看有记录的方盒或储物格，把这段收放接清。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:23.192Z",
      "textSha256": "0b888a09beb360f4ef5f2bb7935d4051bb68ccca19fe3ef98467b7bf9d9ba34f"
    },
    {
      "movingLine": 4,
      "changedTrigram": "巽",
      "text": "传统取象在东南，木器之内可作补查范围。若某条无据线索难以放下，可先转核真实用过的木制收纳物，看清原处再定后续。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:23.192Z",
      "textSha256": "2e0a0b28f46777ff4ccfe49e79823088fba90ef1de3cd19d0bc3dc25fe1ac6d8"
    },
    {
      "movingLine": 5,
      "changedTrigram": "离",
      "text": "南方是变离的方位，明窗、文书旁属于场所象。可循实有工作或整理记录核那次取放，查过的纸张与台面应留下明确结果。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:23.192Z",
      "textSha256": "7e179ad68d8ac626f5e7ce13ea0085b1c2807c912c93030ba5063811a1363c28"
    },
    {
      "movingLine": 6,
      "changedTrigram": "兑",
      "text": "方位可参西方，兑列泽畔、旧墙等处。原行程若有对应地段，可向管理方作有据查询，把该查的内容查明以后再收束范围。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:23.192Z",
      "textSha256": "c46b97748147dc5e86d2795b1e7f8ab78a4e85c2588cc12f723fbe9fe9077569"
    }
  ]
}
