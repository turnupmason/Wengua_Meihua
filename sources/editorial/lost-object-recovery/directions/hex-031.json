  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "离",
      "text": "方位取象偏南，离指明窗、文书之侧。初来的印象宜先对照真实使用记录，确在文件台上取放过，便把纸张之间和台面收拾去向核清。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:22.487Z",
      "textSha256": "2d52ba538a163b58447a5ddb8373dbf4e762da79c4325e41c0795fa7eda44d5b"
    },
    {
      "movingLine": 2,
      "changedTrigram": "巽",
      "text": "东南是变巽的传统方向，木器之内可供补看。原来用过的木盒、柜格若仍在，先请人看清里面，再决定是否沿别处的消息走。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:22.488Z",
      "textSha256": "86f725d8d5b8991dd9c32e13163f1667dd3ec41496806e6b328d3ea417509592"
    },
    {
      "movingLine": 3,
      "changedTrigram": "坤",
      "text": "传统取象在西南，场所见仓储、方器。别人提到某个储物处时，先问那次收放是否亲见，再回核自己确实用过的盒格。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:22.488Z",
      "textSha256": "d2bea3dc3039e2b074784a67b19224a9a9915f51f022bd9cb0d97e8c099d6547"
    },
    {
      "movingLine": 4,
      "changedTrigram": "坎",
      "text": "方位可参北方，水边、酒醋之旁是坎的类象。实际经过与此对应时，查询可落到具体经手和招领记录，来回说法再多也要能对证。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:22.488Z",
      "textSha256": "d7a3a35b9c77e0473ee55fd117bec49187b8ad2fecba4a45b3af78998581accd"
    },
    {
      "movingLine": 5,
      "changedTrigram": "震",
      "text": "东方及闹市、大途属于变震取象。可用最后确知携物的行程筛出实际停留点，向原处补问收拾经过，让尚浅的印象接上实据。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:22.488Z",
      "textSha256": "07e99d69cbc15b8cbfb8d0ef636a5e2cdfc49582d869fc10e753633fd5ca8352"
    },
    {
      "movingLine": 6,
      "changedTrigram": "乾",
      "text": "传统方向取西北，圆器之中、高处是原典提示。口头答复若涉及这类收纳，可请能查看的人核原容器内的细节，再认是否同件。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:22.488Z",
      "textSha256": "e219bcbfdef1765a0fdf1ecad694fe22369b62393718e2f5951011eb3972ad50"
    }
  ]
}
