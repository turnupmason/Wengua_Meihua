  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "震",
      "text": "方位可从东方参看，场所取道路或闹市。若最后确认物品还在的一段涉及这些地方，可先核停留、付款和收放的实际记录。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:29.786Z",
      "textSha256": "0f0d70bc7fce06e0974368f3b80e2731679c3087933916a7245ec080e664fbaf"
    },
    {
      "movingLine": 2,
      "changedTrigram": "坎",
      "text": "变坎取北方，水边及鱼盐之地是原典线索。可在已知经过中找相应场所，请其核实当时的台面收拾或招领情况，描述仍照原物。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:29.787Z",
      "textSha256": "6ca4b01a3a254597f4925c973ee9fbbe3f568b58a97c33a0082f137c520d32a7"
    },
    {
      "movingLine": 3,
      "changedTrigram": "艮",
      "text": "取象指向东北，近路边、岩石旁可作场所对照。若只是听说相似物出现在那里，先核消息出处与亲见细节，再决定是否去辨。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:29.787Z",
      "textSha256": "7586d594cccb87c52283c1c14a2d18042015d1185c72ffb58e7dd8c8e2ab9ca3"
    },
    {
      "movingLine": 4,
      "changedTrigram": "兑",
      "text": "传统方位偏西，兑列泽畔、败垣。可先向实际去过的相关场所问招领，联系宜说明最后确知的经过，核得实物后再谈领取。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:29.787Z",
      "textSha256": "4fd7027cc3df5a79cb83a140f138b02c99e21115ee0eb80648e01a845e468838"
    },
    {
      "movingLine": 5,
      "changedTrigram": "坤",
      "text": "西南及仓储、方器是变坤的传统取象。若有人能够查看原收存，可请其先核实际用过的方盒或储物处，认物资料一并交齐。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:29.787Z",
      "textSha256": "245df381cbf29d65f15a8706e484882e9b9fe63d18bc9b1f541b9a1a3e54bead"
    },
    {
      "movingLine": 6,
      "changedTrigram": "巽",
      "text": "东南是变巽的方位，木器之内可供补看。若较晚才想到某个木制收纳处，先核自己是否确实用过，再请能接触原处的人查看。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:29.787Z",
      "textSha256": "8ef895d56bba206b5072634612a21f49ab3f2bca5d349f4d5d8766ade0cdede9"
    }
  ]
}
