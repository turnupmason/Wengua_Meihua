  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "乾",
      "text": "西北与高处、圆器之中是变乾的场所线索。起查无需把陌生地方一并列入，可照实有收放核原盒与储物层，先把眼前可查的一处看清。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:22.850Z",
      "textSha256": "fe9befa35fd563d457134ea54ade3fb8dc0eeb43708bd9e8896598ab3db1d787"
    },
    {
      "movingLine": 2,
      "changedTrigram": "艮",
      "text": "方位参东北，艮列近路边、岩石旁。回查按确知路线持续做，曾经停留又尚未问清的相关场所，可补核招领和当时的经手记录。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:22.851Z",
      "textSha256": "a9e5257f6ae559c50a5f41a2798aa5b9ad98831279ee227f99c15f6655eae656"
    },
    {
      "movingLine": 3,
      "changedTrigram": "坎",
      "text": "北方是传统方向，水边、鱼盐之地可作对照。查问描述宜保持准确，原行程若有相应店铺，可请其核同一次收拾，前后结果留在一起。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:22.851Z",
      "textSha256": "58309f3e4ba57d4750d3c8a29b38fd9388d1f3c2b82892d197b04da84a138a3c"
    },
    {
      "movingLine": 4,
      "changedTrigram": "坤",
      "text": "取象偏西南，坤指仓储、方器之中。若一直守着某个收存处却无实据，可先核自己是否真用过那一盒格，再凭真实记录改查。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:22.851Z",
      "textSha256": "ce939181c0f50ae2b3509365cbeaa5b1e1657924e1175d32b8c6ff0540498533"
    },
    {
      "movingLine": 5,
      "changedTrigram": "兑",
      "text": "传统方位取西，兑列泽畔、败垣。相应场所若确在原路上，可循实际记录请管理方补看，查验过程中有新的证据就据实调整。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:22.851Z",
      "textSha256": "ece506c1a846ed3998429362a1606068315591d29ae870e85cdebea5d65f2330"
    },
    {
      "movingLine": 6,
      "changedTrigram": "离",
      "text": "南方与明窗、文书之侧是变离的取象。反复问查前先核最后使用是否涉及文件台，把实际用过的那一处看清，原结果也留准。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:22.851Z",
      "textSha256": "793b57fde98c1d2a77425b35bd10b8874b9c831036524804f25aedebbfa104fb"
    }
  ]
}
