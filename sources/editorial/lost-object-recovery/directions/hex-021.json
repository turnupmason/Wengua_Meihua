  "primaryId": 21,
  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "坤",
      "text": "西南及仓储、方器之中是变坤的传统场所象。若起头查验有缺口，可先核实际用过的方盒与储物处，边查边补清原记录。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.736Z",
      "textSha256": "11180a4866333ff6a534e27db18bf7e58bdc451282934f1f7ad4dbeb6b128821"
    },
    {
      "movingLine": 2,
      "changedTrigram": "兑",
      "text": "取象可从西方参看，兑列泽畔、破壁。若相应场所确在经过中，可请管理方核安全可见的停留处，查看时把容易遮住的小处问清。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.737Z",
      "textSha256": "65d6374462469bef2a769b56ca0e7a58f2256cda5370e9bd8ed6684fb7403d93"
    },
    {
      "movingLine": 3,
      "changedTrigram": "离",
      "text": "南方是传统方向，明窗、文书旁可作补查位置。原来若在那里整理过东西，可先核文件夹放与台面收拾经过，查得不顺时把描述改准确。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.737Z",
      "textSha256": "4bb47f3d1268fdb7c49f8612f66188ec6c13dc0110305760f367bd7ca7f1f1f5"
    },
    {
      "movingLine": 4,
      "changedTrigram": "艮",
      "text": "方位落在东北，场所取近路边、岩石旁。若找到可核的经手点，可请其对照当时停留记录补看，先查实最难接清的那一步。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.737Z",
      "textSha256": "5d614db8588eb8176e651aa1b52f9059c771845a0f0c3d91b804176c4c0e6658"
    },
    {
      "movingLine": 5,
      "changedTrigram": "乾",
      "text": "西北及圆器之中、高处属于变乾取象。若已有能查看的人，可请其核原用容器与储物层，描述照独有细节给齐，核物过程留记录。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.737Z",
      "textSha256": "5c87780e443b95c464a2a9f86698528d0b47f9c6c922b854bbd63ff4e60ac6dc"
    },
    {
      "movingLine": 6,
      "changedTrigram": "震",
      "text": "传统方向偏东，震列道路、闹市。若查找已多次受阻，可先核是否还有真实停留处未问清，再请当地招领方补查，查询保持有据。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.737Z",
      "textSha256": "346400d6a72bc1017466f13b0c69a6052ecb3ea083c42172894d0467db1f0e1f"
    }
  ]
}
