{
  "primaryId": 2,
  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "震",
      "text": "方位取东方，震在失物章还指闹市、大途。可从最后实际经过的商街或道路问起，核当时是否停留、取用过物品，再联系对应招领处。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.289Z",
      "textSha256": "3aad56d7fd241a8c776f58bbd7abbb84c34a536cd210735eff448c8e5820880f"
    },
    {
      "movingLine": 2,
      "changedTrigram": "坎",
      "text": "北方是变坎的传统方向，水边及酒醋之旁也在原典所列。若确实去过有这些陈设的场所，可按原路线请人查看可接触的台面和收存处。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.290Z",
      "textSha256": "a01e992c96ebbef854cba7701df8deeffe2336cac81326c47fce555fce9bbcf6"
    },
    {
      "movingLine": 3,
      "changedTrigram": "艮",
      "text": "取象落在东北，艮列近路边、岩石旁等处。已有经手记录若涉及路旁停留，可继续请原处核查，土穴之象只留作古籍参照。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.290Z",
      "textSha256": "0de73ee6de9089cef4d1b8c128079d3b6bfaff78b0291c9935886c9607102b63"
    },
    {
      "movingLine": 4,
      "changedTrigram": "震",
      "text": "传统方位偏东，场所可参闹市或道路。核实经过时，把确知带着物品的一段先说清，向相关场所查询所需的识别信息即可。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.290Z",
      "textSha256": "a17ef8a18c4a7ec48e9f698d7dc525f79edb90ba8df6a52844318cec4d8e4997"
    },
    {
      "movingLine": 5,
      "changedTrigram": "坎",
      "text": "方位可参北方，坎还有水边、鱼盐之地的类象。实际经过若有对应店铺，可先问其招领与收拾记录，再核找到的是否同一件物品。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.290Z",
      "textSha256": "eca313bd211d7a32709350e8dc85fd3d39f085c948d0c87cf8d2bcb0488b2094"
    },
    {
      "movingLine": 6,
      "changedTrigram": "艮",
      "text": "东北及近路边是变艮的传统提示。若此前确有路旁放物或停留记录，可请原处帮忙补看，核查范围依实据划清，避免争着认领相似物。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.290Z",
      "textSha256": "7d81ecad3043d172b6e74eb4f59585d73d1c06a5e1b2805f8527a6980c4dfdf0"
    }
  ]
}
