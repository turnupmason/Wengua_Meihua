{
  "primaryId": 13,
  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "艮",
      "text": "方位取东北，艮列近路边、岩石旁。若最后取用发生在出入途中，可按确知路线向沿途管理方查询，物品描述宜清楚公开地给到对口人。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:30.247Z",
      "textSha256": "92f372feb44ea409a72793c3750dbd462e8effc93deded32b866b54b20624c32"
    },
    {
      "movingLine": 2,
      "changedTrigram": "乾",
      "text": "变乾的传统方向是西北，圆器之中与高处是场所提示。若熟悉的人记得原收纳，可请其实际核圆盒或高层格，亲近者的印象也宜对证。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:30.248Z",
      "textSha256": "7a93899c529bfe8204fe0fe72928d3e68fdd241263c7590d1b1f38ae674f0213"
    },
    {
      "movingLine": 3,
      "changedTrigram": "震",
      "text": "取象可参东方，场所见闹市、大途。若已久无进展，可先核真实去过的商街或道路是否尚有可查记录，查找范围依新证再定。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:30.248Z",
      "textSha256": "3f4d8b0cc5f27f6cb1a1e195855bfd897d91f82b76a42b0d376edb558cc12252"
    },
    {
      "movingLine": 4,
      "changedTrigram": "巽",
      "text": "东南与木器之内是变巽的传统线索。可将原物记号交给有权限查看的人，若确实使用过木柜，便请其补看内层，询查以正当核对为宜。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:30.248Z",
      "textSha256": "1ce560eb224b82e2149400b893ae4177d5035a09a36564980cdd06e1603a87e9"
    },
    {
      "movingLine": 5,
      "changedTrigram": "离",
      "text": "南方是方位取象，离还列明窗、文书之侧。若原经手联系已经接通，可请其核实际使用过的文件台，先把隔开的收放记录接清。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:30.248Z",
      "textSha256": "728423d82f3d75713ceaea1ebc32bacdc97698addcdc10683a691360309ba162"
    },
    {
      "movingLine": 6,
      "changedTrigram": "兑",
      "text": "传统方向偏西，场所取泽畔或败垣等。外围协查若涉及这些实际去过的地方，可保留相应招领信息，物件是否同一件仍须看特征。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:30.248Z",
      "textSha256": "d27fd42b5173cc726630005875157109a77ab71f13727a702d64c49e60615f92"
    }
  ]
}
