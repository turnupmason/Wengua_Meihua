  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "乾",
      "text": "西北是变乾的方位，圆器之中、高处是场所象。若初步有人愿意协助，可请其看实际使用过的收纳物，把原来的层位问明。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.574Z",
      "textSha256": "7ae6508c8a74f52ac4e2199adff0f2f8f5916b7066bc3da315ea3e7d66cc3490"
    },
    {
      "movingLine": 2,
      "changedTrigram": "艮",
      "text": "传统方向参东北，场所见近路边、岩石旁。查询所据若真实，可向确曾停留的相关场所补问，原物记号和经手信息给得简明准确。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.574Z",
      "textSha256": "19aa559355aceaf8d86b2996d4980d39fc78c0e82c8106e61171eebc393b9ba7"
    },
    {
      "movingLine": 3,
      "changedTrigram": "坎",
      "text": "北方与水边、酒醋之旁是变坎的提示。原行程若包含相应场所，可联系管理方核实际收拾记录，先把所需的查看条件接通。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.575Z",
      "textSha256": "41ff6ad07eef70465f7b94a79b7571d180fec04e1a1a4d4766dde0cb2ff645ce"
    },
    {
      "movingLine": 4,
      "changedTrigram": "震",
      "text": "方位可看东方，闹市、大途属于震象。若要通过合适渠道继续查，可将确知经过的一段与物品特征交明，请原停留处核招领。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.575Z",
      "textSha256": "446cf922ee63f42e75a54f7bb6845efebae0c0468713199dd853cb60a269bdc7"
    },
    {
      "movingLine": 5,
      "changedTrigram": "坎",
      "text": "传统方向偏北，水边、鱼盐之地可作场所参照。可按真实路线逐步补问相关店铺，原经手回复与实物识别资料应接在一起。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.575Z",
      "textSha256": "4868157569926b8c9a95ec9e9e180815d7d343d4f43d1e637be021f15e34462d"
    },
    {
      "movingLine": 6,
      "changedTrigram": "艮",
      "text": "东北及近路边是变艮的传统线索。若查找已久，可先复核真实停留中还有哪处能补看，把有证的一段查明并保存结果。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.575Z",
      "textSha256": "45feb7ad548392df8c872b3dbd978faf842f5539b428b57dd5240ddbe9a4be53"
    }
  ]
}
