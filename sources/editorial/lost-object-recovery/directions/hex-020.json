  "primaryId": 20,
  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "震",
      "text": "方位可参东方，场所见闹市、道路。若只记得大概经过，可先用出行记录缩清真实停留点，再向对应场所问招领。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.402Z",
      "textSha256": "9e3aa4cc560b2410a64859323124996f9e6e14d72786ed7386cd981b750a0854"
    },
    {
      "movingLine": 2,
      "changedTrigram": "坎",
      "text": "传统方向为北，坎列水边、酒醋之旁。原行程若有对应餐饮或临水场所，可先核亲见细节，能实际查看的部分再请人补查。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.403Z",
      "textSha256": "259bda2420ba82dd6e70b3c8d39298ce79288497f7ae0465547852eb38bea342"
    },
    {
      "movingLine": 3,
      "changedTrigram": "艮",
      "text": "东北是变艮的方位，近路边、岩石旁可作场所参照。若回想收放时发现某次停留未核清，可用真实记录补问那一处。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.403Z",
      "textSha256": "8f454868d4d7f1d7f27b1604ceb13bfc9471f542517699948244b405f41783eb"
    },
    {
      "movingLine": 4,
      "changedTrigram": "乾",
      "text": "方位取象在西北，乾有楼阁、高处与圆器等场所。若原场所允许核查，可向掌管者问实际使用过的高层格或容器，先看可查条件。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.403Z",
      "textSha256": "d9377390d4cd18f259d2d884fbdf60823672c5a174cd55565654016eb2009c3f"
    },
    {
      "movingLine": 5,
      "changedTrigram": "艮",
      "text": "取象参东北，场所依艮看近路边。可从自己确知的携物经过反查，若对应停留处仍可联系，先问有没有当时的招领或收存记录。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.403Z",
      "textSha256": "f0a190d8987ed9f241125dfb5c606a1ca785b6fa508dfe29c4a5b7e338541146"
    },
    {
      "movingLine": 6,
      "changedTrigram": "坎",
      "text": "北方与水边、鱼盐之地是此处变坎的提示。若需要请他人核查，可把已经证实的行程给准，托其向真正经过的相应场所问明。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.403Z",
      "textSha256": "196928bf9272dfeda24ae17f1048c165518a912bef764bb48cc11bd4d544d145"
    }
  ]
}
