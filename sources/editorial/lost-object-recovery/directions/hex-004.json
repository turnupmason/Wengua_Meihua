  "primaryId": 4,
  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "兑",
      "text": "方位取象可参西方，兑在失物章列泽畔、破壁。实际经过若有对应场所，可向管理方问清招领情况，以原物特征解疑。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.963Z",
      "textSha256": "db4b902729649a7268b19c84e808db1fa8386b56b61f7c890887b86aebda1266"
    },
    {
      "movingLine": 2,
      "changedTrigram": "坤",
      "text": "西南是变坤的传统方向，方器、仓储可供对照。若有能接手查验的人，可请其按真实收存顺序核用过的方盒与储物位置。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.964Z",
      "textSha256": "b76d6ac8e8882649a047169a0a1fd468288a6a35b326fbbc725e0f02e350784f"
    },
    {
      "movingLine": 3,
      "changedTrigram": "巽",
      "text": "取象偏东南，场所可参木器之中。先问最后一次是否确有放进木柜、木盒的动作，再核实物，凭印象追随新说法时宜留一步查证。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.964Z",
      "textSha256": "8ca99cf6c26544e34c05ab8ba56e98a7259a591587d30f7e6ed2de23b82d275f"
    },
    {
      "movingLine": 4,
      "changedTrigram": "离",
      "text": "方位可参南方，离有明窗、文书旁的提示。若最后接触处能查到文件或窗边的取放记录，可从那里补证，口头印象还需落实到物件。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.964Z",
      "textSha256": "86d94fe701c1796c080d40ccbe126850dd1c878939496f1ac8dc3d7fcdef209a"
    },
    {
      "movingLine": 5,
      "changedTrigram": "巽",
      "text": "东南及木器之内是变巽给出的传统线索。可把能辨原件的细节交给熟悉收存的人，请其补查实际用过的木制收纳物。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.964Z",
      "textSha256": "e53b640779fb572f893bf55cf40f21a8b5c565c360ab93420d023b0774dc7022"
    },
    {
      "movingLine": 6,
      "changedTrigram": "坤",
      "text": "传统方向取西南，场所见仓储与方器。若要请人开柜查看，先核原交接和可查范围，再由原处协助辨物，沟通宜清楚有据。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.964Z",
      "textSha256": "706edd4de975f586db92fda74c26b3668ae4b4a5d3c0d720e49614acaaa3d1c2"
    }
  ]
}
