{
  "primaryId": 16,
  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "震",
      "text": "方位可参东方，震在原典还指闹市、道路。若只是突然想起某处，可先核是否确实在那里用过物品，再请对应场所查招领。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:31.268Z",
      "textSha256": "c25a82986492b37aadfe59823af59dbdf1dc9862db5eac1da77fb3a56738c558"
    },
    {
      "movingLine": 2,
      "changedTrigram": "坎",
      "text": "北方是变坎的传统方向，水边、鱼盐之地可作对照。查找中若有相似线索，先问原处实际收拾与登记情况，再辨所见是不是原物。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:31.269Z",
      "textSha256": "e0bcbea3fe59b8ccd78b4a1aa5b1583d218bb97264b24a36fcb666f9b22a8cc7"
    },
    {
      "movingLine": 3,
      "changedTrigram": "艮",
      "text": "取象偏东北，场所见近路边与岩石旁。实际去过的路旁停留点若尚未查清，可先补问当时经手者，记忆有出入处照记录核对。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:31.269Z",
      "textSha256": "f0c20f671e2963288bd76aeb5b63f2aba1e7bd2b5639f8c3b95de220da187573"
    },
    {
      "movingLine": 4,
      "changedTrigram": "坤",
      "text": "西南与仓储、方器之中是变坤给出的线索。若已有能协助查验的人，可请其核原来确实收过东西的柜格或方盒，先查实收放。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:31.269Z",
      "textSha256": "434270061b0d333541daf17fb70cf48c39d5b51402eba0fc2a0883f2de7f5cf7"
    },
    {
      "movingLine": 5,
      "changedTrigram": "兑",
      "text": "传统方向取西，兑列泽畔、败垣。若有相应真实行程，可联系当地招领或管理方补查可见范围，持续询查时也要保住原记录。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:31.269Z",
      "textSha256": "d04ebeb2c38fb20674460bc46faeedaf572372e62acee49e55a5f611b0803f67"
    },
    {
      "movingLine": 6,
      "changedTrigram": "离",
      "text": "方位参南，离的场所包括明窗、文书旁。若发现早先查法欠准，可回到最后实际使用的文件台或窗边位置补看，先纠正能核实的遗漏。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:31.269Z",
      "textSha256": "680649734bcf692b615874bfa58e54dc83052312541ceee00410e2815cd2b0f9"
    }
  ]
}
