  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "震",
      "text": "传统方向取东，场所可看闹市、大途。若最后收放与同行或同批物件有关，可先核共同经过的一段，向实际停留处问招领。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:31.155Z",
      "textSha256": "9640be5de9e0dbf973db3005329734b483ccde2a870caa10dcd5884178957ff7"
    },
    {
      "movingLine": 2,
      "changedTrigram": "坎",
      "text": "北方是变坎的取象，原典还列水边、酒醋之旁。若有人承接查询，可请其先核相应场所的真实收拾记录，答应帮看以后仍待实证。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:31.156Z",
      "textSha256": "dce5b0f8aa0175f4b332cedd0807ccbd6345643d315c63a0e0140948193162df"
    },
    {
      "movingLine": 3,
      "changedTrigram": "艮",
      "text": "方位参东北，场所依艮看近路边与岩石旁。原有经手环节若不清，可从实际停留点补问，先纠正查验缺口，再辨相似物件。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:31.156Z",
      "textSha256": "ea5845eae40dba34742f377b02adcdc82e54068529040f6eaa7ebca35b4aa695"
    },
    {
      "movingLine": 4,
      "changedTrigram": "巽",
      "text": "东南与木器之内可供这一步补查。若已委托能办事的人，可请其核确实用过的木柜或木箱，描述按原物特征交代，少让消息来回转述。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:31.156Z",
      "textSha256": "ccd4cae1f48282698947e63d9c54a6d6cffbc6b5cc8ae711cf903edf8a788dc8"
    },
    {
      "movingLine": 5,
      "changedTrigram": "离",
      "text": "取象偏南，离在原典指明窗、文书旁。若另有可核的文件收存或窗边台面，可据最后一次使用记录补看，让新查询落到具体实物。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:31.156Z",
      "textSha256": "4188e4ab5027388b19459daabd66871e3f88096151b64ad8adec78323ccb36fe"
    },
    {
      "movingLine": 6,
      "changedTrigram": "兑",
      "text": "传统方位取西，泽畔、败垣等是兑的场所象。若实际经过相合，可再向相应管理方核招领和交接，得到回复以后仍需确认原件。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:31.156Z",
      "textSha256": "0fae9a0c7a1dc445166aae5ac4349eebeeac9e49481e014d0c5f72373e46cd0d"
    }
  ]
}
