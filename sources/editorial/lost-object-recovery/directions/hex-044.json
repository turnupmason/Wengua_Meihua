  "primaryId": 44,
  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "乾",
      "text": "方位取象偏西北，圆器之中、高处属于乾的场所。原用容器若还可接触，可先请经手者核里面，初来的相似消息先问实际所见。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:17.929Z",
      "textSha256": "72c01511fe88ca930e6fb82cf62383d41d79ff1b206c3a7eefaaa0a77e0b3de8"
    },
    {
      "movingLine": 2,
      "changedTrigram": "艮",
      "text": "东北与近路边、岩石旁是变艮的提示。若在实际行程里有可问的停留点，可先请管理方核招领，找到疑似物再用原记号辨。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:17.930Z",
      "textSha256": "233411a14d97f46768af94afc53e430c312877a609725c278d014e227bbae355"
    },
    {
      "movingLine": 3,
      "changedTrigram": "坎",
      "text": "传统方向取北，坎列水边、鱼盐之地。原行程若有对应店铺，可请其核当时收拾经过，查询难行时先保存能接着查的实据。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:17.930Z",
      "textSha256": "784bc3f4f5d869bd50138c5d77b00bac71758528fca196546ad212644b18402d"
    },
    {
      "movingLine": 4,
      "changedTrigram": "巽",
      "text": "东南及木器之内可供变巽补查。若原处有实际用过的木柜或木盒，可先核当时是否确实收入，收放环节接清以后再查看。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:17.930Z",
      "textSha256": "758906aad23b4d34294723efa0a962fee454e4f45e0c88ab1e0fa824f76aa3ae"
    },
    {
      "movingLine": 5,
      "changedTrigram": "离",
      "text": "方位可参南方，明窗、文书旁属于离象。若有能掌管原处查验的人，可请其核最后整理过的文件台，资料照原件细节给齐。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:17.930Z",
      "textSha256": "95a62eb36b0a2a101fb5833342ed7c2c88b31064e3572b8f1f4138d9e404f5f9"
    },
    {
      "movingLine": 6,
      "changedTrigram": "兑",
      "text": "西方是传统方向，泽畔与败垣可作场所参照。若查询已牵扯较多，可先向真实去过的相关场所补问，把原物与相似线索分清。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:17.930Z",
      "textSha256": "e5058da8b5b0b42529f015ba7b6146e0c2ac909cf038ba2ccb892b3196daa654"
    }
  ]
}
