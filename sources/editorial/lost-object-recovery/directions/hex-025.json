  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "坤",
      "text": "方位取西南，坤列仓储、方器之中。可从最后真实用过的储物处补看起，若当时曾放进方盒，先核内部与同批收放的物件。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:16.673Z",
      "textSha256": "d8e4283b4aa2d46171674f3831e2f3e3c4023eda742574f6724b412054d3d26b"
    },
    {
      "movingLine": 2,
      "changedTrigram": "兑",
      "text": "西方与泽畔、破壁是变兑的传统提示。实际经过若相合，可向原场所补问收拾与招领情况，把能办的查询先做扎实。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:16.674Z",
      "textSha256": "e0ccccfa87fe59129f7d840c0b1c7019819119c9179f857242c124b9d162cae8"
    },
    {
      "movingLine": 3,
      "changedTrigram": "离",
      "text": "传统方向参南，场所见明窗、文书旁。若有人转来相似消息，可先核原来是否确实在那里用过物品，再按记号辨认。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:16.674Z",
      "textSha256": "2505ea9c199962c0a6c91134a490cfdc685dd9787f3a4e956311c01e9f666a35"
    },
    {
      "movingLine": 4,
      "changedTrigram": "巽",
      "text": "东南及木器之内是此处变巽的取象。若有实际使用过的木柜尚未看清，可请能接触原处的人核查，所问以确知收放为准。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:16.674Z",
      "textSha256": "920af721590bf14487325c77870ce8c4c42ea554ae67ac07888c44e60153d5f5"
    },
    {
      "movingLine": 5,
      "changedTrigram": "离",
      "text": "方位可参南方，离列明窗、文书之侧。若原物使用与文件整理相连，可请原处核那次台面收拾，查看情况照实记下。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:16.674Z",
      "textSha256": "8c9e007ca1c1c1f1bd6a3dd5a8b15f68fce78a310518ed016758e2e38d22caf2"
    },
    {
      "movingLine": 6,
      "changedTrigram": "兑",
      "text": "取象偏西，兑的场所包括水泽边与旧墙附近。只有真实行程能对应时才补问原处，查到疑似物以后先核特征，再安排后续。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:20:16.674Z",
      "textSha256": "daec7dc69e6ff3474b528748069185fe03359643508b489bad8ebddafd1e0dd5"
    }
  ]
}
