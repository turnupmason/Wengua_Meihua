    {
      "movingLine": 1,
      "changedTrigram": "兑",
      "text": "传统方向取西，泽畔、败垣可作兑象参照。若尚有能接通的实际停留处，可尽早请管理方核招领与收拾记录，描述按原物给准。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
