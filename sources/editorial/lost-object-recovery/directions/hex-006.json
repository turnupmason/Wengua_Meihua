  "primaryId": 6,
  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "兑",
      "text": "传统方位取西，场所列泽畔、破壁。已有行程若能对应，可先向当地招领或管理方核问，描述原物时把可核特征说清。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:27.675Z",
      "textSha256": "d9f7826dd88dadbadd558d65878805a26871ad903330c3339f96b735ca15390d"
    },
    {
      "movingLine": 2,
      "changedTrigram": "坤",
      "text": "西南及仓储、方器之中是变坤的取象。可回核确实使用过的储物处，找不到进一步凭据时把旧记录留好，少做无依据的扩查。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:27.676Z",
      "textSha256": "6e43e9740f917c7fb1614db108f9a7c5ce2706e2c89e271a79c3625384382c68"
    },
    {
      "movingLine": 3,
      "changedTrigram": "巽",
      "text": "方位参东南，巽还指木器之内。若物品曾交由他人收存，可请原经手者核木柜、木盒等实际用过的位置，原有凭据宜保留完整。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:27.676Z",
      "textSha256": "4b6cc9a362ff88049d719afdcfa5c357f6e4b7710aebe27cda0a6ddb9b51ebcd"
    },
    {
      "movingLine": 4,
      "changedTrigram": "巽",
      "text": "东南是此处传统方向，场所取木制收纳物内部。可先撤回尚无证据的争论，再按最后确知的收放核一处木柜，把查询转成实看。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:27.676Z",
      "textSha256": "50f258ba830c500aff7a442f56aba52e82b14f8137f119d60d73d13b62c7e46d"
    },
    {
      "movingLine": 5,
      "changedTrigram": "离",
      "text": "方位可从南方参看，明窗与文书旁属于离象。若有公允核查的渠道，可请其调看原工作台或文件收放记录，再对证物品细节。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:27.676Z",
      "textSha256": "2012e7525d123a6b5888da56e1ad2a8e2e0e44401ce70721514fdb640517ff97"
    },
    {
      "movingLine": 6,
      "changedTrigram": "兑",
      "text": "变兑取西方，古籍场所有泽畔、败垣。若曾在那里得到过疑似线索，可先请管理方复核同一实物，领取凭据与原物记号都应留下。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:27.676Z",
      "textSha256": "b665118eb23d6ab80c9238cab16c95dfb5756eef737b28ba9375751ab1c1d2d4"
    }
  ]
}
