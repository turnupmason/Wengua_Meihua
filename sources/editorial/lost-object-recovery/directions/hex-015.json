  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "离",
      "text": "南方、明窗及文书旁是变离的传统取象。可从最后真实整理过的文件或台面细查起，把已核与待核部分留清，补看有证的细处。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:30.903Z",
      "textSha256": "9ae0d43a53ef82bdf0ccdc6791057727e3a2a4c55b1916aeb14818f678f52378"
    },
    {
      "movingLine": 2,
      "changedTrigram": "巽",
      "text": "方位参东南，巽列木器之内。若原经手人记得曾用木盒或木柜，可请其照当时次序补看，先问确定的动作再核实物。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:30.904Z",
      "textSha256": "c31f573985d9074429e687cb80ee5ddbaed03a54ce34ad9971ebbee82fc653c1"
    },
    {
      "movingLine": 3,
      "changedTrigram": "坤",
      "text": "西南是方位提示，坤的场所见仓储、方器。可回核最后实际收存的一批东西，若确实用过方形盒格，再把内部与叠放层看仔细。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:30.904Z",
      "textSha256": "dfe84783054df2c863968041ca68eb50c1d72287c89c9f8b5642127ece061920"
    },
    {
      "movingLine": 4,
      "changedTrigram": "震",
      "text": "传统方向偏东，闹市和大途可作场所参照。若现实经过相合，可向原停留处补问招领，询查照确知经过给出即可。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:30.904Z",
      "textSha256": "fc828f29e579a2ae1bba60f177cf9233d07b0084197a262f03ca2fa070f38697"
    },
    {
      "movingLine": 5,
      "changedTrigram": "坎",
      "text": "北方与水边、酒醋之旁是变坎所列。已有明确经过时，可请相应场所核原收拾与交接记录，查物宜找到能实际查看的一方。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:30.904Z",
      "textSha256": "8e8550e38a9544ab1b1fe60a99acbda090ac66f6eb677336187b23fdb373db8e"
    },
    {
      "movingLine": 6,
      "changedTrigram": "艮",
      "text": "取象指东北，近路边、岩石旁也属艮象。若此前有沿路停留的实据，可托管理方补看原处，协查范围仍围绕确知的经过。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:30.904Z",
      "textSha256": "f52a505b0931363ecd6b2bbfad1e0e8d6e3ba37ebf2ced2816246d2b1d2a3289"
    }
  ]
}
