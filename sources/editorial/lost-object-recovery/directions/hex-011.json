  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "巽",
      "text": "取象可参东南，场所依巽看木器之内。若物品曾与同批东西一起收起，可先查那次实际使用的木柜或箱格，顺着真实收放去核。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:30.804Z",
      "textSha256": "643aaba9e76a5f99af6eeb6eaf76f595cdf63827052409873812940be3685960"
    },
    {
      "movingLine": 2,
      "changedTrigram": "离",
      "text": "传统方向取南，明窗、文书之侧属于离象。若最后经手涉及文件整理，可请对口的人补看原台面与纸张夹放处，把能核的远近线索都留全。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:30.805Z",
      "textSha256": "7bf2bf47cf89c58c81aa69afbc64290299fab165dbd5cb1022137259a544e0a1"
    },
    {
      "movingLine": 3,
      "changedTrigram": "兑",
      "text": "西方是变兑的传统方位，场所可参水泽边或旧墙附近。若原路线涉及这些地方，可托管理方补查实际停留处，并核当前招领消息。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:30.805Z",
      "textSha256": "e5c3071e7a1484bd6dccf34103b49fa054336a9f2c214096f06b75aa08b69232"
    },
    {
      "movingLine": 4,
      "changedTrigram": "震",
      "text": "取象偏东，震列道路、闹市。若有原经手者愿意核查，可将确知停留的商街或道路一段说清，询查重点放在亲见与实物记录上。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:30.805Z",
      "textSha256": "7cc80a94a77603c624a1ae7ca2f97b275a0a219ec7c3326c616260c215740d96"
    },
    {
      "movingLine": 5,
      "changedTrigram": "坎",
      "text": "北方及水边、鱼盐之地可作传统场所对照。若最后行程确实经过相应店铺，可向其核交接与收拾经过，实物凭据接齐以后再认领。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:30.805Z",
      "textSha256": "c898a668f997ba29b0e4e3f882a18bffae1a8f55db0de1c739eff0b9bc181a99"
    },
    {
      "movingLine": 6,
      "changedTrigram": "艮",
      "text": "变艮取东北，近路边、岩石旁是原典场所。旧线索断开时，可先核实际经过中是否还有这样的未查停留点，由有权限的人补看。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:15:30.805Z",
      "textSha256": "45a3941d20bd5adec6a90f1384d9504941f677cacf47b9c00091cdd8b73ba5b7"
    }
  ]
}
