  "primaryId": 39,
  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "离",
      "text": "南方与明窗、文书旁是变离的传统提示。若前路查验不便，可回到最后确实使用过的文件台补看，先核原处还能确认的取放细节。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:21.366Z",
      "textSha256": "5fb944ba8a247479562e8da57e905b3d35929c92ae474473ae450d4ff3298857"
    },
    {
      "movingLine": 2,
      "changedTrigram": "巽",
      "text": "取象可参东南，巽列木器之内。若需请人代查，可把实际用过的木柜或木盒说清，由能接触原处的人核里层与夹放。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:21.367Z",
      "textSha256": "ed449d6dddb5f54e216657d02482f77a18c4a345990dee34917ced0ad48917c8"
    },
    {
      "movingLine": 3,
      "changedTrigram": "坤",
      "text": "西南是传统方位，仓储、方器可供对照。外面线索难接时，可回核原来确有收放的一批物件，先把方盒与储物处的记录接明。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:21.367Z",
      "textSha256": "3c96cf28b317e87a9ed254e63d2f02a71126338e0bde466840e436c5711c4cd2"
    },
    {
      "movingLine": 4,
      "changedTrigram": "兑",
      "text": "方位取西，场所可参泽畔、败垣。若能联系原地管理方，可将实际停留的一段与原物记号交准，请其帮核可查范围。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:21.367Z",
      "textSha256": "8f9d74b4d9f4d38f1b588fbae8c30cf9d8a5cb058dce361a6bbfbbedae0a63a6"
    },
    {
      "movingLine": 5,
      "changedTrigram": "坤",
      "text": "取象在西南，坤列仓廪与方器之中。若有人愿意承接较难的查验，可先托其核有记录的储物处，再将实物细节反馈清楚。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:21.367Z",
      "textSha256": "cc6fde8d513a00cfe345db8b901f56c00563006f359e47298d9914654746b580"
    },
    {
      "movingLine": 6,
      "changedTrigram": "巽",
      "text": "东南及木器之内属于变巽的线索。若需要转请有条件的人协助，可把真实木制收纳物与原经手说具体，补查看到哪一层也请留明。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:21.367Z",
      "textSha256": "958dd2f8e1ed76898ac4dc67d12684af63aad79cd5e325d36b26e426ff713a5c"
    }
  ]
}
