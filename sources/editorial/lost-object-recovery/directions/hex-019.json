  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "坎",
      "text": "传统取象偏北，场所列水边、鱼盐之地。若原行程确有相应店铺，可将最后使用与交接经过说明，请其补查当时收拾的物件。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.065Z",
      "textSha256": "9c4a1e7ac6accb3946e839d8118709d7b14fe1d6996acb3e3b5ffdeed0a6b7ee"
    },
    {
      "movingLine": 2,
      "changedTrigram": "震",
      "text": "东方与道路、闹市是变震的线索。若有实际同行者愿意帮查，可先核共同停留的一段，把物品特征交给能看原处的人。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.066Z",
      "textSha256": "f3e0875dfb9b46de0b920c3bbec6d5fda7794997ec22d18f7e1f791ef85c09b4"
    },
    {
      "movingLine": 3,
      "changedTrigram": "乾",
      "text": "方位参西北，乾列高处、圆器之中。若熟悉处有人说可能看过，可先问究竟是哪一个容器或层格，再核是否与真实收纳相符。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.066Z",
      "textSha256": "8a4b696baeb688d9b5696995f8c4033f3b83e81f47de85dbe37e1c027231a620"
    },
    {
      "movingLine": 4,
      "changedTrigram": "震",
      "text": "取象落在东方，场所可看大途和闹市。若末后需要亲到原处辨认，可先核沿途停留记录与招领答复，认物资料准备准确。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.066Z",
      "textSha256": "8e397d37ce97b660a32425ca860d476b58bd666f4bb84e761fac44ab0444312c"
    },
    {
      "movingLine": 5,
      "changedTrigram": "坎",
      "text": "北方是变坎的传统方向，水边或酒醋旁可供对照。若已有可靠经手者，可请其按原行程查相应场所的收存情况，再核同件。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.066Z",
      "textSha256": "4ae28e71cea9b2fbf7b060e61cdcc677ff5c33c7501b232ffa13b115211ff82b"
    },
    {
      "movingLine": 6,
      "changedTrigram": "艮",
      "text": "东北、近路边及岩石旁属于艮的场所取象。若还有能协助的人，可将确知停留点与物品记号交明，请其在实际可查范围补看。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:17:59.066Z",
      "textSha256": "6c2aa1dbf55354be937ece62c60d8f16e9d4c9f2b1e6cf88e559f2cf9be40d74"
    }
  ]
}
