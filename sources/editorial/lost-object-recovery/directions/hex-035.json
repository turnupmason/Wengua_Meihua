  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "震",
      "text": "取象指东方，场所可参闹市、大途。原路线若有对应停留点，可先补问招领与收拾记录，尚未得到信实时把原物描述给稳。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:23.912Z",
      "textSha256": "71f70e738432f2e8d89051c361d177edf4048ff72d26c0f41559f1e1dddf595a"
    },
    {
      "movingLine": 2,
      "changedTrigram": "坎",
      "text": "北方是变坎的传统方位，水边、酒醋旁可供对照。若有人能够从原处协查，可请其按真实经过问相应场所，先补齐原物记号。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:23.913Z",
      "textSha256": "4c263363d41f4f2f39507419bda149ea36bafbb60d2855c87915aaf99ccd916b"
    },
    {
      "movingLine": 3,
      "changedTrigram": "艮",
      "text": "传统方向取东北，艮列近路边、岩石旁。多人给出一致消息时，仍可核所指是否为同一次停留，再向对应场所确认实物。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:23.913Z",
      "textSha256": "1abb19a7ab141afcefaa8797b7617892b7545cafaaca3a803703af3e882592c0"
    },
    {
      "movingLine": 4,
      "changedTrigram": "艮",
      "text": "东北及近路边是此爻变艮的场所提示。线索若四处牵扯，可用已证实的行程划清应问的停留点，让查询落到能查看的一处。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:23.913Z",
      "textSha256": "c37ba9a5095e0b50ebb53fc4a9023851af87f458e1cb87ac3a98a35314eb1470"
    },
    {
      "movingLine": 5,
      "changedTrigram": "乾",
      "text": "方位可看西北，乾指高处、圆器之中。若能由原处经手者承接核查，可将原收纳方式交准，请其实际看容器与层格。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:23.913Z",
      "textSha256": "5978509f114e50e16c79aa83fa11a2ffe42bef3fb6959992a4d2ba7bda827d74"
    },
    {
      "movingLine": 6,
      "changedTrigram": "震",
      "text": "取象偏东，闹市和道路属于震象。若需要处理主要查询堵处，可先向确实停留过的相关场所核交接，范围贴着现有记录逐项厘清。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:23.913Z",
      "textSha256": "809259d2c5e317cf1d7ee3c5a3c06f1d1efeaf70b42c5cf0edbdcec4af6994c4"
    }
  ]
}
