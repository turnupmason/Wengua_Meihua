  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "艮",
      "text": "东北与近路边、岩石旁是变艮的传统取象。先把最后确知的取放次序排清，实际停留若与此相合，可向原处补问招领和收存记录。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:20.641Z",
      "textSha256": "f737bab11a9c19366f084fdafcf1fafb7a1dee4412766553cab3464d84a0becc"
    },
    {
      "movingLine": 2,
      "changedTrigram": "乾",
      "text": "方位偏西北，场所可参圆器之中、高处。若原物多在固定收纳处使用，可请熟悉原处的人核确实用过的盒柜，先查清那次日常取放。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:20.642Z",
      "textSha256": "6a1045b36f5a6a621729b7fdb666fd9a195cbae86187f2fb0a1d5a76800eb8d2"
    },
    {
      "movingLine": 3,
      "changedTrigram": "震",
      "text": "传统方向取东，闹市、道路属于震象。若要补查原经过，可先向相应停留处问亲见与交接，已核内容记录清楚，问查措辞有分寸。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:20.642Z",
      "textSha256": "55b9af53a6150060b1f1aa9e2ee3b4b10922fed61cf171f975968ab34f8353c7"
    },
    {
      "movingLine": 4,
      "changedTrigram": "乾",
      "text": "西北是变乾的方位，圆器、高层收存可作场所对照。若原处仍能配合，可核实际用过的容器与层格，把已有辨物资料交给经手方。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:20.642Z",
      "textSha256": "988dbe7fd6e3ba432e10496e08447bfae82de91d8a3ffacb609402f642c8a911"
    },
    {
      "movingLine": 5,
      "changedTrigram": "艮",
      "text": "取象参东北，艮列近路边、岩石旁。若最后一段收放能接到沿路停留，可请真正掌握原处情况的人补查，让协助落到具体实物。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:20.642Z",
      "textSha256": "2368e59df91a2d291c79a1e1b35de280762e7a32ec502caceb778379b344e339"
    },
    {
      "movingLine": 6,
      "changedTrigram": "坎",
      "text": "北方与水边、酒醋之旁是变坎的传统线索。原行程若能对应，可据真实记录请场所方查看收存，亲见细节与原照片对齐以后再认领。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:22:20.642Z",
      "textSha256": "268694b2d7d797cde35f4c3c1fc420c3004ad7fc3195769346283109169c7b78"
    }
  ]
}
