  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "艮",
      "text": "东北是传统方位，艮的场所包括近路边、岩石旁。若原经过尚可确认，可先向对应停留处问招领，把实际见过与后来听说的分清。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:24.275Z",
      "textSha256": "80671b1143dac5b33ccd02402e659dca8ca405525ea33c6184c518b136bcb4b9"
    },
    {
      "movingLine": 2,
      "changedTrigram": "乾",
      "text": "方位取西北，场所参圆器之中或高处。若有能实际查看的人，可将原容器与物品记号说明，请其帮核原收纳，援助宜落到实看。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:24.276Z",
      "textSha256": "2ebbba318de396ffab64896c46e5fad68eb5965cfad2a9f2d9992e718647de0f"
    },
    {
      "movingLine": 3,
      "changedTrigram": "震",
      "text": "传统取象在东方，震列闹市、大途。原行程中若找出一处关键停留，可先核当时经手与收拾经过，得到要点以后再补齐后续。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:24.276Z",
      "textSha256": "60f62902b6389f2599f7feb09ae23f3346d1a2597702eb0076029baa83b3042b"
    },
    {
      "movingLine": 4,
      "changedTrigram": "震",
      "text": "方位可参东，场所见道路、闹市。若能够查明原来一段隐约经过，可据真实停留向对应场所问招领，把所得详情留清再续查。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:24.276Z",
      "textSha256": "f2935e096357f371dc2eb12535450f70d5292ad53f198df8cf0f053b1633a4c5"
    },
    {
      "movingLine": 5,
      "changedTrigram": "坎",
      "text": "北方与水边、鱼盐之地是变坎提示。可将原物资料妥善交给能核实的经手方，若实有相应行程，请其查具体收存记录。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:24.276Z",
      "textSha256": "bf51b0cb33ea648b09f6dc29ae3e4dadf4346679cb7773f50d60558bc618d890"
    },
    {
      "movingLine": 6,
      "changedTrigram": "艮",
      "text": "取象偏东北，近路边与岩石旁属于艮的场所。原来明白的线索若渐渐接不上，可回核最后确知停留点，以实际记录重新限定补查。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:21:24.276Z",
      "textSha256": "052bb99a8923efc063a1b1197a4a7b70dd4c929289795ae2280b8ef62c5c99b9"
    }
  ]
}
