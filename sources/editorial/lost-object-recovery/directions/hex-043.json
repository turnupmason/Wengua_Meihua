  "primaryId": 43,
  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "巽",
      "text": "方位可参东南，场所取木器之内。初查先核确实使用过的木柜、木盒，把需要原处协助查看的层格说明，实看条件问妥再往。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:17.608Z",
      "textSha256": "3b84e5ed460ab0f9bfe4d7e53e4d922fd0c00e64da0b40aeed6f35ca7f003dc4"
    },
    {
      "movingLine": 2,
      "changedTrigram": "离",
      "text": "传统方向偏南，离有明窗、文书旁的提示。若原物是在整理文件时取用，可请原经手者核台面与纸间，及时把遗漏的细节留清。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:17.609Z",
      "textSha256": "ffc986a0ea655dd76cc8f62a0dfb90c6765f9a90e83668db0623e9fade42fa48"
    },
    {
      "movingLine": 3,
      "changedTrigram": "兑",
      "text": "西方及泽畔、败垣是变兑的古籍取象。实际经过若相合，可通过对应管理方补查停留处，把原物特征如实给出便于辨认。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:17.609Z",
      "textSha256": "33546c501f67388cc8e989a5d3a964d192b47481280e797b3df50a261aac61d7"
    },
    {
      "movingLine": 4,
      "changedTrigram": "坎",
      "text": "方位取北，场所见水边、酒醋之旁。若现实线路涉及相应处，可先联系原场所问招领和收拾，能查看的部分请对方说明。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:17.609Z",
      "textSha256": "40509cbadaa8cfaa671ccbacbab1129cb942b2a91cb737254d2428687f4457a1"
    },
    {
      "movingLine": 5,
      "changedTrigram": "震",
      "text": "东方是变震的方向，闹市、大途可作场所对照。若原线索纠缠，可用出行记录核确实停留的一段，向相应招领处问实物。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:17.609Z",
      "textSha256": "64f5cd058209213137b56b519d95da070b66fa0bf93d3f42467fbe99078fd42b"
    },
    {
      "movingLine": 6,
      "changedTrigram": "乾",
      "text": "传统取象在西北，乾列高处、圆器之中。若原收放尚有可查的容器或层格，可请原处补核到底，把查看与辨认结果一并留好。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:17.609Z",
      "textSha256": "43da076111cc15bcb30fea2736558ee6d048c6f759e51508c953a7cfb05e15a8"
    }
  ]
}
