  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "震",
      "text": "东方及闹市、大途是变震的取象。消息零乱时，可先照最后确认携物的一段筛出真实停留处，向当地招领方核相应记录。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.258Z",
      "textSha256": "23db1db2cfba0e60479055878685f92b671b163506d37cf6d156e6eb2171123b"
    },
    {
      "movingLine": 2,
      "changedTrigram": "坎",
      "text": "传统方向为北，水边、酒醋之旁属于坎的场所。若原经手联系能接上，可请其查实际经过的对应场所，先把识别原物的资料交清。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.258Z",
      "textSha256": "3c21cdcbab59f72f265eb9676b12ccbe6c52c27bcc83c3b123761824209f9df8"
    },
    {
      "movingLine": 3,
      "changedTrigram": "艮",
      "text": "取象偏东北，近路边、岩石旁可供参照。若求查尚有难处，可从真实路旁停留处补问，消息出处与能查看的范围先留明。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.258Z",
      "textSha256": "44b6b80f51222e03422d0b33bcb82013449f7a46b77af22f8f1390263abb9d77"
    },
    {
      "movingLine": 4,
      "changedTrigram": "坎",
      "text": "北方是变坎的传统方向，场所看水边或鱼盐之地。若能借到协查，可请对口的人核相应实际场所的收拾记录，再认所见物件。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.258Z",
      "textSha256": "524f11b43d948d79b3d1fc320355a1f01fc01297f8331c0d06632f913f75c9bc"
    },
    {
      "movingLine": 5,
      "changedTrigram": "震",
      "text": "方位取东方，震列道路、闹市。若聚来的消息仍待核，可用原行程确认每个实际停留点，向能看招领实物的人说明原件记号。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.258Z",
      "textSha256": "f06ea5f7c4094039e0940f6e9c29c763bd45d46a2595572c103cad5145150901"
    },
    {
      "movingLine": 6,
      "changedTrigram": "乾",
      "text": "传统取象落在西北，乾有高处、圆器之中等场所。若收尾仍为查物所困，可先请原处核真实用过的容器与储物层，留下可查凭据。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:18.258Z",
      "textSha256": "c91f3766cfa97ec27dda002ff497e7acb9c21d707a2f7e87cf169ac5c012448b"
    }
  ]
}
