    {
      "movingLine": 1,
      "changedTrigram": "坤",
      "text": "方位取西南，坤又有仓储、方器之中的线索。起初收放若还可追，可先检查确实用过的方盒或储物处，分清已看与待看的部分。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.636Z",
      "textSha256": "447db50d1be150f290512a62ae4874b216b54445f169506bc3cb5682131331be"
    },
    {
      "movingLine": 2,
      "changedTrigram": "兑",
      "text": "传统取象偏西，兑列泽畔与败垣之处。若现实路线相合，宜由当地管理方核实曾停留的安全区域，补查可以继续，日期另依应期栏。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.637Z",
      "textSha256": "2cf5a45ebecbfff1fb008c2a52521158f72662c40fb662666b76f6dfa5a90255"
    },
    {
      "movingLine": 3,
      "changedTrigram": "离",
      "text": "南方与明窗、文书之侧是此处变离的取象。可先核最后使用是否与文件整理有关，有明确记录再查看，线索接不上时先收住无据的寻觅。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.637Z",
      "textSha256": "753b6a134f1385608b8b03df9f6ce86a556548404802d20085539e8edd607699"
    },
    {
      "movingLine": 4,
      "changedTrigram": "兑",
      "text": "方位参西方，场所依兑取泽畔或旧墙附近。原经手处若能给出明确回应，可托其核看实际经过的一段，实物特征对得上以后再往。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.637Z",
      "textSha256": "eb02cd928213cd993d2bbd21a2bb74ef2a24636efbae145e00771d8a0f14b0c6"
    },
    {
      "movingLine": 5,
      "changedTrigram": "坤",
      "text": "变坤取西南，仓廪与方器是原典的场所提示。可把已知那次收存说具体，先核一处确实使用过的储物格，有限线索宜用在能查实的地方。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.637Z",
      "textSha256": "5e03e8afbbf141c4e2c45e4053c402f7e19f7169508c6058475374e5d4bdd49f"
    },
    {
      "movingLine": 6,
      "changedTrigram": "巽",
      "text": "传统方位是东南，巽列木器之内。若仍有未看清的木制箱柜，可请熟悉原收纳的人补看深层，查找已久时尤其要分清新证与旧猜测。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:26.637Z",
      "textSha256": "3e9c3df1d99d8b54db1c1d6469a0038c4186c9351ca4911f6319b930c8f03b15"
    }
  ]
