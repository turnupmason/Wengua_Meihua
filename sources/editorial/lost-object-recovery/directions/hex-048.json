  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "乾",
      "text": "方位取象在西北，乾列圆器之中、高处。先核旧收纳是否仍有可查条件，实际用过的盒格能看就看清，原处无法确认的另记下来。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:19.239Z",
      "textSha256": "5b0fa8be45969cd5e10e32699e26310ee05b2f9406014e599fd33e672331bfb4"
    },
    {
      "movingLine": 2,
      "changedTrigram": "艮",
      "text": "东北是变艮的传统方向，近路边、岩石旁可作补查参照。若原消息只到沿路某处，可先核真实停留时间，再向相应招领处问物件。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:19.240Z",
      "textSha256": "575da19ed1fd80039fe877e8708d2ce83ec7ff2915c60d1d042f538e57e8af61"
    },
    {
      "movingLine": 3,
      "changedTrigram": "坎",
      "text": "取象偏北，坎的场所包括水边、酒醋之旁。若已有实物线索尚无人核看，可联系原经手或管理方，请其补查对应的真实经过。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:19.240Z",
      "textSha256": "315ce7dc25e55c02bd2ca9fdcfe53afaec7505e017194026a05c910f17f61320"
    },
    {
      "movingLine": 4,
      "changedTrigram": "兑",
      "text": "传统方位取西，场所见泽畔、破壁。若查询办法已重新理顺，可请真实经过处的管理方核安全区域与收存记录，先补清旧缺口。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:19.240Z",
      "textSha256": "afd7d57726594665993448dbe8e5bf8c7d0ce5f7042e1d615aeac19bec582a57"
    },
    {
      "movingLine": 5,
      "changedTrigram": "坤",
      "text": "西南与仓储、方器之中是变坤提示。若原处能查，可请其把实际用过的方盒或储物格看清，所见细节与原物资料对上再领。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:19.240Z",
      "textSha256": "6bd4f5c451fe277f2b7b1cf268972eb8afb2024b52ff6c9818e3e5c74f327052"
    },
    {
      "movingLine": 6,
      "changedTrigram": "巽",
      "text": "方位可参东南，巽列木器之内。若查验渠道已经开放，可请能到原处的人核原来用过的木柜，内层所见也留明，便于后续认领。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:23:19.240Z",
      "textSha256": "ba92682fb2041b116cb50e2efa8c7f42bc5607a8f4b5db60d66bbd4495da535c"
    }
  ]
}
