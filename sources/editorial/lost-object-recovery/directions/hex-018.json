  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "乾",
      "text": "传统取象落在西北，乾列圆器之中、金石旁。若在修整旧收纳时遗失，可回核实际用过的圆盒与其旁边，先找清那次经手动作。",
      "sourceRule": "乾",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:31.994Z",
      "textSha256": "5fa56f547fec31b48c5ad0f84efa3675ec54afc70c864fb88e520a7b15662313"
    },
    {
      "movingLine": 2,
      "changedTrigram": "艮",
      "text": "东北与近路边、岩石旁是变艮的线索。若原有查法接不上物品，可核真实经过中是否还有未问清的路旁停留点，再调整查询。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:31.994Z",
      "textSha256": "98af372c2d849de68dab96f04e57e4500bc272608c6aef2d9c504c227bbf2e99"
    },
    {
      "movingLine": 3,
      "changedTrigram": "坎",
      "text": "方位参北，坎有水边、酒醋之旁等场所。若确实去过相应店铺，可请原处补查收拾经过，发现早先描述有误时及时改明。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:31.994Z",
      "textSha256": "292017e8192f0ff6959f4b04181ea04a9394eec15d21ff01aa9270be20dc5c9a"
    },
    {
      "movingLine": 4,
      "changedTrigram": "离",
      "text": "南方是变离的传统方向，场所取明窗、文书旁。若旧查询一直拖着，可将原物特征与最后一次整理文件的经过交给能实际查看的人。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:31.994Z",
      "textSha256": "8ea1bd4a228a1dd6dcd120340a1b9f88495bc7b528a162fae8de87ffd718b80b"
    },
    {
      "movingLine": 5,
      "changedTrigram": "巽",
      "text": "东南及木器之内可供这一步回查。若原经手者能把收放次序说明，可请其核实确实用过的木柜或箱格，把旧疑点落到实看。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:31.995Z",
      "textSha256": "cb00e967a35cabf6a3e9449f387afb693ea3d24a91d796c10001820479db60a8"
    },
    {
      "movingLine": 6,
      "changedTrigram": "坤",
      "text": "方位取象为西南，仓储和方器属于坤的场所。若要收束查找，可先把有实据、尚能查看的方盒或储物处查清，再保存结果。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:16:31.995Z",
      "textSha256": "25b13f3a93577759ea77a0fbb0f6f9f359ecb4d46c399599a65783e21d37a7f4"
    }
  ]
}
