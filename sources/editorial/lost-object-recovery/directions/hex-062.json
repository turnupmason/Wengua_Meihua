  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "离",
      "text": "南方与明窗、文书之侧是变离的场所取象。起头宜先补看实际用过的文件台，问明收拾经过，再据真实新证安排下一处查询。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:44.655Z",
      "textSha256": "1460f1f585b626b61288072dc20ceceb890df97b7f4fc3997df25dcded05c78c"
    },
    {
      "movingLine": 2,
      "changedTrigram": "巽",
      "text": "方位参东南，巽列木器之内。若通过原经手方查验，可先核真实用过的木柜或木盒，查询做到能看清原物细节的一步。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:44.656Z",
      "textSha256": "09e5cb014af3eeec96a19673ace57c069cf97991516c27379a56c240a93e417d"
    },
    {
      "movingLine": 3,
      "changedTrigram": "坤",
      "text": "传统方向取西南，仓储、方器可供对照。若原处还有可查物件，可先核最后一批实际收起的东西，原记号交清再请人开格查看。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:44.656Z",
      "textSha256": "b80ee62bef792bf16287d7c83a95b43e3bdc97e48346aafd014d331711eb62e9"
    },
    {
      "movingLine": 4,
      "changedTrigram": "坤",
      "text": "西南是变坤的方位，场所见仓储与方器之中。原查法不便长期沿用时，可先向能查看的人核真实收存处，再按结果调整。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:44.656Z",
      "textSha256": "0ed6b71d41bf29f980fe6e6bd41ee2ccfa6f7e94705194151c4786c3f9d67716"
    },
    {
      "movingLine": 5,
      "changedTrigram": "兑",
      "text": "方位可参西，兑列泽畔、败垣。若查到较隐约的消息，可对照真实停留点请管理方核招领，所问聚焦能辨认原件的细节。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:44.656Z",
      "textSha256": "6fd9ea300d1338b349dee85fa4d3427ca29b710d5863a9aab3ee7d1d7b8a9348"
    },
    {
      "movingLine": 6,
      "changedTrigram": "离",
      "text": "传统方向偏南，明窗、文书旁属于离象。若末后仍有能协助查验的人，可请其回核实际用过的文件台，把有证范围内的遗漏补看。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:25:44.656Z",
      "textSha256": "38f9a878ad2c63df86d63fe8ce23c0718182965e93f20d2be168723bbea8251d"
    }
  ]
