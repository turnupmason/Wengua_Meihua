    {
      "movingLine": 1,
      "changedTrigram": "坤",
      "text": "西南是变坤的传统方向，方器、仓储可供参照。若要把初来的帮助用实，可请原处核确实使用过的储物格，把最后收放接清。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
