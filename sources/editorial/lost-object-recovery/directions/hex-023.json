{
  "primaryId": 23,
  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "震",
      "text": "东方及闹市、大途是变震的传统取象。若早先凭据已有缺处，可先用真实行程找回尚能核问的停留点，再联系对应场所招领。",
      "sourceRule": "震",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:18:00.412Z",
      "textSha256": "77a4b89af54744267dcfa90da7677d76a3eff9ae5d75a4ea6aeb8ff9b9dbfc58"
    },
    {
      "movingLine": 2,
      "changedTrigram": "坎",
      "text": "取象落在北方，坎的场所见水边、酒醋之旁。若原经手联系还在，可请其补核实际去过的相应场所，把原物细节与转述分清。",
      "sourceRule": "坎",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:18:00.413Z",
      "textSha256": "b06f979dc670784034629047d2e27479e17658d0b18e3a30b939ae93a194844a"
    },
    {
      "movingLine": 3,
      "changedTrigram": "艮",
      "text": "东北与近路边、岩石旁可作补查对照。若某条旧线反复无据，可回看真实路旁停留中哪处仍可查证，再安排实地或托人核看。",
      "sourceRule": "艮",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:18:00.413Z",
      "textSha256": "2f9674f856191a71c868502478cbcaa0a3f3d810a01a97afff63147311ffb610"
    },
    {
      "movingLine": 4,
      "changedTrigram": "离",
      "text": "传统方位偏南，场所列明窗、文书旁。旧查验条件若已改变，可问是否还有人能核当时的文件台或收拾记录，先接实能够补看的渠道。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:18:00.413Z",
      "textSha256": "923d046e8c09cb2e19adf34b186b9b5010a50b884d0dfe056fe7401b693598df"
    },
    {
      "movingLine": 5,
      "changedTrigram": "巽",
      "text": "方位取东南，巽有木器之内的线索。若同批物件按次序收放过，可请原处核实际使用的木柜或箱格，查询顺序照记录排清。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:18:00.413Z",
      "textSha256": "76f9dbc02dac8371caaa624ec7bdf0c15ad9c926bf48e98656a7218f948bbde8"
    },
    {
      "movingLine": 6,
      "changedTrigram": "坤",
      "text": "西南是变坤的传统方向，仓储、方器是场所提示。若手里还留着原收存凭据，可先请原处核对应储物格，查清有证的一段。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:18:00.413Z",
      "textSha256": "186856af5335071f21acbe3b0aa7ff7eb813941c23a9b6afb5dcbe7414ac3d08"
    }
  ]
}
