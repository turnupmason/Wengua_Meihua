{
  "primaryId": 5,
  "questionId": "search.lost-object.recovery",
  "baselineCommit": "5245c61a",
  "sourceRulesPath": "sources/editorial/lost-object-recovery/directions/source-rules.json",
  "entries": [
    {
      "movingLine": 1,
      "changedTrigram": "巽",
      "text": "取象可从东南、木器之内参看。若曾把物品随手收入木柜，可先查原层位与叠放物之间，等经手方核查时把具体特征给清。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:27.313Z",
      "textSha256": "196fec5e394652d3369e3247b7d22598ff1252b3c4f8d75696c08d360e60c85c"
    },
    {
      "movingLine": 2,
      "changedTrigram": "离",
      "text": "南方是传统方位，离又列明窗、文书之侧。若原使用处有窗边文件台，可请对口的人按当时收放补看，答复有出入时拿记录对证。",
      "sourceRule": "离",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:27.314Z",
      "textSha256": "0885221d9c680ef3ce87241cd074e15fde53f8a77b6475c2d856fdbf293c3917"
    },
    {
      "movingLine": 3,
      "changedTrigram": "兑",
      "text": "传统取象偏西，兑所列泽畔、破壁须与实际行程相合。先核是否真的经过和停留，再请场所方查看安全区域，查证宜从容。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:27.314Z",
      "textSha256": "6f2b5bf9850faa2feb15402919bb7fc41e34d492d4164793f37755d8d32a35b6"
    },
    {
      "movingLine": 4,
      "changedTrigram": "兑",
      "text": "方位落在西方，场所可参水泽边或旧墙附近。若原查询渠道不便查看，可转请有管理权限的人核实际停留处，保留原先的消息出处。",
      "sourceRule": "兑",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:27.314Z",
      "textSha256": "ffdf2e27276c7e840eaac81a8083f0b61e54160fef0890ded14f9d7a0997d394"
    },
    {
      "movingLine": 5,
      "changedTrigram": "坤",
      "text": "变坤取西南，仓储、方形容器可作补查线索。实际若曾随同其他物件一起收起，可向经手方问清那批物件存在哪里，再核原件。",
      "sourceRule": "坤",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:27.314Z",
      "textSha256": "53464090c4b7c79e31c3b49de57fe5581ff2fb3fe31051e513d40450706088a4"
    },
    {
      "movingLine": 6,
      "changedTrigram": "巽",
      "text": "东南与木器之内是古籍给出的场所提示。若后来有人补出收进木箱或柜格的记忆，可先核那次真实动作，再让能查看的人辨清实物。",
      "sourceRule": "巽",
      "status": "AUTHOR_READ",
      "actor": "assistant-author",
      "reviewedAt": "2026-11-18T16:14:27.314Z",
      "textSha256": "6ef5153b6813ee3be80ff47f53a28fbc4f11c2938ddd2847557ce01d30c6b797"
    }
  ]
}
