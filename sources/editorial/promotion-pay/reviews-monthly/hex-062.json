  "lineReviews": [
    {
      "movingLine": 1,
      "label": "初六",
      "articles": 12,
      "bodyHanRange": [
        500,
        552
      ],
      "finding": "初六飞鸟之凶取上逆而欠凭依。震木原体，本艮受克，中见巽和与兑克；兑得土生又受离制时并计两层作用，依其月态辨轻重。末离受体生，无直接生体，不能升。"
    },
    {
      "movingLine": 2,
      "label": "六二",
      "articles": 12,
      "bodyHanRange": [
        503,
        545
      ],
      "finding": "六二不越君臣之分，「无咎」落在守分。艮本用受震所克，用互和变用为巽，比和两见；体互兑得艮土生，过程直接克震，无生体，十二月未升。"
    },
    {
      "movingLine": 3,
      "label": "九三",
      "articles": 12,
      "bodyHanRange": [
        492,
        539
      ],
      "finding": "九三防之有其必要，不以防字推定现实中有人加害。震木制本艮和变坤，互巽比和；互兑得土生而克体，盘中无生体。过程的制约须算，首尾可经理不等于名位已得。"
    },
    {
      "movingLine": 4,
      "label": "九四",
      "articles": 12,
      "bodyHanRange": [
        472,
        559
      ],
      "finding": "九四取相遇而不过，往则宜戒，勿用永贞不作年限。艮体受本震、体互巽来克，兑金制木可缓其克；末坤比和而无直接生体。爻有无咎仍保留其限度，原断未升。"
    },
    {
      "movingLine": 5,
      "label": "六五",
      "articles": 12,
      "bodyHanRange": [
        494,
        527
      ],
      "finding": "六五密云未雨与取彼在穴，区分云已密、雨未施及局部有所得。艮体受震、巽克且克者受兑制；两兑泄体，未见直接生扶。不能以取彼便断得职，也不从云雨定日期。"
    },
    {
      "movingLine": 6,
      "label": "上六",
      "articles": 12,
      "bodyHanRange": [
        481,
        542
      ],
      "finding": "上六飞鸟过高，戒失其所遇。艮受震、巽直接克，其力受兑制，末离生体的帮助仍在。过程有制、结局有扶可以同存，既定在任规则优先，未升。"
    }
  ],
