  "lineReviews": [
    {
      "movingLine": 1,
      "label": "初九",
      "articles": 12,
      "bodyHanRange": [
        505,
        543
      ],
      "finding": "初九曳轮濡尾而无咎，王孔着眼于始济仍知艰难。坎体制本离、体互离，用互坎比和。末艮得两火所生而来克体，无生体。能审慎处事并不抵消结尾的限制。"
    },
    {
      "movingLine": 2,
      "label": "六二",
      "articles": 12,
      "bodyHanRange": [
        471,
        561
      ],
      "finding": "六二失茀而勿逐，守中正而可复有所获。坎体制前中离火，用互比和；末乾金生坎却受两离火制，所得较迟较薄。无克而末生，原断能升；「七日得」不折算任职或发薪日期。"
    },
    {
      "movingLine": 3,
      "label": "九三",
      "articles": 12,
      "bodyHanRange": [
        493,
        543
      ],
      "finding": "九三既取能克难，亦保留小象之惫。坎体制两离，过程同气，末震木受坎所生，局中无直接生体或克体，结尾外泄。三年是经文之数，不作晋升等待年数。"
    },
    {
      "movingLine": 4,
      "label": "六四",
      "articles": 12,
      "bodyHanRange": [
        474,
        530
      ],
      "finding": "六四衣袽取舟虽济仍有戒备，不落为具体业务漏洞。离体首、中受坎水所克，两水皆得变兑金之生，用互离比和，末兑由体所制。没有直接生体，原断不能升。"
    },
    {
      "movingLine": 5,
      "label": "九五",
      "articles": 12,
      "bodyHanRange": [
        484,
        538
      ],
      "finding": "九五东西邻祭祀轻重，重合时与德实。本用和体互坎水皆克离，又受变坤土制，压力可以减轻。中离比和，末坤受体生，局中无生体。不由「实受其福」单独许升。"
    },
    {
      "movingLine": 6,
      "label": "上六",
      "articles": 12,
      "bodyHanRange": [
        503,
        546
      ],
      "finding": "上六既济之极有转危之义。离体受本用、体互两坎所克，用互离和，末巽木生体，须辨三者所处的阶段。结尾的助力按月态取轻重，不能回头勾销起步和中段的直接克。"
    }
  ],
