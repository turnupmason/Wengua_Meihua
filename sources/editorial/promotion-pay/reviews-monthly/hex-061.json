  "lineReviews": [
    {
      "movingLine": 1,
      "label": "初九",
      "articles": 12,
      "bodyHanRange": [
        512,
        589
      ],
      "finding": "初九以专一、审度可信释「虞吉」。巽木为体，起初兑金来克且得互艮相生，中间有震木比和，末坎生体。后援随月令轻重有别，仍不能把在任者起步所遇的直接克略去，十二月皆未升。"
    },
    {
      "movingLine": 2,
      "label": "九二",
      "articles": 12,
      "bodyHanRange": [
        480,
        538
      ],
      "finding": "九二的鸣鹤相和与好爵共享，讲中诚感物。原体巽木，兑金得艮土而克木，用互和变用同为震木。两处比和皆有其益，盘中始终没有直接生体，不把鹤鸣当作授任消息。"
    },
    {
      "movingLine": 3,
      "label": "六三",
      "articles": 12,
      "bodyHanRange": [
        490,
        545
      ],
      "finding": "六三与相应者彼此牵动，故进止哀乐不自主。本用兑、末用乾皆克巽木，且同得艮生。中间震木比和保留，十二月的升迁仍从首尾二克判断。"
    },
    {
      "movingLine": 4,
      "label": "六四",
      "articles": 12,
      "bodyHanRange": [
        507,
        557
      ],
      "finding": "六四去匹上承，不由「月几望」推任期、工资或人事变动。兑体制巽、震，互艮生兑受木制，末乾比和。体弱月办事较迟，强月担责较从容，未见克体，五气原断皆能升。"
    },
    {
      "movingLine": 5,
      "label": "九五",
      "articles": 12,
      "bodyHanRange": [
        503,
        557
      ],
      "finding": "九五居尊守信，「挛如」取相系不绝。两艮处于用互、变用，皆生兑金，又都受木制，月令旺也不可将薄助推作尽得全力。生扶贯至结局，盘中无克体，能升。"
    },
    {
      "movingLine": 6,
      "label": "上九",
      "articles": 12,
      "bodyHanRange": [
        507,
        552
      ],
      "finding": "上九辨虚声与实德。兑金制前中的木，过程中有受制的艮土相生，末坎水却从体得生。无直接克体仍可因结局泄体而未升，不把翰音解释为当事人已经失信。"
    }
  ],
