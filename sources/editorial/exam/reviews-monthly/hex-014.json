  "lineReviews": [
    {
      "movingLine": 1,
      "text": "无交害，匪咎；艰则无咎。",
      "image": "大有初九，无交害也。",
      "reading": "王、孔释无交害，仍须知艰。朱熹以事初未涉害释之。取义在熟题知慎、难题肯下工夫，判合格须另审体用。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 2,
      "text": "大车以载，有攸往，无咎。",
      "image": "“大车以载”，积中不败也。",
      "reading": "王弼释大车可任重、致远，孔颖达以车材强壮说明能载。「积中不败」落在足以承当已积的内容，五气皆依同一义，已写的能稳、整卷是否足够则分月另审。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 3,
      "text": "公用亨于天子，小人弗克。",
      "image": "“公用亨于天子”，小人害也。",
      "reading": "王孔释亨为通、释弗克为不能胜任，朱熹以享献释亨。借此说明所任与己力是否相称。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 4,
      "text": "匪其彭，无咎。",
      "image": "“匪其彭，无咎”，明辨晢也。",
      "reading": "王孔训彭为旁，解九四辨所当承。程传训为盛，取盛而能守。《本义》于字义存疑而取程说于义或通。取明辨其所宜、盛而不极之意。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-014-line-4"
      ]
    },
    {
      "movingLine": 5,
      "text": "厥孚交如，威如，吉。",
      "image": "“厥孚交如”，信以发志也；“威如之吉”，易而无备也。",
      "reading": "六五柔中诚信，无私而得上下相应，威出于其德。借以理解同类相应的好处，通盘依本用克体且无生的现行规则定难。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-014-line-5"
      ]
    },
    {
      "movingLine": 6,
      "text": "自天佑之，吉无不利。",
      "image": "《大有》上吉，自天佑也。",
      "reading": "王孔以履信、思顺、尚贤释其得助，《系辞》以顺信释人天之助。吉辞所取有据，按本用克且全局无生体，合断难成。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-014-line-6"
      ]
    }
  ],
