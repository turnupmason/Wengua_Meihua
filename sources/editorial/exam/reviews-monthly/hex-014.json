  "lineReviews": [
    {
      "movingLine": 1,
      "text": "无交害，匪咎；艰则无咎。",
      "image": "大有初九，无交害也。",
      "reading": "王、孔释无交害，仍须知艰。朱熹以事初未涉害释之。取义在熟题知慎、难题肯下工夫，判合格须另审体用。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 2,
      "text": "大车以载，有攸往，无咎。",
      "image": "“大车以载”，积中不败也。",
      "reading": "王弼释大车可任重、致远，孔颖达以车材强壮说明能载。「积中不败」落在足以承当已积的内容，五气皆依同一义，已写的能稳、整卷是否足够则分月另审。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 3,
      "text": "公用亨于天子，小人弗克。",
      "image": "“公用亨于天子”，小人害也。",
      "reading": "王孔释亨为通、释弗克为不能胜任，朱熹以享献释亨。借此说明所任与己力是否相称。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 4,
      "text": "匪其彭，无咎。",
      "image": "“匪其彭，无咎”，明辨晢也。",
      "reading": "九四「匪其彭，无咎」，按王孔读彭为旁，九四斟酌所宜而承五。以明辨解释选法，大畜蓄德之象借说夏月所学至后程见功。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 5,
      "text": "厥孚交如，威如，吉。",
      "image": "“厥孚交如”，信以发志也；“威如之吉”，易而无备也。",
      "reading": "六五居中以诚交而上下应，威如之吉在简易无所猜防。爻义用以说明有据的实答可取。不得以威如指首问有威力，亦不得以无备指不用温书。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 6,
      "text": "自天佑之，吉无不利。",
      "image": "《大有》上吉，自天佑也。",
      "reading": "《周易正义》经文作祐，底稿通作佑。《系辞上》说履信思顺、尚贤，王注孔疏以三德解爻吉。考试以做成且可查的部分参爻义，不能据全吉辞翻转无生有克的原断。",
      "status": "author-readback-complete",
      "openFindingIds": []
    }
  ],
