  "lineReviews": [
    {
      "movingLine": 1,
      "text": "无交害，匪咎；艰则无咎。",
      "image": "大有初九，无交害也。",
      "reading": "王、孔释无交害，仍须知艰。朱熹以事初未涉害释之。取义在熟题知慎、难题肯下工夫，判合格须另审体用。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 2,
      "text": "大车以载，有攸往，无咎。",
      "image": "“大车以载”，积中不败也。",
      "reading": "王弼释大车可任重、致远，孔颖达以车材强壮说明能载。「积中不败」落在足以承当已积的内容，五气皆依同一义，已写的能稳、整卷是否足够则分月另审。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 3,
      "text": "公用亨于天子，小人弗克。",
      "image": "“公用亨于天子”，小人害也。",
      "reading": "王孔释亨为通、释弗克为不能胜任，朱熹释亨为朝献。此爻用于说明能否承担所任，不作考生品德之评。睽象同而异只借给土月分辨材料前提。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 4,
      "text": "匪其彭，无咎。",
      "image": "“匪其彭，无咎”，明辨晢也。",
      "reading": "九四「匪其彭，无咎」，按王孔读彭为旁，九四斟酌所宜而承五。以明辨解释选法，大畜蓄德之象借说夏月所学至后程见功。",
      "status": "author-readback-complete",
      "openFindingIds": []
    }
  ],
