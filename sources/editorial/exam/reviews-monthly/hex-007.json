  "lineReviews": [
    {
      "movingLine": 1,
      "text": "师出以律，否臧凶。",
      "image": "师出以律，失律凶也。",
      "reading": "《正义》训律为法、否为败、臧为有功，重在即使见功，失律亦凶；孔疏另区别因事制宜和故违已有规范。考试取卷面明确的作答方法、步骤、书写范围与材料后文的规定，结合互变分五气核读。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "shi-first-mutual-cross-stage"
      ]
    },
    {
      "movingLine": 2,
      "text": "在师中，吉，无咎，王三锡命。",
      "image": "在师中吉，承天宠也。王三锡命，怀万邦也。",
      "reading": "王注以刚中应上解在师中，因所任重而以有功释吉无咎；孔疏说明吉字兼顾上下，三锡从有功而来。考试借统摄数问、安排时力及按项作答之义，仍以中段震克、末坤比和而无生体取原断。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "shi-second-weak-wood-and-end-equal"
      ]
    },
    {
      "movingLine": 3,
      "text": "师或舆尸，凶。",
      "image": "师或舆尸，大无功也。",
      "reading": "王注、孔疏以进无应退无所守解六三，《象》曰大无功。《牛哀鸣占》同为师六三变升，《卦断遗论》重申用不克而互变俱克之例。应试借无功说明实际步骤不成，逐气辨中末两克的强弱及所取时间。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "shi-third-changing-control-strength"
      ]
    },
    {
      "movingLine": 4,
      "text": "师左次，无咎。",
      "image": "左次无咎，未失常也。",
      "reading": "王注以得位无应解释可处，象注言虽不能有获而不失常；孔疏依此释无咎。应试分别写适时停手与必须作答的界线，结果仍据两坤克坎与两震泄坎、全局无生体。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "shi-fourth-weak-pressure-no-compensation",
        "shi-fourth-checking-earth-controls"
      ]
    },
    {
      "movingLine": 5,
      "text": "田有禽，利执言，无咎。长子帅师，弟子舆尸，贞凶。",
      "image": "长子帅师，以中行也。弟子舆尸，使不当也。",
      "reading": "孔疏分释有理而应为无咎，以及九二中行、六三失任两支。考试取所择的解法与材料须足以办本问，冬月先按明文有所得，整体仍随中段耗损；末坎比和可守而无直接生扶。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "shi-fifth-equal-end"
      ]
    },
    {
      "movingLine": 6,
      "text": "大君有命，开国承家，小人勿用。",
      "image": "大君有命，以正功也。小人勿用，必乱邦也。",
      "reading": "王注以不失功释命，孔疏依据功之大小释开国承家，并另释慎所任。考试按卷面实交之证说明得分，尾问仍由变艮克坎定制约。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "shi-top-weight-of-closing-control"
      ]
    }
  ],
