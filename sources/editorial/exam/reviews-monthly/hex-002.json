  "lineReviews": [
    {
      "movingLine": 1,
      "text": "履霜，坚冰至。",
      "image": "履霜坚冰，阴始凝也。驯致其道，至坚冰也。",
      "reading": "原体上坤，三处坤土与体比和。地雷复下震木为末变用，仍克体。初六以始微积著提醒及早核实会牵动后续的条件。春土死遇旺木，冬土囚遇相木。夏土相、秋土休，克力较轻。四土月坤旺震囚，中途确有可承接之处。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "kun-initial-earth-verdict"
      ]
    },
    {
      "movingLine": 2,
      "text": "直方大，不习无不利。",
      "image": "六二之动，直以方也。不习无不利，地道光也。",
      "reading": "动下坤中爻得坎，变地水师，仍以上坤为体，土制水。春土死、秋土休、冬土囚，通盘无生，体难制事；夏土相、四土月土旺，变用坎弱，体克用可成。直方取循正合宜，不习取合道而自然，不能解释成考前不用准备。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "kun-second-good-line"
      ]
    },
    {
      "movingLine": 3,
      "text": "含章可贞，或从王事，无成有终。",
      "image": "含章可贞，以时发也。或从王事，知光大也。",
      "reading": "上坤仍为体，下坤三爻动变艮。坤艮都是土，本互变前后比和。月令决定同类是否有力。含章取已有所学而应题发用，无成有终取从事而不居功、把所承之事做完，与合格有所对应。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 4,
      "text": "括囊，无咎无誉。",
      "image": "括囊无咎，慎不害也。",
      "reading": "上坤动而成震，原体下坤，与初六的体用位置有别。前中同土，末变震克体。六四宜谨以免失，无誉限制免咎的作用。所取的分寸是不给无据判断，也要把所问的理由照实答足。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "kun-fourth-earth-role"
      ]
    },
    {
      "movingLine": 5,
      "text": "黄裳，元吉。",
      "image": "黄裳元吉，文在中也。",
      "reading": "六五动上坤为坎，原体下坤土制水。六五保留元吉，依王注与孔疏取中色下饰、内有文德而通物理，《文言》由内发于事业。春秋冬体力不济，吉辞不足以取代末段制用所需的力量。夏及土令仍依五气原判能过。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "kun-fifth-good-line"
      ]
    },
    {
      "movingLine": 6,
      "text": "龙战于野，其血玄黄。",
      "image": "龙战于野，其道穷也。",
      "reading": "上坤变艮，山地剥与原体下坤仍比和。上六依王注阴盛不已、小象其道穷，取强进到实际限处。《卦断遗论》西林寺额为本互变俱比和、剥象仍可定不利的书中实例。弱土时旺衰同向，夏相和土旺时仍有前中实利。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "kun-top-image-precedent"
      ]
    }
  ],
