  "lineReviews": [
    {
      "movingLine": 1,
      "text": "官有渝，贞吉。出门交，有功。",
      "image": "“官有渝”，从正吉也；“出门交，有功”，不失也。",
      "reading": "孔疏释官为人心所主，王注释初无偏系，随宜而动，以从正为吉。兑金制震、巽，互艮与变坤均生兑，无克兑之卦。五气分别权衡能任事的本领与所获扶持。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 2,
      "text": "係小子，失丈夫。",
      "image": "“係小子”，弗兼与也。",
      "reading": "六二近初而失应五，弗兼与为专系的代价。上兑任震巽，艮生兑，动成两兑。全年能过，夏重互艮、其余取末兑。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 3,
      "text": "係丈夫，失小子。随有求得，利居贞。",
      "image": "“係丈夫”，志舍下也。",
      "reading": "六三舍初从四，彼此求得仍利居贞。上兑任震巽，互艮生金、末离制金，离得两木生而无水制。春夏末离取火日，其他月因原断取互艮参过程之助。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 4,
      "text": "随有获，贞凶；有孚在道，以明，何咎！",
      "image": "“随有获”，其义凶也。“有孚在道”，明功也。",
      "reading": "九四得众而不擅，公诚在道以明其功。卦从起初兑克震变结果坎生震，互巽同气、互艮受木克。秋和季土参本兑初制，春夏冬参末坎生助。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 5,
      "text": "孚于嘉，吉。",
      "image": "“孚于嘉，吉”，位正中也。",
      "reading": "王弼以居正得中、随时之宜释信善。九五的吉肯定所信及分寸，体震与巽互、末震同气可守，然而本兑克震又得艮生，无水生体。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 6,
      "text": "拘係之，乃从，维之；王用亨于西山。",
      "image": "“拘係之”，上穷也。",
      "reading": "据王弼、孔颖达，拘系而后从，小象「上穷也」先论爻位；王用亨于西山，王注释亨为通。互巽可守，本兑、末乾同克震，须分五气轻重。",
      "status": "author-readback-complete",
      "openFindingIds": []
    }
  ],
