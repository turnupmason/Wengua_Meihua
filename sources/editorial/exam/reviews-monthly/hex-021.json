  "lineReviews": [
    {
      "movingLine": 1,
      "text": "屦校灭趾，无咎。",
      "image": "“屦校灭趾”，不行也。",
      "reading": "初九受刑之初，王孔以小惩大诫释免咎，小象不行指过止。震木本用生离本有求名之利。两土制坎能减轻中段的克，土亦受离所生。末后震变坤，依本库结局泄体的条件盘取不成。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-021-line-1"
      ]
    },
    {
      "movingLine": 2,
      "text": "噬肤，灭鼻，无咎。",
      "image": "“噬肤，灭鼻”，乘刚也。",
      "reading": "王孔以柔脆释所治中当，以乘刚释用刑过深，以得其理释无咎。朱熹保留所治易而仍有伤。震木初生离，艮土耗火，坎水制火，末兑仍为离所制。初有生，中有克，依第十三节末体克用取可成，兼录当月迟难。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-021-line-2"
      ]
    },
    {
      "movingLine": 3,
      "text": "噬腊肉，遇毒；小吝，无咎。",
      "image": "“遇毒”，位不当也。",
      "reading": "六三位不当，王孔以难服生怨释遇毒，以未侵顺道释无咎，朱熹兼取噬嗑去隔之义。中坎克离，受艮制，艮亦泄离。初震生扶，末离同体，以末比和为成，逐月衡量同气之力。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-021-line-3"
      ]
    },
    {
      "movingLine": 4,
      "text": "噬干胏，得金矢；利艰贞，吉。",
      "image": "“利艰贞，吉”，未光也。",
      "reading": "王孔以干肉之坚释所治难，以金刚矢直释艰中能守。朱熹兼举听讼钧金束矢。初离受震生，中坎能生震且受艮制，两艮皆受震所制。全局无克体，仍按本用泄、末用不生取不成。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-021-line-4"
      ]
    },
    {
      "movingLine": 5,
      "text": "噬干肉，得黄金；贞厉，无咎。",
      "image": "“贞厉，无咎”，得当也。",
      "reading": "王孔以黄为中、金为刚，联系得中而所治得当。朱熹兼取钧金，重贞厉而后免咎，与王孔对所治是否服从的说法有异。初离泄震，途中坎生、艮受制，末乾克震。坎受艮制又受乾生，在一层作用下按当月旺衰。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-021-line-5"
      ]
    },
    {
      "movingLine": 6,
      "text": "何校灭耳，凶。",
      "image": "“何校灭耳”，聪不明也。",
      "reading": "上九「何」通荷，所写负械至极。王孔以积过未改释凶，小象聪不明，《本义》重审听早图。初离受体震所生，中坎受艮制仍为生体，末震与体比和，定断仍依初用泄而末用不生。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-021-line-6"
      ]
    }
  ],
