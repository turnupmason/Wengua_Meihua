  "lineReviews": [
    {
      "movingLine": 1,
      "text": "不远复，无祗悔，元吉。",
      "image": "“不远之复”，以修身也。",
      "reading": "复初能早返而修身，韩氏祗训大，朱熹训抵，均是未远而自正。落在此占取能回到可为的一层，最终依初克无生判断。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 2,
      "text": "休复，吉。",
      "image": "“休复之吉”，以下仁也。",
      "reading": "六二居中亲初，王孔以能下仁释休复，朱熹取柔顺中正。可参已有本领仍可用，不以吉辞盖过末泄。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-024-line-2"
      ]
    },
    {
      "movingLine": 3,
      "text": "频复，厉无咎。",
      "image": "“频复之厉”，义无咎也。",
      "reading": "初震木克上坤；两互坤保持所能；末离火生坤。春令开始最重但末火相，夏令末火旺，土月体旺且末火休，秋初克轻而末火少力。亥子按考试二分以末生方向取成，未将冬火作旺援。王孔以频蹙、困而求复解六三，程朱以屡失屡复说明厉。爻意落在回正仍可为；考试能过另由末生取，变明夷「利艰贞」说明阻中守正。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-024-line-3"
      ]
    },
    {
      "movingLine": 4,
      "text": "中行独复。",
      "image": "“中行独复”，以从道也。",
      "reading": "六四动上坤，原体下震不动，开头及两互均坤土，三处都由原体震木所克；变上震和体比和。开头与中间要自身承担，末后同木维持已有发挥。寅卯两震旺，三土死；亥子两震相，三土囚，均取成。巳午两震休、三土相，申酉两震死、三土休，土月两震囚、三土旺，项目皆按体不旺相且比和无气、无生无克而取不成。王孔释中行独复为在群阴中独应初九、顺道而反；程朱称其志可取，初阳甚微不足以有为，爻无断辞。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-024-line-4"
      ]
    },
    {
      "movingLine": 5,
      "text": "敦复，无悔。",
      "image": "“敦复，无悔”，中以自考也。",
      "reading": "六五动上坤为坎，原体下震不动，本用、两互皆坤土，三处由木克。无一处直接克木。末坎水生震木，受三坤制，五气均有一层受制而薄，坎月势不被改写。寅卯、亥子取体旺相可承担，末助即使减薄仍有用。巳午体休、申酉体死、土月体囚，前中须本人应对，末助按现行无克有生定成，轻重只按原气与受制取。王孔居厚履中自考成其行，程朱自成守中，限于返善与持守，不独断考试。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-024-line-5"
      ]
    }
  ],
