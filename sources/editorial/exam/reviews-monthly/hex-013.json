  "lineReviews": [
    {
      "movingLine": 1,
      "text": "同人于门，无咎。",
      "image": "出门同人，又谁咎也？",
      "reading": "王弼以出门皆同释初九，孔颖达指出初在同人之始，上无系应。朱熹注初九未有私主，释大象以审异致同。用于考试，卷首明示的同一条要求贯穿数问，各问取据、限界、交接却须分别辨明。无咎说明能够守正免失，分数仍须从本月的体用消长与可取得的步骤分另断。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "exam-013-line-1-fire-supported-earth-contested"
      ]
    },
    {
      "movingLine": 2,
      "text": "同人于宗，吝。",
      "image": "“同人于宗”，吝道也。",
      "reading": "王弼与孔颖达以六二应于九五说明所同有其局限。考试只借这一层说明惯用做法有适用范围。卦辞所指亲疏不拿来评应考者的为人。十二月总分依首克、无生及季节强弱定，卷末能守住熟题分也要明言。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 3,
      "text": "伏戎于莽，升其高陵，三岁不兴。",
      "image": "“伏戎于莽”，敌刚也。“三岁不兴”，安行也。",
      "reading": "据王弼、孔颖达，登高量势，所敌刚健，久不能进。篇中分别写望题择问、试算两种读法、回头补字与迟迟未能落定前提，不把三岁作放榜或再考之期。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 4,
      "text": "乘其墉，弗克攻，吉。",
      "image": "“乘其墉”，义弗克也。其吉，则困而反则也。",
      "reading": "王弼、孔颖达释四已乘墉，因所争非义而能反。九四动在外卦，须改取下离为体。十二篇所借都是遇到方法不适用而回到题中规矩，吉由两巽生体及无克体参断。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 5,
      "text": "同人，先号咷，而后笑，大师克相遇。",
      "image": "同人之先，以中直也。大师相遇，言相克也。",
      "reading": "王、孔解二五相应而为三四所隔，须克服间阻而后相遇。月稿取先难后通的次序，作答需有能把前后接起来的具体根据，不把哭笑用作应考者实有之情。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 6,
      "text": "同人于郊，无悔。",
      "image": "“同人于郊”，志未得也。",
      "reading": "王弼、孔颖达兼言居郊远争与所同未获。借到考试，把足以合格与最深一问或高分心愿未尽分开。秋月做到末行，不能把爻辞无悔直接译成轻松通过。",
      "status": "author-readback-complete",
      "openFindingIds": []
    }
