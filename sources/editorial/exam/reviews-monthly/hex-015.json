  "lineReviews": [
    {
      "movingLine": 1,
      "text": "谦谦君子，用涉大川，吉。",
      "image": "“谦谦君子”，卑以自牧也。",
      "reading": "王弼读处谦之下、谦而又谦，孔疏言用涉大川为假象，牧为养，卑以自养其德。正文借其意于肯承认暂缺的根据、读全所问，不将涉川实写成考题。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 2,
      "text": "鸣谦，贞吉。",
      "image": "“鸣谦，贞吉”，中心得也。",
      "reading": "六二得位居中，所称许的是谦德真实而守正。爻辞的贞吉不直接许考试合格。谦变升，末用巽木克坤。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 3,
      "text": "劳谦君子，有终，吉。",
      "image": "“劳谦君子”，万民服也。",
      "reading": "九三上承下接，能劳而持谦，王弼与孔颖达的注疏均从爻位解释所任之重。变坤与体同气可稳住收束，中途震木克坤，坎水又生震，须按时令衡量土所能承受的分量。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 4,
      "text": "无不利，撝谦。",
      "image": "“无不利，撝谦”，不违则也。",
      "reading": "六四居九三之上仍肯下之，承六五而谦顺，王弼以奉上、下下解释撝谦。小象「不违则也」所许在处事得宜。初坤与艮同，互震与末震皆克艮，初时可用的相合至末已经改变。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 5,
      "text": "不富，以其邻利用侵伐，无不利。",
      "image": "“利用侵伐”，征不服也。",
      "reading": "六五不富而用其邻，王孔从居尊行谦、邻自归附解；侵伐有所指，小象曰征不服也。谦顺与决断是爻义，验本事仍看中震克艮、末坎受艮所制及两坎生木。",
      "status": "author-readback-complete",
      "openFindingIds": []
    }
  ],
