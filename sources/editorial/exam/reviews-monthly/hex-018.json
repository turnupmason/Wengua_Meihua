  "lineReviews": [
    {
      "movingLine": 1,
      "text": "干父之蛊，有子考，无咎；厉终吉。",
      "image": "“干父之蛊”，意承考也。",
      "reading": "初六干父之蛊，王弼以初任有危、堪任终吉释爻；小象意承，王孔释因时损益。亥子取体互震的过程约束，寅卯取本巽的起阻，其余取末乾泄。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 2,
      "text": "干母之蛊，不可贞。",
      "image": "“干母之蛊”，得中道也。",
      "reading": "九二虽刚，能干且顺，居中故曰不可贞。逐月比较初巽和中震之克、中兑之泄、末艮比和的实际分量。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 3,
      "text": "干父之蛊，小有悔，无大咎。",
      "image": "“干父之蛊”，终无咎也。",
      "reading": "九三阳刚履正而无正应，小有悔、无大咎所评在干事，不越为成绩之许。巽震两木兼受兑制、坎生，仍按原态；中段兑泄与末段艮克坎按月令解释。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 4,
      "text": "裕父之蛊，往见吝。",
      "image": "“裕父之蛊”，往未得也。",
      "reading": "六四柔而当位，裕先事而往无应。体转下巽，本艮为体所克，中震比和、中兑克体，末离受体所生。按五气衡量各处能否承接。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 5,
      "text": "干父之蛊，用誉。",
      "image": "“干父用誉”，承以德也。",
      "reading": "六五用中而应，所获之誉指承先之德。初巽制艮、中震末巽比和、中兑有根无制；有同类不替代水生木，誉不越为合格。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 6,
      "text": "不事王侯，高尚其事。",
      "image": "“不事王侯”，志可则也。",
      "reading": "上九处蛊终，爻言志可则。体巽制艮与坤，互震比和，互兑受两土生而无火制，无直接生体者。",
      "status": "author-readback-complete",
      "openFindingIds": []
    }
  ],
