  "lineReviews": [
    {
      "movingLine": 1,
      "text": "贲其趾，舍车而徒。",
      "image": "“舍车而徒”，义弗乘也。",
      "reading": "王孔以义弗乘释舍车而徒，程颐着眼正所行、舍易从难。初离生艮，中震克艮，中坎既为艮所制，又能生震，末艮与体同气。依有生有克、末应同气定成。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-022-line-1"
      ]
    },
    {
      "movingLine": 2,
      "text": "贲其须。",
      "image": "“贲其须”，与上兴也。",
      "reading": "六二之须依面，王孔取就近附九三，程颐由须随颐释贲饰有其本质。初离生艮，中震克体，中坎受体制，末乾耗体。坎水生震、乾金制震依第八节相抵，按震原五态。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-022-line-2"
      ]
    },
    {
      "movingLine": 3,
      "text": "贲如，濡如，永贞吉。",
      "image": "“永贞之吉”，终莫之陵也。",
      "reading": "王孔从得位与近二相润释贲濡，程颐取九三在两阴之间相贲而难常，朱熹戒溺于安。永贞为吉之所凭。初离生艮，中震与末震均克艮，坎能生两震又须由艮制。以末克定难。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-022-line-3"
      ]
    },
    {
      "movingLine": 4,
      "text": "贲如，皤如，白马翰如；匪寇，婚媾。",
      "image": "“六四当位，疑也；”“匪寇婚媾”，终无尤也。",
      "reading": "王孔释正应有碍而解疑后合，朱熹另释九三来求；本卦从初耗、互有制有助到末比。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-022-line-4"
      ]
    },
    {
      "movingLine": 5,
      "text": "贲于丘园，束帛戋戋；吝，终吉。",
      "image": "“六五之吉”，有喜也。",
      "reading": "经称吝而终吉。王孔由质素俭约说终吉，朱熹由柔中敦本说礼薄之吝。用于本占，初耗与末获两处分别审定。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-022-line-5"
      ]
    },
    {
      "movingLine": 6,
      "text": "白贲，无咎。",
      "image": "“白贲，无咎”，上得志也。",
      "reading": "经、注及疏所许在饰终反素、任真无咎，朱熹补以反本善补过。中途可得助，末用仍泄，考试以所求成否定。",
      "status": "author-readback-complete",
      "openFindingIds": []
    }
  ],
