  "lineReviews": [
    {
      "movingLine": 1,
      "text": "贲其趾，舍车而徒。",
      "image": "“舍车而徒”，义弗乘也。",
      "reading": "王孔以义弗乘释舍车而徒，程颐着眼正所行、舍易从难。初离生艮，中震克艮，中坎既为艮所制，又能生震，末艮与体同气。依有生有克、末应同气定成。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-022-line-1"
      ]
    },
    {
      "movingLine": 2,
      "text": "贲其须。",
      "image": "“贲其须”，与上兴也。",
      "reading": "六二之须依面，王孔取就近附九三，程颐由须随颐释贲饰有其本质。初离生艮，中震克体，中坎受体制，末乾耗体。坎水生震、乾金制震依第八节相抵，按震原五态。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-022-line-2"
      ]
    },
    {
      "movingLine": 3,
      "text": "贲如，濡如，永贞吉。",
      "image": "“永贞之吉”，终莫之陵也。",
      "reading": "王孔从得位与近二相润释贲濡，程颐取九三在两阴之间相贲而难常，朱熹戒溺于安。永贞为吉之所凭。初离生艮，中震与末震均克艮，坎能生两震又须由艮制。以末克定难。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-022-line-3"
      ]
    },
    {
      "movingLine": 4,
      "text": "贲如，皤如，白马翰如；匪寇，婚媾。",
      "image": "“六四当位，疑也；”“匪寇婚媾”，终无尤也。",
      "reading": "王孔释正应有碍而解疑后合，朱熹另释九三来求；本卦从初耗、互有制有助到末比。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-022-line-4"
      ]
    }
  ],
