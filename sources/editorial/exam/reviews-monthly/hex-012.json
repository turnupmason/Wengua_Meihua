  "lineReviews": [
    {
      "movingLine": 1,
      "text": "拔茅茹，以其汇，贞，吉亨。",
      "image": "拔茅贞吉，志在君也。",
      "reading": "王孔取三阴根同而相牵，否初居而守正，志在君而不苟进。与泰初九所言征行的处境有别，卷面借其同类关系与审题守正，避免熟题照搬具体数字或未经核实的条件。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "exam-012-line-1-two-woods-and-two-supports"
      ]
    },
    {
      "movingLine": 2,
      "text": "包承，小人吉，大人否，亨。",
      "image": "大人否亨，不乱群也。",
      "reading": "王孔说小人因顺承而得路，大人能否闭其吉而道亨。朱熹取大人安守其否，不因彼包承而失所守。卷面以顺给定所得见前分，末问须照当前所求，秋借变讼违行、冬借坎陷说明离题和久耗。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "exam-012-line-2-drain-and-weak-help"
      ]
    },
    {
      "movingLine": 3,
      "text": "包羞。",
      "image": "包羞，位不当也。",
      "reading": "王孔以六三失位、循小道承上而致羞释经，朱熹另取阴居阳而不中正、欲伤善未发，故经未著凶咎。卷面只借为没有证据的句子不应藏入已证过程。天山遁借取退义，巳午先回题干、图表核给定。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "exam-012-line-3-three-soils-under-control"
      ]
    },
    {
      "movingLine": 4,
      "text": "有命无咎。畴离祉。",
      "image": "有命无咎，志行也。",
      "reading": "王孔以九四命守正有应的初六得无咎，初六为畴，离通丽，初六受命而附祉。《象》之志行就初六守正应上说。朱熹以命为天命、畴为三阳之类，正文从王孔借题目明示的要求和卷上依要求所得之分。春借《巽》申命写同一种指定解法两见，冬借之卦《观》风行地上写编号与次序规定落实；秋以「大往小来」借写第一页时长与所得分之差。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "exam-012-line-4-metal-restrains-two-woods"
      ]
    },
    {
      "movingLine": 5,
      "text": "休否，大人吉。其亡其亡，系于苞桑。",
      "image": "大人之吉，位正当也。",
      "reading": "孔疏以休为美，言居尊能遏小人，王注说心存将危乃得固。程颐以否息而渐向泰、仍须戒其复释九五，苞谓丛生，根深尤固。《系辞下》引末句说安而不忘危。《晋》坤下离上，明出而渐进。正文借这些义项写尾题提示、熟题护分与核答有据。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "exam-012-line-5-late-support-and-different-initial-grades"
      ]
    },
    {
      "movingLine": 6,
      "text": "倾否，先否后喜。",
      "image": "否终则倾，何可长也？",
      "reading": "王注先倾后通，孔疏辨否未倾与否倾后的先后。各月按五气源断落实局部转顺的位置与所耗。四土取萃之聚写汇总，秋借《说卦》兑为毁折写划掉已有答案，均是考试场景借象。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "exam-012-line-6-restrained-wood-two-drains"
      ]
    }
