  "lineReviews": [
    {
      "movingLine": 1,
      "text": "童观，小人无咎，君子吝。",
      "image": "初六，“童观”，小人道也。",
      "reading": "童观以初六远而阴柔、不能自进释之，小人无咎与君子吝随所任有别，不用来推断个人品行。三处体克、末比和、无生无克，月气区别所任轻重与自身能否接续。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 2,
      "text": "闚观，利女贞。",
      "image": "“闚观，女贞”，亦可丑也。",
      "reading": "六二居内柔顺得正，虽与九五有应，所见犹窄。木制三土，得到三土所制的末水之生。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 3,
      "text": "观我生，进退。",
      "image": "“观我生，进退”，未失道也。",
      "reading": "观己所行、时可则进，未失道不等于本次通过。依本用与互变同土判用党，木制土不作泄，秋令审体衰无生。",
      "status": "author-readback-complete",
      "openFindingIds": []
    }
  ],
