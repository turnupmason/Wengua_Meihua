  "lineReviews": [
    {
      "movingLine": 1,
      "text": "咸临，贞吉。",
      "image": "“咸临，贞吉”，志行正也。",
      "reading": "初九与六四相应，咸临之贞吉限志行正。坤体生兑，互坤相合，互震克身，末体克坎，盘内无火生体。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 2,
      "text": "咸临，吉，无不利。",
      "image": "“咸临，吉，无不利”，未顺命也。",
      "reading": "九二与五相应，有从有否。两震中末俱克坤，有兑制而无水养木，月令本态与制后克力分记。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 3,
      "text": "甘临，无攸利；既忧之，无咎。",
      "image": "“甘临”，位不当也。“既忧之”，咎不长也。",
      "reading": "六三以甘临无利，既忧能改则咎不长，止其失而非直接断成。上坤生两金，两金又制中震，盘无水生震、无火生坤。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 4,
      "text": "至临，无咎。",
      "image": "“至临，无咎”，位当也。",
      "reading": "六四以柔居正、下应初九，能尽临之善，故无咎。兑金为体，两坤生兑却受震克，不能照旺土全额算扶助。两震为兑所制，按月气定难易。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 5,
      "text": "知临，大君之宜，吉。",
      "image": "“大君之宜”，行中之谓也。",
      "reading": "知临指处中纳刚、善任其能而事成。体兑得本用与用互坤土相生，全盘无克体；支持成事的爻义与规则均明列。当前原断优先取变坎泄体，求名本用条文参用于变用之权重留待审议。",
      "status": "author-readback-complete",
      "openFindingIds": []
    }
  ],
