  "lineReviews": [
    {
      "movingLine": 1,
      "text": "有孚比之，无咎。有孚盈缶，终来有它吉。",
      "image": "比之初六，有它吉也。",
      "reading": "王注以著信立诚说明盈于质素之器，孔疏重在始终如一及应者不止一人。考试借前后按要求如实写出过程，盘中本用坤、用互坤、体互艮克上坎，末震泄坎，原判依此。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "bi-first-multiple-earth-wood"
      ]
    },
    {
      "movingLine": 2,
      "text": "比之自内，贞吉。",
      "image": "比之自内，不自失也。",
      "reading": "六二居中得位而系应于五，王注以不能来它限其吉，孔疏用不失所应解释《象》。考试取熟法在适用范围内有所得，跨到新前提、指定方法与更深过程仍须证明。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "bi-second-three-controls-and-equal"
      ]
    },
    {
      "movingLine": 3,
      "text": "比之匪人。",
      "image": "比之匪人，不亦伤乎。",
      "reading": "王注说二比五、四外比，六三近不相得而远无应；孔疏以所欲亲比皆非己亲释伤。应试取解法、原例与设问不相合，局中四处土克坎，无生体，依次分月读回。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "bi-third-four-controls-strength"
      ]
    },
    {
      "movingLine": 4,
      "text": "外比之，贞吉。",
      "image": "外比于贤，以从上也。",
      "reading": "六四在外卦而比九五，王注与孔疏以处不失位、比不失贤为守正得吉。考试取可靠范例须言之有据、适用题给条件；前中比和与末兑泄耗按当月分别核读。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "bi-fourth-weak-support-after-stability"
      ]
    },
    {
      "movingLine": 5,
      "text": "显比。王用三驱，失前禽。邑人不诫，吉。",
      "image": "显比之吉，位正中也。舍逆取顺，失前禽也。邑人不诫，上使中也。",
      "reading": "九五吉在正中及所比的范围。考卷可以舍偏问而实写所取；原体与两互、变用的旺衰决定守得多少，仍依五气各断。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "exam-008-line-5-no-control-priority"
      ]
    },
    {
      "movingLine": 6,
      "text": "比之无首，凶。",
      "image": "比之无首，无所终也。",
      "reading": "王弼、孔颖达说处终而独后，前人已成比，故无与共终。考试借指最需收束的一问或结论留到最后，全盘亦有末用巽木克坤。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "exam-008-line-6-ending-control-priority"
      ]
    }
  ],
