  "lineReviews": [
    {
      "movingLine": 1,
      "text": "发蒙，利用刑人，用说桎梏，以往吝。",
      "image": "利用刑人，以正法也。",
      "reading": "初六十二月题名、简断、正文、取期均逐篇从最终源读回。原体上艮、本用下坎，体克用。互坤与艮比和，用互震木来克体，山泽损的变用下兑受艮所生。春冬核坎生震及兑制震并见，秋核震失气又受旺兑克。夏和土令保留眼前体能制用、末处依然泄体的原判。初六经义保留正法、疑明可解与治不可长，将其用于按实证订正及停止无效的修改。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "meng-first-wood-counteraction",
        "meng-first-terminal-drain"
      ]
    },
    {
      "movingLine": 2,
      "text": "包蒙吉，纳妇吉，子克家。",
      "image": "子克家，刚柔节也。",
      "reading": "已读回九二十二月题名、简断、正文及取期。以上艮为体，下坎为本用由艮所克。体互坤与山地剥的变坤分别同气相应，春秋冬薄，夏土月较有力。用互震始终克艮，原断计本用坎水来生而无乾兑制之，取期均为寅、卯参中段所克。包蒙及克家取容纳、解疑与承办，保留前后能够相接的实际好处。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "meng-second-weak-wood-support"
      ]
    },
    {
      "movingLine": 3,
      "text": "勿用取女。见金夫，不有躬，无攸利。",
      "image": "勿用取女，行不顺也。",
      "reading": "逐篇读回六三十二个月的题名、简断、正文及取期。原体上艮制坎，体互坤为同气。用互震与山风蛊下巽先后克原体，两木按原断获本用坎水生扶。秋取用互，春、夏、冬和土月取变用，均以寅、卯日参木克。注疏所指为见上九刚阳并失己所守，未按字面金夫另添克木的经卦，纳入临场更换方法的依据核查。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "meng-third-water-to-two-wood",
        "meng-third-autumn-timing"
      ]
    },
    {
      "movingLine": 4,
      "text": "困蒙，吝。",
      "image": "困蒙之吝，独远实也。",
      "reading": "六四全十二月的题名、简断、正文、取期均已逐篇读回。动位移到上艮，原体取下坎。核前段艮、中段坤均克水，体互震由原体生，未济之离为体水所克。春冬以体互中途耗用取寅卯，夏响应本用土克，秋及四土月取用互土克。古注的实是九二阳刚，应用层取远离实际可解疑的依据。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "meng-fourth-spring-earth-offset",
        "meng-fourth-strong-body-and-timing"
      ]
    },
    {
      "movingLine": 5,
      "text": "童蒙吉。",
      "image": "童蒙之吉，顺以巽也。",
      "reading": "六五十二月快读、正文和取期逐篇读回。原体下坎受本用艮、用互坤来克，体互震与风水涣的末巽均受坎生。春土弱又受木制，夏土令按原断计两木制土，土克较未受制时减，水仍然无助。春冬参末巽所耗，夏秋参用互坤克，土令参本用艮克。经象吉意保留为顺受、有能者可委，应用为将确有依据的题面引导用足。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "meng-fifth-weak-wood-counters-earth"
      ]
    },
    {
      "movingLine": 6,
      "text": "击蒙，不利为寇，利御寇。",
      "image": "利用御寇，上下顺也。",
      "reading": "上九十二月逐篇读回，核对原体下坎、本用上艮、用互坤与地水师末坤分别来克，体互震由坎水所生。春冬中途耗用较实，夏和土月的震木制土能缓土克程度不同，皆保留末坤取四土日。古注所分解除蒙昧、捍御与侵取，落实为有证据才改错、守住已成立处，并补齐实际所问。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "meng-last-earth-controls-water"
      ]
    }
