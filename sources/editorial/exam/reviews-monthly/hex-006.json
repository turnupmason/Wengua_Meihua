  "lineReviews": [
    {
      "movingLine": 1,
      "text": "不永所事，小有言，终吉。",
      "image": "不永所事，讼不可长也。虽小有言，其辩明也。",
      "reading": "初六十二月题名、简断、正文和取期已经逐篇读回。上乾为原体，生下坎为初耗，离火用互克体，体互巽由乾去克，天泽履的下兑与乾同气。冬初耗较重，取本用亥子。余月取巳午参用互火克，夏中克最实，秋土较可承。古义保留初讼当辨而不宜久，本题用在按证据说明、已经足够就收束，五气沿原断。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "song-first-capacity-and-closure"
      ]
    },
    {
      "movingLine": 2,
      "text": "不克讼，归而逋其邑。人三百户，无眚。",
      "image": "不克讼，归逋窜也。自下讼上，患至掇也。",
      "reading": "九二由下讼上，退归而免眚。应试取识别争持无益而及时换法之义，逐月回到用坎泄体、离火来克、乾克巽与末坤生扶各处；十二篇读回原断、备考举例、时点及专业说明。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "song-second-summer-turn"
      ]
    },
    {
      "movingLine": 3,
      "text": "食旧德，贞厉，终吉。或从王事无成。",
      "image": "食旧德，从上吉也。",
      "reading": "王注以保全已有解旧德，孔疏以处两刚间释厉，以从上九释吉，并将王事无成解为无敢先成。按考试原案分辨熟题所得、未证的步骤与总分，逐月核本用、两互及变用。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "song-third-weak-control-priority"
      ]
    },
    {
      "movingLine": 4,
      "text": "不克讼。复即命渝，安贞吉。",
      "image": "复即命渝，安贞不失也。",
      "reading": "王注、孔疏均以返从原本不争之理解复即，以变此前与初六相讼之命解渝。应试借其肯据题面纠正起步之义，逐篇读回改正所得、返工所耗、总分及各气的取期。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "song-fourth-no-control-and-drain",
        "song-fourth-cross-stage-fire"
      ]
    },
    {
      "movingLine": 5,
      "text": "讼元吉。",
      "image": "讼元吉，以中正也。",
      "reading": "九五处尊位而能中正分曲直。王注明言无所偏，孔疏另辨二与五的断讼之主及彖辞刚来得中所指。应试取同一尺度逐项判据，原断仍随无克体、初生和末用由体制等情形。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "song-fifth-summer-burden"
      ]
    },
    {
      "movingLine": 6,
      "text": "或锡之鞶带，终朝三褫之。",
      "image": "以讼受服，亦不足敬也。",
      "reading": "正义鞶为大带，褫是夺其所获。王注、孔疏均以讼胜取荣而不保解之。考试取作答根据应写实、收卷改答须有实证；能过取初乾生下坎与变兑生体、无克体合看。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "song-top-summer-weak-support"
      ]
    }
