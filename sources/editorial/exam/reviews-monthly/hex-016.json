  "lineReviews": [
    {
      "movingLine": 1,
      "text": "鸣豫，凶。",
      "image": "初六，“鸣豫”，志穷凶也。",
      "reading": "初六处豫之初独得应于九四。王注孔疏从乐过志穷讲凶，爻为戒，实际成败按全盘体用。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 2,
      "text": "介于石，不终日，贞吉。",
      "image": "“不终日，贞吉”，以中正也。",
      "reading": "六二居中得正，王注以顺不苟从释其守，孔疏以见几之速释不终日。爻赞明辨守正，与本场结果同向，不以经文定应期。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 3,
      "text": "盱豫悔；迟有悔。",
      "image": "“盱豫有悔”，位不当也。",
      "reading": "六三居下体之极、上承九四，位非所据。孔疏分释盱与迟，两悔是处位与进退的警义，不能据以指定失误。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 4,
      "text": "由豫，大有得；勿疑，朋盍簪。",
      "image": "“由豫，大有得”，志大行也。",
      "reading": "九四一阳为群阴所从，得在众力相合；下坤体受上震克，中间互艮同体、互坎生震，末变纯坤。动后相合不能倒推出本用之克已解。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 5,
      "text": "贞疾，恒不死。",
      "image": "六五“贞疾”，乘刚也；“恒不死”，中未亡也。",
      "reading": "六五以柔乘刚，故有疾，居中未亡，故能久守。应考看受制而能持原有本领的分量，本震克坤、变兑受坤所生，能守没有转为有所得。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 6,
      "text": "冥豫成，有渝无咎。",
      "image": "“冥豫”在上，何可长也？",
      "reading": "上六动而成晋，外震木由克坤转为离火生坤。王孔释冥豫到极不可长、有渝方无咎，转机归于关系改变，不推定具体应试情形。",
      "status": "author-readback-complete",
      "openFindingIds": []
    }
  ],
