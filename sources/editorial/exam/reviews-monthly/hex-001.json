    {
      "movingLine": 1,
      "text": "潜龙勿用。",
      "image": "潜龙勿用，阳在下也。",
      "reading": "凡见龙先辨时位。寅卯巳午亥子三组体与比和之卦同失令，潜而未用与盘势同向。秋金旺、土令金相，须写足比和与体克变用之利，保留项目以初九限制本次显效的读法。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "qian-initial-application"
      ]
    },
    {
      "movingLine": 2,
      "text": "见龙在田，利见大人。",
      "image": "见龙在田，德施普也。",
      "reading": "据王注出潜离隐、德施周普，承认有力发挥之处。与初九不同，失利所系在变离克乾、全盘无生体，不因见龙便断本场合格，也不将大人指定为考官。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "qian-second-timing"
      ]
    },
    {
      "movingLine": 3,
      "text": "君子终日乾乾，夕惕若，厉无咎。",
      "image": "终日乾乾，反复道也。",
      "reading": "处下卦之极而勤惕。春夏冬诸金失时，免过不等于已经合格。秋、土令比和得力、末变兑金仍比和，判能过。无咎须连同行事合宜读，亦不能独自确立通过。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 4,
      "text": "或跃在渊，无咎。",
      "image": "或跃在渊，进无咎也。",
      "reading": "九四已入上卦，下乾为不变之体。依小象许其合时而进，参《文言》自试、欲及时、或之者疑之，辨可以试与能成其事。九四的渊与跃不对应具体题序、困局或考生性格。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 5,
      "text": "飞龙在天，利见大人。",
      "image": "飞龙在天，大人造也。",
      "reading": "九五以阳居阳、居中得位，依王注德与位相称和《文言》同声相应，保留有为与充分显才之利；末变上离来克下乾，没有直接生体，按本问项保留不成。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "qian-fifth-strong-body"
      ]
    },
    {
      "movingLine": 6,
      "text": "亢龙有悔。",
      "image": "亢龙有悔，盈不可久也。",
      "reading": "据小象盈不可久、文言知进不知退和孔疏设诫之辞，将悔落实为过盈之戒。春夏冬金失时，不借无克越过旺衰；秋与土月乾兑有气，守住分寸而能成，不凭悔字翻败。",
      "status": "author-readback-complete",
      "openFindingIds": []
    }
