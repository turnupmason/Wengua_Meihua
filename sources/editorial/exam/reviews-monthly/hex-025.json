  "lineReviews": [
    {
      "movingLine": 1,
      "text": "无妄，往吉。",
      "image": "“无妄之往”，得志也。",
      "reading": "初九动下震为坤，原体上乾金。初震和互巽木为乾金所克，互艮和末坤生乾，整卦无克金。艮与坤均受原卦两木所制，按一层制化取实际扶助较薄，原有五态仍保持。寅卯两木旺、自己囚，先费力；巳午原体死，两木休，互艮取过程中微助；申酉体旺、两木死，辰未戌丑体相、两木囚，都有本身承担之力，按末坤参所求有成。亥子体休，两木相，仍须多费力，结尾少量助益。初九往吉以依实而行解，王孔取行不犯妄，程朱取内诚，未拿爻辞杜撰试题。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-025-line-1"
      ]
    },
    {
      "movingLine": 2,
      "text": "不耕获，不菑畬，则利有攸往。",
      "image": "“不耕获”，未富也。",
      "reading": "王孔取在已有开端上承接而完成，程朱重因时顺理、不图私利。与全卦无克、互艮生乾、末兑与乾相合一起说明何以可成。",
      "status": "author-readback-complete",
      "openFindingIds": []
    },
    {
      "movingLine": 3,
      "text": "无妄之灾，或系之牛，行人之得，邑人之灾。",
      "image": "行人得牛，邑人灾也。",
      "reading": "《本义》从无故受累解六三；王孔从六三位不正、行违谦顺读，程传重妄得与失相随。正文以朱熹的读法照见前有所获、末仍受制，只取爻义与实际卦变相合之处。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-025-line-3"
      ]
    },
    {
      "movingLine": 4,
      "text": "可贞，无咎。",
      "image": "“可贞，无咎”，固有之也。",
      "reading": "九四「可贞，无咎」，王孔取刚履柔而守贞，程传讲刚而无私、固守无妄，小象「固有之也」着眼已具备且能稳住的凭借。用于此盘，后两处同木可保住所长，成败另由初克与全卦无生判。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-025-line-4"
      ]
    },
    {
      "movingLine": 5,
      "text": "无妄之疾，勿药有喜。",
      "image": "“无妄之药”，不可试也。",
      "reading": "王孔释无妄之疾，原来守正却遇一时困扰，勿妄攻原来得其正的部分；《本义》重刚中正与相应。正文只取守住所长，能否通过按初克、末泄和全局无生实算。",
      "status": "author-readback-complete",
      "openFindingIds": [
        "hex-025-line-5"
      ]
    }
  ],
