  "findings": [
    {
      "status": "closed",
      "finding": "初六末克与证据、六三古注归属、六四本义断句与证据条件、九五王注孔疏区别、上九作用互与初中泄体等具体退修已闭合。51改动键逐篇完整复读；末次5卯克力虽薄而两处耗散不轻、6酉去掉重复尾比句整篇再次复读，均不改变结论。"
    }
  ],
  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初六救涣未甚可借力而顺道，原上巽得下坎生；上艮受克、下震比，变兑克。"
    },
    {
      "movingLine": 2,
      "finding": "九二奔机初二相赖，末坤受体克而非末克体，充分与难由原体气定。"
    },
    {
      "movingLine": 3,
      "finding": "六三散躬志外及程朱各义不知真人动机，末巽与原上巽比和且不可增旺。"
    },
    {
      "movingLine": 4,
      "finding": "六四散群险与丘虚忧虑、丘聚为不同古释；下坎原体遇前中双泄及中克，末乾生体。"
    },
    {
      "movingLine": 5,
      "finding": "九五大号为治涣，王弼释荡险厄，孔疏详汗喻险厄；初中双木泄、中末两艮均克，非生和。"
    },
    {
      "movingLine": 6,
      "finding": "上九王孔逖远及程朱惕出分释；原下坎先中双泄、中艮克，末坎比和，不等于生体。"
    }
  ],
