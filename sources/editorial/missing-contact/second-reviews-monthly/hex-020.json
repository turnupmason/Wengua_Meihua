  "findings": [
    {
      "status": "resolved",
      "finding": "同土令的共用文字已移除辰月专名；申支与巽木、酉月与酉日分别说清。"
    },
    {
      "status": "resolved",
      "finding": "参照点仅用于比较方位。可靠的本人陈述及其他近况均可核实；巽方未再充作独立证据。"
    },
    {
      "status": "resolved",
      "finding": "收回预设转述、安慰与同名者现身等已经发生的措辞；纠正“一次”的时间含义、亲见和转述的边界。"
    },
    {
      "status": "resolved",
      "finding": "土与土同气明确为比和，非因失令才不能相生；上九关于程颐的引证已补上同版直接出处。"
    }
  ],
  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "巽木体、坤土人物，三土受制，末震与巽和；春夏冬有条件、秋及四土月较难。逐月核旧见闻与现处、坤方依据，并纠正共用判断误写辰月；比和仅参收尾衔接。"
    },
    {
      "movingLine": 2,
      "finding": "六二居内应五，有限所见仍可能有真。风水涣的坎水生巽，冬旺与土令死水有别；保留薄助而不许定联系日。纠正次数与日期的混用，以及将亲见者设为唯一可核现处者。"
    },
    {
      "movingLine": 3,
      "finding": "初、中、末四土均为巽所克，春夏冬可寻有条件，木囚或秋死则难。进退依《正义》指自己怎样查证，卦中缺独立日应；复核申月巽木与酉月不能径定酉日的表述。"
    },
    {
      "movingLine": 4,
      "finding": "坤体、巽为人物，开局用克，互坤艮比和而末坤生乾耗。四近五所言“为宾”有古义，应用到见闻距离时没取为官署或真实帮手；寅卯日仅参开局核验受阻。"
    },
    {
      "movingLine": 5,
      "finding": "九五由观民回照己道。互变均剥，互坤、艮、末艮与体同气，中末可相互核，不误作生坤。土日具体观察收尾能否交叉核对，不是应允两份证据或本人到来。"
    },
    {
      "movingLine": 6,
      "finding": "由受众人所观到自省所行分别核对王注、程传，十二篇均补程传卷二。末比不得据名许合；变坎四时受坤制轻重不同，冬坎旺较难，土令强体可办，仍要人与现处的现实根据。"
    }
  ],
  "articleReviews": [
    {
      "key": "20/1/寅",
      "articleSha256": "86a67aad536d8319a07dac093e014719a881abe7f2a0757978c84a4700d4960f",
      "finding": "“童”落在所见的深浅，没有据它猜失联者年龄；辨出本人后还须区别旧地与现处，春旺末木日仅参两个事实相接。"
    },
    {
      "key": "20/1/卯",
      "articleSha256": "3a0146a60d344e92611e6114d0f797e6cebdb7af32d8713670acc397f24d9c15",
      "finding": "同一亲见转来几次仍只一源。求见可着手与《行人占》迟归没有串成当日回家，本坤没有因末震改取东方。"
    },
    {
      "key": "20/1/辰",
      "articleSha256": "d2467df059afdd51564d1b196312ce7f22077232ab556325b4b38a798c16b2e2",
      "finding": "确认过的旧地点留作起点，旺土兼弱木使末震之和难承，不由土旺断已平安，也没把困难当永久找不到。"
    },
    {
      "key": "20/1/巳",
      "articleSha256": "d900073eea0c9e7add45e917def6f8c63838546124ee711b7d5ce0060978b94f",
      "finding": "声音认得真，可给身份一项支持，地点和时间仍另求依据。木休而三土相费力，末木同休，偶有衔接之机。"
    },
    {
      "key": "20/1/午",
      "articleSha256": "e892a5db8758efe428b6aa82606d6d6bee81dd32cb906927321d7ed62b9b9ef9",
      "finding": "收件日与目击日各指一件事。木休克相土，末震之和未增成许诺回复；实地方向的参照与确认下落分开查。"
    },
    {
      "key": "20/1/未",
      "articleSha256": "7dda6f150cf6f2f59e77ffbe7ed4e45a1effcf1bf67977d984cdf932529841cd",
      "finding": "问得出去未必问得明白，囚木面对同旺的本互土。坤得令属于人的卦气，不能代替安危核实或现实求助。"
    },
    {
      "key": "20/1/申",
      "articleSha256": "fde391143c136a4e0477d534cb1dfe902bb96b6384ad81074380d1e3429c204a",
      "finding": "秋木弱时仍许把能查的地方问实，不能因此指望贯穿全程。人取坤，不从求寻一方木“死”推人身状况。"
    },
    {
      "key": "20/1/酉",
      "articleSha256": "331c1616b314c51f3616bde82461f0417207d02bf23e250158e897730f7d9dc3",
      "finding": "辨同名同貌靠确能识别本人的来由；时间早的认人只坐实旧事。土休木弱，末和薄，不因坤方相合就认证身份。"
    },
    {
      "key": "20/1/戌",
      "articleSha256": "d957cac35a7a91873625443220daafde8e98c3197bd64fe40817e4f7361a0811",
      "finding": "旧处地名准确与见面的时点隔开讲。戌令囚木制旺土、末和亦囚，困难保有可查之处，没把爻序算成回话日。"
    },
    {
      "key": "20/1/亥",
      "articleSha256": "9aca0618c61d574d6401a2d73827e6c4aa56519ba02652fe8afbda2659cdddee",
      "finding": "辨出亥令水旺与盘内并无坎水两件事，末震、巽都得相。后来的真目击能有新价值，重转旧话没有另添一次印证。"
    },
    {
      "key": "20/1/子",
      "articleSha256": "624ce8797107e6db8d3348b4fb8d6d9c3ae5ca5224062a08ffa804cc5e37ebd3",
      "finding": "即使前些天行程没问全，当前身份地点核实已够。末震指衔接之机，没去造一条路线或把安危混同下落。"
    },
    {
      "key": "20/1/丑",
      "articleSha256": "6bde1d1d87d6b8b165ffca989f0b82ac9bce8c3803fb7408d0eb589422ff5a53",
      "finding": "相符的西南平地不能算第二份消息。土令弱末和也不足支持定日，“初”非第一日，不因迟收到旧讯推断重新露面。"
    },
    {
      "key": "20/2/寅",
      "articleSha256": "35e589f6891d42be79e42c7cdb347e26a131a1b889676071100da38a0f472a8a",
      "finding": "二在内而应五，有可见之处亦有边界。初互三土受旺木制，末休坎水生木；去处能说明到何时才决定见闻可用范围。"
    },
    {
      "key": "20/2/卯",
      "articleSha256": "3ba71b69cac81581082a8e4ea94e2f45addc84a267045c623576b145b376dcee",
      "finding": "传得远与有多个独立来源分开处理。剥居互没被讲成不幸已发生；本用仍坤，末水的帮助有待新资料。"
    },
    {
      "key": "20/2/辰",
      "articleSha256": "f0d5035ffd4957444d3b798473f3d09a9bd8656ba58217b7fb6deda17908d464",
      "finding": "代问者认识本人还是只认识传话人，作证能力不同。辰土旺、巽囚，末坎死仍生，条件保留得较薄。"
    },
    {
      "key": "20/2/巳",
      "articleSha256": "8c427a648355e156a9329f02491a26de97b4fa71655af392a797c6e6b5bdf969",
      "finding": "由声音能核到人并不能核到地点，夏令坎囚虽弱仍生。未从爻中“女”推性别，也未借变坎标出水边住址。"
    },
    {
      "key": "20/2/午",
      "articleSha256": "61f5c1a1d8774b23fb7ddf92adda0f56c4fa0b153638be2e7ae522026a517302",
      "finding": "确有相见不等于记得准确日期，不能让旁人补的日期覆盖原来记忆。夏末水助薄，没有以应期耽搁现实核查。"
    },
    {
      "key": "20/2/未",
      "articleSha256": "3371bd57430f03c1ce249520d94688017fc101433802f44ece8a69abbb92f07f",
      "finding": "亲知一截能把旧闻问稳；旺土难制、末水弱生，新一截仍要有依据。未从肯少说推人有所隐瞒。"
    },
    {
      "key": "20/2/申",
      "articleSha256": "50f0310d2e5d3d53b0b3e2ee45af6bf9215d5c0664b6e9a88036a2e9844585c8",
      "finding": "相似身影尚须辨认。秋坎得相比夏助厚，但只生求寻之巽，失联者安危仍看现实，未拿末水改方位。"
    },
    {
      "key": "20/2/酉",
      "articleSha256": "d7fc2c9047ff5585887331f26b5e0edd96c37d7f6d5ba82ff712e4a6a2e918de",
      "finding": "同地名有可能是同一回会面，也可能是两回，须核来路与时点；秋木弱而末水相，不以传闻一致推出一直未动。"
    },
    {
      "key": "20/2/戌",
      "articleSha256": "e88e4692fe772228bbf808d0e0e6b9aeff178644906886efa19e2daf950830ee",
      "finding": "“还在那里”比“待过”多了从过去到现在的一层。末坎虽生，土令水死，薄助与现实条件均明，没有把戌土再计一份方位凭据。"
    },
    {
      "key": "20/2/亥",
      "articleSha256": "ff6ff9a7ad23cefa0fb829d5b469b2b81a701fe69a95088a170d52e8b9bcb850",
      "finding": "孰能说明过去，孰能说明目前，两端需分别核准。冬末旺水助相木有力，原坤取西南，没有迁出一条走向北方的路线。"
    },
    {
      "key": "20/2/子",
      "articleSha256": "ac9397faa19d04b31fa5038265234154e06c83d27bc7bff07df34fb61deb71b6",
      "finding": "由切实可靠的见闻定了现处，无须再以本人说话、返家为门槛；冬末之水只加核实机会，不提供平安担保。"
    },
    {
      "key": "20/2/丑",
      "articleSha256": "03ab26a226cd4b8fa792e41409a2c02d69737daf1e4db77bff57587bd3c487eb",
      "finding": "一处能辨人、一处能辨地点，须先证实对应同一回事实，不能把两件各有缺项的资料合成结论。末死水生扶保留但很薄。"
    },
    {
      "key": "20/3/寅",
      "articleSha256": "9c82f620df9dd77cffcd59a1bcbf15606827e6bb08f5b68c01f692bf1d928b9f",
      "finding": "《正义》所释“我生”是己所行，落实为重新衡量已有查问；四处木制土，无另外水援，不从渐卦推所寻之人正在走动。"
    },
    {
      "key": "20/3/卯",
      "articleSha256": "8076fab86ba1101163b00c094dea8a2fd8d32838f5bcd6fb7dce088056522c90",
      "finding": "身份若有缺，时地再详也只可作待辨的一条。旺木可制而无直接生扶，末艮之止没有变作“本人肯定留在原地”。"
    },
    {
      "key": "20/3/辰",
      "articleSha256": "4d588cd4783e703f5a5591ecc88a83025dc2f0e88b7ea35a32fb30bb9a0f798d",
      "finding": "囚木制本互末旺土，仍有求见的着力处，却难凭旧证定位。没把寻找者无力倒推失联者受到何种伤害。"
    },
    {
      "key": "20/3/巳",
      "articleSha256": "27a10396401f65e8ebdc1e8206c7db24f505f48f4a2b344503d5761ef6643e57",
      "finding": "何种消息能认人并知近况，决定核实先后。夏休木制相土费力仍可办，古文进退放在寻访方法而未推本人进退路线。"
    },
    {
      "key": "20/3/午",
      "articleSha256": "98ffe5dcf28fbb3ae2e64812e52dbc71b9047d1c50caed1577d10f6e5d784157",
      "finding": "后续情况须有能说明后来的来源，不能靠反复询问前一次目击者把时间推后；末艮也是被体所制的土，没有单独定日。"
    },
    {
      "key": "20/3/未",
      "articleSha256": "3c5355eed619d1050b665c4f087feb5ba2c7f154cb4d69c4a39ec58ea44f631a",
      "finding": "旺土不是四个地点，没有给人安排行踪。找人的难处与可随新近事实调整的判断并存，无需等若干天再去查。"
    },
    {
      "key": "20/3/申",
      "articleSha256": "f54ef57f70fe54d0ef8745c2987e6e9f19687ee708b50ae5d1423247a8d10287",
      "finding": "将一时未获消息与不愿回家分开。申月木衰、秋土休，仍可主动而承接不足；四土不直接克木，没有用秋死推人的性命。"
    },
    {
      "key": "20/3/酉",
      "articleSha256": "913a61bdc8b39ffa04abcd67ca222416fc177aaa732229252add29810b25b7fc",
      "finding": "退回最后直接见面，退的是推测的部分，亲见不因更正失效。四处受木制，不能以月支直接推出会在酉日联系。"
    },
    {
      "key": "20/3/戌",
      "articleSha256": "70d12b6c2ee864eca72d29121e44edf5967d2115aae7974e27c0317271116bf9",
      "finding": "转述中漏掉“大约”会把推测当成目击，具体而贴爻。末艮并非人的停留地，西南不能作为原说法未经提供的方向。"
    },
    {
      "key": "20/3/亥",
      "articleSha256": "be485c2fb7cba4129996aa7d92c23df74c8e3376f67e9869b10b54641a253a81",
      "finding": "《谒见》可求与《行人》迟归分别适用；冬木相，四土囚，即使尚未回家，可靠核实现处亦已回答寻人。"
    },
    {
      "key": "20/3/子",
      "articleSha256": "e73a5b2716a2087c4b7b94b03dbb88006bc29397ddf3f922753e5c9d39c4c198",
      "finding": "以原话核准本人身份、时间、所在，避免预先给答案而得到附和。冬相木主动可办不保证他自己会来联系。"
    },
    {
      "key": "20/3/丑",
      "articleSha256": "848e19ff2adc7ac6bf15e10be91fbd5a99ce2fe5ad7e31a5241a7a7b6b7fae41",
      "finding": "原问题若只涉及常去何处，回答不能变成本次行踪。四旺土无反克也无生扶，缺独立日应，未把“渐”读成脚程。"
    },
    {
      "key": "20/4/寅",
      "articleSha256": "d4054cbaee54ad087ab26d748e3eed95390129c73885067986a53c0ac6b7b358",
      "finding": "动在上卦，转以巽作人、坤作求寻。王注明习国仪只在近事实者能知这一层迁用，木日所参是开局受阻。"
    },
    {
      "key": "20/4/卯",
      "articleSha256": "0d74a35ca9fbe3f3de9aa1a8b5afc7d2aa7dfb70e2c66a8b60d66675e81c2406",
      "finding": "见证人的可信度与其见闻能覆盖哪一天分别核；春旺巽克弱坤、两互弱而末土生囚金，不将末乾西北作行向。"
    },
    {
      "key": "20/4/辰",
      "articleSha256": "3a06d1cab332bd6020bc610883fcef2c6666992b0ee3be3c5175bea7f0230484",
      "finding": "查清来路也许只把昔日会面查清。旺体旺互给核实能力，囚木之克较缓，末生相乾仍耗，保留有利面而未径断找到。"
    },
    {
      "key": "20/4/巳",
      "articleSha256": "22d23418e71e68b4efe77e50aa1c302ea7e79b43c84d47eeb4de3284c1a99bff",
      "finding": "愿帮忙与有亲自辨人、定位的能力不同。休巽克相坤，末乾失令仍受生有耗，爻辞不导出现实有人正在接待本人。"
    },
    {
      "key": "20/4/午",
      "articleSha256": "d46c4472992f5472d93843df6ef42ed42c729ad4c7a86fc236ed63c3266e9c2e",
      "finding": "核到最早目击者才方便知旧闻来历，但来源未能核清只是条件之一。互土相和既能帮助，也不会让重复的旧话变成新人证。"
    },
    {
      "key": "20/4/未",
      "articleSha256": "e953b0295d21a70bea5a56d97cd588c9b9137b9e3d5c3d144a1c5ef04a3447cd",
      "finding": "消息能问回出处与人在后一个时点是否仍在分别核定。旺土中互便利未被变名否抹掉，末生相金仍不直接扶体。"
    },
    {
      "key": "20/4/申",
      "articleSha256": "46078dd9268f15f6e485023ea1aa22699ab16de7756b6a3b639f9a8dc475f9ee",
      "finding": "熟其人与知这件事分开辨。秋弱巽仍克休坤，末旺乾受生较费力；不从熟人的资历推定所寻之人去了哪里。"
    },
    {
      "key": "20/4/酉",
      "articleSha256": "19d366d362d71584f4f539c36289397944450f5203c1abf44317f069355a75da",
      "finding": "讲清来路有助于追查，熟悉来路者未必知当今所在。秋令本克势缓且和力有限，中段有利不抵消末生旺乾。"
    },
    {
      "key": "20/4/戌",
      "articleSha256": "d388c81c85f636c71848c5a1ec6be0a65976edea110cab130665168bb6d455c6",
      "finding": "愿证明的或是人、或是过去地点、或是今日仍在那里，各需相应见闻。土旺相和没有补出独立目击。"
    },
    {
      "key": "20/4/亥",
      "articleSha256": "e66cb617211019002365adf6c666ac6182cb0499943c608ba2c1e74e11a06dcb",
      "finding": "亲见一则消息证明消息存在，未证明亲见本人。冬相木克囚土，两互弱和、末耗，没借六四之“王”指定接待者。"
    },
    {
      "key": "20/4/子",
      "articleSha256": "7e640494529694f67ae9c751e51075d959815cb5f94aded39deddac2ba70d1cb",
      "finding": "接近的方式不同，各能确认的项目也不同；通话只证明它能切实说清的部分。原巽方位、本克及两互同囚均守住。"
    },
    {
      "key": "20/4/丑",
      "articleSha256": "9066ebefc9ea0f9d833b5e81558adff174622ca571b294f2e1b21128365f9637",
      "finding": "比较两份目击要先对清人、时、地，不问谁名望最大。旺土互和可受囚木之克，末生相乾仍无生援。"
    },
    {
      "key": "20/5/寅",
      "articleSha256": "f45806c252408e36874edc6a6f3ae806d245f7bfa8965860bf97a8af883f425f",
      "finding": "回看初次判断传到他人处是否变强，切合观民察己。互变均剥，末艮为比和；无咎未用作安危或亲友责任判据。"
    },
    {
      "key": "20/5/卯",
      "articleSha256": "1f607cc9e52bfd54a8b0f23c1e64fd48e4d7cbee9dfbba6fd2b322ae285e6c59",
      "finding": "消息转一圈回到最初的猜想，不构成另一个来源。两互末艮同弱而比和，土与土之间不成立五行相生。"
    },
    {
      "key": "20/5/辰",
      "articleSha256": "12f53f5a9620cf6e87bea5f08e1e1fac7093dd6de60dc9a82c7d6d7ae588071d",
      "finding": "一群人对同一地点点头，不能确保各人都亲知其事。旺土有力核对，未见生援，旧闻能否转进现处仍待现实。"
    },
    {
      "key": "20/5/巳",
      "articleSha256": "b6a6a7c6df9354cf00086ccbc7a56c17ab368ed0b7734fe14a03fa8d57e30deb",
      "finding": "已知相见与相见发生于何时分开。互、变同名剥但分居中末，不增算两次真实遭遇，较难不排斥确证的新下落。"
    },
    {
      "key": "20/5/午",
      "articleSha256": "fe6cf312fbe38d9f6a26232d39c4848716ca580a1c972540c99a0acd4514b0c3",
      "finding": "宽心话与近日亲知当前安危性质不同；核问的对象是原始信息能说明的时间、地点，不是替亲友追究责任。"
    },
    {
      "key": "20/5/未",
      "articleSha256": "567e89ca415800c914ca731cac31786eb97c15dcc77c2491709c32edbfcf9ee5",
      "finding": "数份资料若只证同一回露面，仍未增加后来的见闻。旺体与互末同旺比和有效，但旧证可信也不能跨到现在。"
    },
    {
      "key": "20/5/申",
      "articleSha256": "6fdc1aed94d6b007bcbe8834297ecd2f9c5d1a0340aeb8c459ecdea50298c024",
      "finding": "无咎论所行，不托以报平安；秋互末休而和，只能有限相核。卦方的东南及草木仅用来比较，不计作独立目击证据。"
    },
    {
      "key": "20/5/酉",
      "articleSha256": "8c4d25ce6769bc3b14f7ed5642275451829caf9d873c62cb4f1590c40d7cec2f",
      "finding": "同名、同一个地名不等于身份已确认，来路与时间分别核；未拿秋巽之衰或互变之剥推定身体遭遇。"
    },
    {
      "key": "20/5/戌",
      "articleSha256": "0c55a585f288b3914505b4a37ffe4bab84e343fe683145e64a08b1fcdde29d7d",
      "finding": "如果各方仍只能证实过去，“还没查到”保留了现处缺证的实情。旺土同气可补查，但不为平安作保。"
    },
    {
      "key": "20/5/亥",
      "articleSha256": "39dcac11d5be542e394e0bf50aa2114d13a1393a6779c98ecb15a0112f75258f",
      "finding": "是否只是顺着询问者的意愿安慰，与是否掌握近况是不同问题。强本克、弱互末之和均有论述，未加罪于问话人。"
    },
    {
      "key": "20/5/子",
      "articleSha256": "a479a694455acce75eeea9237b867bb9c8c66909a2ff57d3bc3dabbda899f2a9",
      "finding": "受提示后的同意有来源依赖，不能单独拿来定位或解释心意。冬囚土在末段虽和仍弱，日期只观交叉核实。"
    },
    {
      "key": "20/5/丑",
      "articleSha256": "147a23eec5f6d2be8e445424c2b41775374c9c7fc636d717608378e956f613d0",
      "finding": "按消息的先后追到来源，防止把后听到的同一说法又计一次。互变同剥不表示现实两件事必然相同。"
    },
    {
      "key": "20/6/寅",
      "articleSha256": "d77d5450e29e5ab000f53ef6825e29d11782cf5e6dab59969945bec98cf71d97",
      "finding": "区分众人注目与有人在场亲见。王弼、程颐释义各有所指，春末休水由弱坤制，不由变卦比取会合日期。"
    },
    {
      "key": "20/6/卯",
      "articleSha256": "49f9867c6e10f90e49e3542ae565b3dad059f57349a8d2887a0246c9e044b2de",
      "finding": "拼成连贯的路线不等于每段都有实见。旺巽克弱坤、末坎受制，不隐去中互尚有核对的空间。"
    },
    {
      "key": "20/6/辰",
      "articleSha256": "c343cd83f8c68c04eb9dcd33cb58a281d41b6532d2e3c7fef352330ee85e2ec2",
      "finding": "末段旺土制死水确有核查力量，但不是凭它就能生出现处资料。没有把不同注本对“其生”的解释强合为一个主客关系。"
    },
    {
      "key": "20/6/巳",
      "articleSha256": "05de85aa1c037c5560f5b872287c55638a81e7d1a68472480a573e2631904932",
      "finding": "查实某个地点仍要指明所对应的时点。夏相坤制囚坎较省力，中互相和，是否寻获按真实近况而不是按“比”字。"
    },
    {
      "key": "20/6/午",
      "articleSha256": "85eabd71d2cb187f09a92eac626cc3943e08af132466ce021afa0c250a0a30e2",
      "finding": "“常去”与“这一次去了”所证明的事情不同；旺衰给求证能力，习惯不能凭方向合象而转成当前所在。"
    },
    {
      "key": "20/6/未",
      "articleSha256": "42bb5cb220c94fc19ca8695f46058969dded2a838394433725be4eaee5efe9e8",
      "finding": "证人能说明哪日哪处就把话留在那里；互土同旺、末制弱水均未省。旧事以外的情况不拿爻辞代为判断。"
    },
    {
      "key": "20/6/申",
      "articleSha256": "ae59530fde8269a4007ecc93d7a4b6ddb62153d531c92d01292511cdaa5cca2d",
      "finding": "新近收到旧闻并没有更新目击时点。秋弱木之克、休土制相水均保留，未用间隔天数推算安危或动机。"
    },
    {
      "key": "20/6/酉",
      "articleSha256": "7b4de3a49cfe369bfb59d1deabb4b3e95891946bb3cf7eb13bc1c8211f74e623",
      "finding": "“我之后没再见过”只能说明一位见证者的视野。没有扩大为无人再见，也没有借坎水给失联者填下一站。"
    },
    {
      "key": "20/6/戌",
      "articleSha256": "0d640a3f3600546cdf133ef28d5cd6073ee0f5c75e5fe0cc343b711cb4a17b02",
      "finding": "多人说法无明显矛盾，仍不能证明那一日以后皆如此。旺坤有力制水但无直接生体，分开证词与后续推断。"
    },
    {
      "key": "20/6/亥",
      "articleSha256": "73eb6756dc15691fbf57c30fc72108238425335f821f939bedcd771364984c57",
      "finding": "冬囚土制旺坎，收尾吃力；志未平按爻义，未说失联者焦虑、受困或有意隐瞒。可以先答已查实的下落。"
    },
    {
      "key": "20/6/子",
      "articleSha256": "9ba1982b5aa48abced540e09ce00f3ac396c5c96e972fb8de00525a70d4820fd",
      "finding": "转述保留旧话原来的时间与确定程度；末旺水不为方位根据，尽管有一段缘由也不能用它替下落作答。"
    },
    {
      "key": "20/6/丑",
      "articleSha256": "0bed03e2a4fdbb15fa52cb47aadf8f541b89aa9bc68614667272c4949bf9a9ad",
      "finding": "能说明早先行动还算自如，仅及当时。互中同旺与末土制水都可用，变卦比未扩展为一定会面或联系日。"
    }
  ]
}
