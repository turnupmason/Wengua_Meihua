  "findings": [
    {
      "status": "resolved",
      "finding": "春九二寅卯判断栏明确末为体克用而非克体；六三寅简断改正失位、卯范围缩窄及字数补实义、亥不像语字；九四午/亥明确末坎，丑不冒称得位；上六午比和不来生原体、丑上六未光。修改共10篇，均整篇复读通过；未冒称真人效度。"
    }
  ],
  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "和兑按王孔居初无所党系、无私说和、说不为谄；原上兑与下兑比和、中下离克、上巽受体克、末下坎泄。季土秋有条件，其余较难，取初金日仅有现实近期渠道。"
    },
    {
      "movingLine": 2,
      "finding": "孚兑依中而有孚、失位悔亡古义；末下震明为体所克而非克体，季土秋有条件，春夏冬较难；前两春月判断词纠正后整篇复核。"
    },
    {
      "movingLine": 3,
      "finding": "来兑为阴来居阳位、非正求悦古戒，末乾比和不是生体；春夏较难，季土秋冬有条件，卯月查证范围按现代寻获不以家中会面缩窄，寅简断爻位失当与亥语字修正后再核。"
    },
    {
      "movingLine": 4,
      "finding": "商兑未宁、介疾有喜是商量裁制、近尊隔邪古义；原体转下兑，体互下离克，用互上巽受原体克，末上坎泄。核午/亥/丑修订确认尾坎方位段、九四不得位。"
    },
    {
      "movingLine": 5,
      "finding": "孚剥厉由九五尊正比上六而信不当的古注解释，不指认真人嫌疑人；尾上震受体克，秋季土有条件，春夏冬较难。所有候期仅限有真实近期渠道的初比材料相接。"
    },
    {
      "movingLine": 6,
      "finding": "引兑旧注静退见引后悦、区别六三自进求悦且小象未光；原下兑始终不换体，尾上乾比和，春夏较难，季土秋冬有条件。午“非来生原体”与丑“上六未光”修后整篇通过。"
    }
  ],
