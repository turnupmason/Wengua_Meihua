  "findings": [
    {
      "status": "resolved",
      "finding": "逐篇核实前三爻坤体、后三爻巽体，三种木日取法所指阶段、金日、水日及上六不立日。对读王孔、朱子、程传和礼记的语境，跨卦重题整篇重写，改正预设地点、危险、动机和实际是否取得回复的措辞。"
    }
  ],
  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初六允升，原体坤受巽与震之克，互兑及末乾泄体；木日参起初本巽克体的核查限制。"
    },
    {
      "movingLine": 2,
      "finding": "九二与五相应，同辞萃六二，朱子义见萃但不移彼卦判断；末艮比和，木日取中段互震克坤。"
    },
    {
      "movingLine": 3,
      "finding": "九三升虚邑，孔疏以升上六、朱子以进临于坤解，初本巽克坤参木日。末坎受克，师六三不另作动爻。"
    },
    {
      "movingLine": 4,
      "finding": "六四王孔顺纳、程传止己分与朱子登祭分别看；变恒，中途体互兑克巽取金日，末震与巽比和。"
    },
    {
      "movingLine": 5,
      "finding": "六五以贞为得吉条件，任九二而不专；变井，末坎直接生巽据水日，晋卦三接与曲礼东西阶均只对读。"
    },
    {
      "movingLine": 6,
      "finding": "上六冥升所戒在进极；初坤末艮皆为原体巽木所克，互兑克体仍在但无明确日级应事，不以冥暗或不息编日期。"
    }
  ],
