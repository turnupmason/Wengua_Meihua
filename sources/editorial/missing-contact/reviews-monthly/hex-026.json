  "findings": [
    {
      "status": "resolved",
      "finding": "逐篇复核本用换体、期日指初中末何处及传统行人归与本题寻获的差别。去掉已送达、已返家、确知他人知情等预设，并分开同月相近切口。"
    }
  ],
  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初九受六四所畜，止无据推断。艮土生金、中末震巽克土，取末木日。"
    },
    {
      "movingLine": 2,
      "finding": "九二遇难能止，车象喻人事。末离生艮改取火日，仅参得助，不将行人归答作找到。"
    },
    {
      "movingLine": 3,
      "finding": "九三得时而可进，艮生乾、两兑三耗，中震来克，木日参中阻。日、曰异文不定现实日期。"
    },
    {
      "movingLine": 4,
      "finding": "六四初艮生乾，位置取艮东北山径，互兑和，末离来克取火日；止于其初不推人被控制。"
    },
    {
      "movingLine": 5,
      "finding": "六五居尊位而制健。孔疏记多训，柔制刚不取动物实象。末体制巽，取初艮生体的土日。"
    },
    {
      "movingLine": 6,
      "finding": "上九取王孔畜极而通，天衢非实地。初艮末坤均生乾，取末坤土日；季节强弱分别核清。"
    }
  ],
