  "findings": [
    {
      "status": "resolved",
      "finding": "初九秋令审计补足正反证，子月首段结论用词订正；九二经文庫作陰而校订文本作阴，改用两个独立原句，保留其子和之，不篡改古籍。六四、九五、上九首句多样化，简断不固定月令开头，后段不多算强弱。"
    }
  ],
  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "上巽原体下兑用；颐互上艮下震，末坎水生巽，冬回生得令、春夏有机会、土秋前克重；取中比或后生，不拿应期替代实际联系。虞注为专，燕训安。"
    },
    {
      "movingLine": 2,
      "finding": "末震木与原巽同比；春夏冬保留机会，土秋弱比难承首克，盘内无直接生体。鸣鹤子和表诚信相类外应，靡散不私利。"
    },
    {
      "movingLine": 3,
      "finding": "末乾金再克原巽，春冬体有气且中比扶，仍留机会，土夏秋难；古义三四相对而不比、位不当非现实嫌疑与情绪。"
    },
    {
      "movingLine": 4,
      "finding": "原体转为静下兑，上巽原用受体克，互艮生体、震受克，末乾比和；土秋较充分、夏冬有条件、春难。月几望、马匹亡为阴德盛、绝类上承不争，非实物和定日。"
    },
    {
      "movingLine": 5,
      "finding": "中艮和末艮分别生原兑，土秋较充分、夏冬条件、春难；挛如系信不绝是诚信要求，不能对真人加持续联系义务。"
    },
    {
      "movingLine": 6,
      "finding": "末坎受原兑生，不能倒称末生体。土令旺中生、弱末耗可承；夏秋条件、春冬难。翰音音飞实不从乃诚信戒，不能指控现实人物。"
    }
  ],
