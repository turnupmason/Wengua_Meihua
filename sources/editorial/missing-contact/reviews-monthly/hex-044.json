  "findings": [
    {
      "status": "resolved",
      "finding": "核对六爻体用换位、旺衰和三种日期口径，区分王孔、朱氏注义与现代寻人。跨卦近稿已重写，人物、地理、处境与眼下实据逐项复读，并补足引用朱氏的卷二来源。"
    }
  ],
  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初六乾体制巽用，互变三乾比和。王孔金柅制动、朱子静正则吉，羸豕取喻不指身体。无可定日。"
    },
    {
      "movingLine": 2,
      "finding": "九二末艮土生乾，春夏冬留机会、季土及秋较有希望。土日只参末段有助，用巽取方位。"
    },
    {
      "movingLine": 3,
      "finding": "九三初体制巽，互比，末乾生坎而泄；王孔得位不遇时、朱子无遇免其伤，未安排日期。"
    },
    {
      "movingLine": 4,
      "finding": "九四原用改乾金、下巽木为体，前中三克，末巽比和。金日参起初限制，不把无鱼定作遇险。"
    },
    {
      "movingLine": 5,
      "finding": "九五三乾克巽，末木生离；金日依旧只参开头。含章、自天及得地不食分别据王孔与朱氏，不给真人编遭遇。"
    },
    {
      "movingLine": 6,
      "finding": "上九三乾及末兑皆克巽，四克逐月辨轻重。角在上穷、吝无咎不作实际场所、人格或安危；没有另行定日的事件。"
    }
  ],
  "articleReviews": [
    {
      "key": "44/1/寅",
      "articleSha256": "2066752d8afd7c741adaf316cb5b73863353b99468e3d309f1a15ef74c5134d0",
      "finding": "据王弼制动之主指九四，孔疏引马氏说柅止轮，不用器物指真人被缚或实际被困的地点。"
    },
    {
