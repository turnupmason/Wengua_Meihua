      "articleSha256": "cf577dd14dfdf0651a217ac680f19010cd1e0f6285a7377c5a0a2b628bcec1e2"
    },
    {
      "key": "60/5/丑",
      "finding": "丑原体相，起死水泄薄，囚震可制、旺艮中生及旺坤末生两节点各有实助，支持较足；土日非固定联系。",
      "articleSha256": "05702e9f1811d0dab934f2f61997172bcfbde0d75a6dab821218945e62733ceb"
    },
    {
      "key": "60/6/寅",
      "finding": "春原兑囚、坎休起泄，中死艮助薄，中震及末巽旺木由原体克而难制；王孔分苦节施人与修身，不作真人受制证据。",
      "articleSha256": "968dc302463b36f468442207bfb10e35eeeb72c8da1ea12f80a70a7b17fb18e8"
    },
    {
      "key": "60/6/卯",
      "finding": "卯令同寅，末巽是体克用不误作变用克体，旺木难制非直接人员伤害，整体难。",
      "articleSha256": "7ced0740702f8c47a0e871ecf6d83336ce52a84bbd241b0e97afb2d1172f2a9a"
    },
    {
      "key": "60/6/辰",
      "finding": "辰相兑可承薄耗、中旺艮生实、震巽囚木较可制，留机会；末制非生和，古苦节警戒保留；土日指中段支持。",
      "articleSha256": "3b86a474e84b2e9b55bc120bbddb3df874e42470066895c0a295f2490443ea79"
    },
    {
      "key": "60/6/巳",
      "finding": "夏死兑、中相艮虽生但初囚坎泄及两休木受体克较不易，末非回助，取难；无具体定日条件。",
      "articleSha256": "5dcf9238a017892081414505c4a752f952af088f2ce7c15b3810398e5d4f758c"
    },
    {
      "key": "60/6/午",
      "finding": "午同巳，变上巽由原体克而不是克原体，古凶与悔亡分说，不断真人受到制约。",
      "articleSha256": "92c74fda0b2f52d8afe095f561925ea4b6724b76458e4dc8f871f3fe4343d2bc"
    },
    {
      "key": "60/6/未",
      "finding": "未有旺艮中生和原兑相气，起死水耗薄、两囚木制约较轻则留机会，尾无直接生比；土日阶段例。",
      "articleSha256": "11ca38f7cb8f6f4d041667c81fedfb62632a1b6ef1e72ba433cf32bcc8e298c3"
    },
    {
      "key": "60/6/申",
      "finding": "申体旺可承相水初泄，死木两处为体所克、艮休中生，留条件机会；中土日只能演示材料支持。",
      "articleSha256": "d8cf0fc596d06388a3f32b5e41da8bf1cacc8bb62d0fab32a5652d378000f74a"
    },
    {
      "key": "60/6/酉",
      "finding": "酉同申，体克末用不表本人确定提供消息，中助留机会；苦节施人之训不能被转为现实施压理由。",
      "articleSha256": "462c952493c5d037e85cddc80ca7725906cbdf1675a76cb897190d677fb56c62"
    },
    {
      "key": "60/6/戌",
      "finding": "戌体相、死水耗薄、旺艮生实、中末囚木被体克较可承，条件寻获；中段土日不是联系日期。",
      "articleSha256": "8d5adb0dff0a8cc0fbd0d2972f3cda85740b7b2aa0081aad1d9e20422912076f"
    },
    {
      "key": "60/6/亥",
      "finding": "亥初旺水耗休金、中囚艮生薄、两相木受体克较难、末无生和，取难；悔亡不作实际安危结论。",
      "articleSha256": "288f7253ef3d074d634917b5cff550f3ab06350ed38b46090c00ebb4d63d2d46"
    },
    {
      "key": "60/6/子",
      "finding": "子同亥，坎旺及原兑耗均不能反推人员现实水险或受害，苦节与悔亡古义分别说明。",
      "articleSha256": "1a4891e6356db08d19b72236e5f4e43fbda372e8e635745429964e0167113ef3"
    },
    {
      "key": "60/6/丑",
      "finding": "丑季土原兑相，初死坎耗薄，旺艮中生及两囚木可制留机会，末体克非生比；实际寻获以确证为限。",
      "articleSha256": "8a60c3bf438429f9b6d9288cd523509c939999e5399bc126aae5f40594b5373e"
    }
  ],
