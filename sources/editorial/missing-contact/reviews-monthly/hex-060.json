  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初九识通塞及初立制度不可推现实住所。原上坎，起兑生、中艮克震泄，末坎比。"
    },
    {
      "movingLine": 2,
      "finding": "九二应宣制而不宣乃失时，与初九时位相反；末震泄体，中末耗与起生分别。"
    },
    {
      "movingLine": 3,
      "finding": "六三失节而嗟，王孔释无所怨咎非平安或真人归责。末乾独生原坎。"
    },
    {
      "movingLine": 4,
      "finding": "六四安节得位顺九五，不证明真人安稳。原体改下兑，起坎泄，中艮生震受克，末兑比。"
    },
    {
      "movingLine": 5,
      "finding": "九五居中为节主不苦，非说明个人生活；原下兑，起坎耗，中艮末坤分段生体。"
    },
    {
      "movingLine": 6,
      "finding": "苦节施人则凶、自修俭约可悔亡两层义不混。中震与末巽是原体所克的木，非克体，不用于现实强求或定位。"
    }
  ],
