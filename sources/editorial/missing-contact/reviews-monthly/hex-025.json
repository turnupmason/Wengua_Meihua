  "findings": [
    {
      "status": "resolved",
      "finding": "逐篇检视原话、见闻可及的时地和对当下的证明力，改掉推知动机、强加返家、把推测写成既成事实及同月重复切入。九四起转换体用，末克与初克取日对象分开。"
    }
  ],
  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初九本互均见体乾克木，中末艮、坤生乾取土日；勿将往吉说成人正向东走。"
    },
    {
      "movingLine": 2,
      "finding": "六二末兑同金而和，取期改从中艮生体。代终不造借来说明真见闻可承接，不替前人凑证。"
    },
    {
      "movingLine": 3,
      "finding": "六三末离来克，火日只参末段核实。行人为有司取自王孔，不从系牛或邑人受灾推真人遭祸。"
    },
    {
      "movingLine": 4,
      "finding": "九四上卦变动，乾为本用参西北，初乾克震，中末巽同气。守正容得下据新实情纠正旧断。"
    },
    {
      "movingLine": 5,
      "finding": "九五末离受体所生，夏旺火耗尤重。无妄疾药据孔疏喻人事，未指真人伤病；未收到约信不责对方失约。"
    },
    {
      "movingLine": 6,
      "finding": "上九初乾末兑两头克震。春冬中段有可办处亦据两克、无直接生体及穷行戒意判难；金日只取末兑，不借灾眚定安危。"
    }
  ],
