  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初六泥井时舍：初泄本巽、中克离受兑生，末变乾金生坎，金日看末段可得何助。"
    },
    {
      "movingLine": 2,
      "finding": "九二与五无正应，井谷射鲋、瓮敝漏未上济，末艮克坎故取土日核收尾限制。"
    },
    {
      "movingLine": 3,
      "finding": "九三渫而未食，可用汲而应上；中途兑金生体取金日，末坎比和不另生应期。"
    },
    {
      "movingLine": 4,
      "finding": "六四得位无正应，甃壁而未及给上。原体改下巽，初坎生体取水日，中末兑皆克巽。"
    },
    {
      "movingLine": 5,
      "finding": "九五得中正，王孔择贤、朱子功及于物以有其德应、程传可食而尚未至上；互兑克体取金日，末巽克坤。"
    },
    {
      "movingLine": 6,
      "finding": "上六井收勿幕，有孚元吉非无条件许寻获；本坎生体取水日，末变巽与原体比和。"
    }
  ],
