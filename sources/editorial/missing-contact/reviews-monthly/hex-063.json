  "findings": [
    {
      "status": "resolved",
      "finding": "已按Guan独立逐篇反馈修初九午原体用词，六二卯辰酉戌亥五处语义，九三辰酉亥子四处措辞，六四卯辰取用和归迟两处，九五寅巳午申四处。改后各整篇读回；引用原爻与古注字形范围分别说明，各月均不依固定套语起首。"
    }
  ],
  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "上坎原体下离原用受体克；互下坎比、互上离受体克，末艮土克原体。春土夏难、秋冬有机会，取中同比而不取末克，初济濡尾无咎非现实安全。"
    },
    {
      "movingLine": 2,
      "finding": "上坎为体，末乾生原体。春土有条件、夏难、秋冬较充分。七日得在失茀古代故事，不定真人回返与联系日期、勿逐不劝现实遇险等待。"
    },
    {
      "movingLine": 3,
      "finding": "上坎为体，末震受体生而耗，春土夏难、秋冬留机会，取中比的水日而非末耗。高宗伐鬼方历史譬喻、三年非现代期限、小人勿用非人物指认。"
    },
    {
      "movingLine": 4,
      "finding": "原体下离，两坎克原体，互上离比，末兑受体制。春夏有机会，土秋冬难。库爻辞繻有衣袽与王孔𦈡宜曰濡，引用确同的终日戒，不改录文；衣袽塞舟漏是古义。"
    },
    {
      "movingLine": 5,
      "finding": "原体下离、两水克、互上同火、中和后末坤受体生而耗；春夏有机会，土秋冬难。东邻西邻祭礼合德合时，不能作地理定位和候日。"
    },
    {
      "movingLine": 6,
      "finding": "两水克离为体、中离比和、末巽木向原体来生。春夏较充分、土有条件、秋冬难；冬末木相生是正证，前中两旺水克仍在。濡首厉只道既济极则返未济之古戒。"
    }
  ],
