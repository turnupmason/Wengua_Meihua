  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初六鸿渐于干，水涯训义不定位置；上巽原体制下艮，中坎生、体生离，末下离受体生。取中水日。"
    },
    {
      "movingLine": 2,
      "finding": "六二鸿渐于磐，饮食衎衎各有古义；末下巽比和上巽，申酉则改取中下坎直接生体的水日，其余取末木日。"
    },
    {
      "movingLine": 3,
      "finding": "九三陆与所进失宜分读，原上巽克原艮、末坤；中下坎直接生体，取水日；上离耗仍在。"
    },
    {
      "movingLine": 4,
      "finding": "六四桷取宜栖之枝，王孔、程朱及《集解》对读；下艮原体初受克、末上乾受体生，有中上离直接生体，取火日。"
    },
    {
      "movingLine": 5,
      "finding": "九五二五相应并非立刻无隔，下艮原体、末上艮比和；春取中火扶，冬取初木阻，余取末土比和。"
    },
    {
      "movingLine": 6,
      "finding": "上九陆、逵异文和羽仪不另定位置；下艮原体中末均制坎，非末坎克体。冬候初木阻，其余取中离火扶。"
    }
  ],
  "articleReviews": [
