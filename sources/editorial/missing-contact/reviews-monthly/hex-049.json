  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初九巩用黄牛之革，先克中比末艮土生兑，土日看收尾助力。"
    },
    {
      "movingLine": 2,
      "finding": "六二得中应五，诸本日字不同，末下乾金与兑比和，金日只候收尾接续。"
    },
    {
      "movingLine": 3,
      "finding": "九三三就有孚仍戒复征，中互乾金比兑取金日，末震木为兑所制。"
    },
    {
      "movingLine": 4,
      "finding": "九四下离为体，上兑为用，中互巽木生离，末坎水克离故取水日参尾阻。"
    },
    {
      "movingLine": 5,
      "finding": "九五大人虎变、未占有孚，末震木生离取木日，不与中巽生重复计数。"
    },
    {
      "movingLine": 6,
      "finding": "上六革终宜守而戒复征，中互巽生离取木日，末变乾金为离所克。"
    }
  ],
