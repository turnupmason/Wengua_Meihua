  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初九大作取居下能任、元吉乃免咎；巽体制三土，震用比和取开头木日。"
    },
    {
      "movingLine": 2,
      "finding": "六二不召而外益，永贞有条件，不以享帝定场所；变兑克巽取末金日。"
    },
    {
      "movingLine": 3,
      "finding": "六三王孔任救凶与朱熹受警戒两说分列，末体生离，未有日期依据，均留空。"
    },
    {
      "movingLine": 4,
      "finding": "六四处巽初而行中，告公从、依迁国不定人已迁徙；震体末受乾克，以金日参末阻。"
    },
    {
      "movingLine": 5,
      "finding": "九五有孚惠心、元吉不待问不免现实查证，震木制互末三土，取初巽比和木日。"
    },
    {
      "movingLine": 6,
      "finding": "上九或击不写伤人、勿恒分王孔及朱熹作戒之意。末变坎直接生体，水日参末助，合全局定难易。"
    }
  ],
