  "findings": [
    {
      "status": "resolved",
      "finding": "缩窄过长的时间推断，六三未月用条件句保留尚未发生的查访，上九辰月改由收尾利势起笔。经日历核实，六二、六四与九五各自对应不同阶段，六三与上九未强列日期。"
    }
  ],
  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初六取童观之见浅，末震比和；春夏冬须补近况，秋土偏难，方位取本坤。"
    },
    {
      "movingLine": 2,
      "finding": "六二取窥观有应而所见窄。变坎生巽，亥子日参收尾得助，旺衰逐令区分。"
    },
    {
      "movingLine": 3,
      "finding": "六三原体巽克本互末四土，进退解察己所行，十二篇不取日。"
    },
    {
      "movingLine": 4,
      "finding": "六四换坤体巽用。近五得位只论知情条件，本克、互和、末生乾耗。"
    },
    {
      "movingLine": 5,
      "finding": "九五互、变皆山地剥，末艮和，与六四有别。无咎不取为平安，土日参收尾核证。"
    },
    {
      "movingLine": 6,
      "finding": "上九兼核王弼、程颐之解，冬囚土制旺水难，土令旺土制死水可办。未从变名比断相见。"
    }
  ],
