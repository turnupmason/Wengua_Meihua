  "findings": [
    {
      "status": "resolved",
      "finding": "逐篇改清在场与认人、旧日一面与眼下所在、转述与直接知情者的差别；换体后按坤论方位。时日、安危和缘故各依实据，五态死囚不落人身。"
    }
  ],
  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初九弱强分开，四土比和不冒称土生土；不远说及时知返，不能量离家距离。"
    },
    {
      "movingLine": 2,
      "finding": "六二休为休美。初克、中和、末土生金为耗，核实来处不预设有人知道、有人亲见。"
    },
    {
      "movingLine": 3,
      "finding": "六三初克中和、末离生体，以夏旺火与冬死火分轻重；频蹙不定重复次数。"
    },
    {
      "movingLine": 4,
      "finding": "六四转坤为本用，强木制三土而末木和，独应初九不能指定本人独处；亲见和可靠自报同可用。"
    },
    {
      "movingLine": 5,
      "finding": "六五末坎水生震，按月辨扶助强弱；守厚自考不要求失联者说明缘故或认错。"
    },
    {
      "movingLine": 6,
      "finding": "上六从初至末皆体震克土，无可直接取日本题节点；仍保留旺相木能办事与迷复戒意。"
    }
  ],
