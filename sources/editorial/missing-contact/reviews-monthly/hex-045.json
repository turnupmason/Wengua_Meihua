  "findings": [
    {
      "status": "resolved",
      "finding": "核对六爻体用换位、旺衰和初坤、末艮、中巽、末震与不取日五种取法，区分王孔、朱氏注义与现代寻人。跨卦近稿已重写，人物、地理、处境与眼下实据逐项复读，并补足引用朱氏的卷二来源。"
    }
  ],
  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初六坤与互艮生兑，互巽和末震受制。土日参初坤得助，有孚不终、若号一握为笑分辨王孔与朱注。"
    },
    {
      "movingLine": 2,
      "finding": "六二末变坎水泄兑，仍取初坤土日。引吉和薄祭不作实际召唤、祭期；酉参读困九二不得作第二动爻。"
    },
    {
      "movingLine": 3,
      "finding": "六三变艮再生兑，取土日参收尾得助。上巽指上六柔巽，不能同互巽合出东南消息。"
    },
    {
      "movingLine": 4,
      "finding": "九四体改下坤，初泄兑、互巽克与艮和、末制坎。木日参中巽克，中段受限不应到本人安危。"
    },
    {
      "movingLine": 5,
      "finding": "九五中巽、末震皆克坤，取木日只参收尾核实。匪孚读王孔与朱氏各自注义，永贞与悔亡不能给真人定动机、日期。"
    },
    {
      "movingLine": 6,
      "finding": "上六初生兑、末生乾皆泄体，互巽克与艮和。孤立无援及涕洟为原爻所论，不作真人已哭泣、独处或遇险的实情；无确定的日级应事。"
    }
  ],
  "articleReviews": [
