  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初九旬字对读王均与虞坤十离日，末下艮受上震制。季土和秋取中兑金，其余取中巽木。"
    },
    {
      "movingLine": 2,
      "finding": "六二蔀、斗、疑疾与孚按古注分义，下离变下乾，十二月取末金克上震。"
    },
    {
      "movingLine": 3,
      "finding": "九三沛、斾及肱的异读不用于报告真人伤病，末下震比和，申酉取中兑金，其余取末震木。"
    },
    {
      "movingLine": 4,
      "finding": "九四夷主与明夷彖象分别读，末上坤受下离生而耗，十二月取中下巽生下离的木。"
    },
    {
      "movingLine": 5,
      "finding": "六五来章有庆誉各照王朱程虞解，末上兑受下离制，十二月取中巽木生体。"
    },
    {
      "movingLine": 6,
      "finding": "上六三岁、阒、自藏、天际翔留原经义。春冬取中下巽木生体，夏取末上离火比和，季土与秋不按日。"
    }
  ],
