  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初九跛而履、吉相承，卦与爻之征辞分读。原体上震受本用下兑克，体互上坎生体与末下坎生体各有作用，取末水日。"
    },
    {
      "movingLine": 2,
      "finding": "九二眇视、幽人之贞按王孔程虞辨。变下震同气；巳午申酉取中上坎水，其余取末震木。"
    },
    {
      "movingLine": 3,
      "finding": "六三须的等待、需象、待年说与位未当分别对校。原体上震受原下兑克，末下乾也克体；十二月均取末下乾金日。"
    },
    {
      "movingLine": 4,
      "finding": "九四愆期有待依各注所重，末上坤直接生原体下兑，土日只参收尾核问。"
    },
    {
      "movingLine": 5,
      "finding": "六五爻辞衣袂及几望分经注说法。巳午参中下离来克取火，余月取末上兑比和的金。"
    },
    {
      "movingLine": 6,
      "finding": "上六虚筐及刲羊无血为古礼经注。中末两离都克原体下兑，取末上离之火日，十二月判较难。"
    }
  ],
