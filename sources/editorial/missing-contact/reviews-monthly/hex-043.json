  "findings": [
    {
      "status": "resolved",
      "finding": "核准夬卦本用换位、四阶段生克及日期依据。跨卦近题已退修重写，辨明爻位与现实人地、实际所见及其时点，未将号咷、苋陆或肤伤作真人经历。"
    }
  ],
  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初九本用乾与体兑，末巽受体克。前趾言用力于前，不推当事人已出门；无日级候选。"
    },
    {
      "movingLine": 2,
      "finding": "九二本互三金比和，末离火克兑体，候火日参末环节制约；莫夜有戎不得写作具体遇袭。"
    },
    {
      "movingLine": 3,
      "finding": "九三四金俱和而月令制其力，王孔与朱子分说遇雨若濡，未从天气及无咎定日。"
    },
    {
      "movingLine": 4,
      "finding": "九四本兑及两互乾和体，末金生坎而泄，金日参初段。王孔牵羊喻五不指失联者被带走。"
    },
    {
      "movingLine": 5,
      "finding": "九五前三和，末乾克震；中途配合取体互乾比原体的金日。王孔苋陆易决，朱子重决而不过。"
    },
    {
      "movingLine": 6,
      "finding": "上六本互变四和，弱月偏难、得时月留机会。无号终凶在夬极消长，不作真人事故、位置或日期。"
    }
  ],
