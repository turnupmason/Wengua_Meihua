    {
      "movingLine": 3,
      "finding": "九三鼎耳与铉、雉膏及方雨各有训释，末坎克离取水日。"
    },
    {
      "movingLine": 4,
      "finding": "九四以下巽为体，上离为用。形渥与刑剭异文并核，中体互乾克巽取金日，末巽克艮。"
    },
    {
      "movingLine": 5,
      "finding": "六五黄耳金铉利贞，孔疏应二，朱子存一说。末变乾克巽，金日参尾阻。"
    },
    {
      "movingLine": 6,
      "finding": "上九玉刚而润，刚柔得节。末上震与下巽比和，候木日参收尾接续。"
    }
  ],
