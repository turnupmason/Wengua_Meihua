  "findings": [
    {
      "status": "resolved",
      "finding": "改正初九、六二的月支与五行语序，核清六三对同日见闻的误判、九四卯午带骨训释与程传出处、六五末克及上九的证据范围。真有可靠现处不强求多人互证；疑似未经证实也不能即作排除。"
    }
  ],
  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初九本震生体，末坤受离生；取最初得助处，轻戒不作足伤。"
    },
    {
      "movingLine": 2,
      "finding": "六二末兑受克，土令即使耗力仍可着手；王程在入易与深浅上各有侧重，核准各篇出处。"
    },
    {
      "movingLine": 3,
      "finding": "六三末两离相和，核实消息是否同源。遇毒不指现实生怨或身体受害。"
    },
    {
      "movingLine": 4,
      "finding": "九四动在上卦，原用离、体震，互坎能生体、互末艮可制，冬水旺取较有望。"
    },
    {
      "movingLine": 5,
      "finding": "六五末乾反克木，区别九四末艮受克，黄金不指钱财，已确认所在不再写成仍有机会。"
    },
    {
      "movingLine": 6,
      "finding": "上九春冬正证足却须留凶戒，末两震同气不推移动方向。候选水日只参互坎助力。"
    }
  ],
