  "findings": [
    {
      "status": "resolved",
      "finding": "七十二篇核准兑体与坎体的分界，初末候金、土日与无应期的爻分别落实。对读王孔、程朱与诗经葛藟等，不编位置、危险或动机。重题逐篇改写，经退修再核来源、各栏和读页。"
    }
  ],
  "lineReviews": [
    {
      "movingLine": 1,
      "finding": "初六下坎为用，原体兑金生坎。末兑比和不改初居困底的限制，三岁不觌不作日数。"
    },
    {
      "movingLine": 2,
      "finding": "九二变萃，末坤直接生兑，土日参末助；酒食、朱绂与祭享分别依王孔、程朱原注。"
    },
    {
      "movingLine": 3,
      "finding": "六三上比四、下据二、无正应。末巽受兑制，互离仍克体；无特定可列作应期的事件。"
    },
    {
      "movingLine": 4,
      "finding": "九四原体改下坎，初兑生，中克离、生巽，末坎比和。金日取初助，王朱释金车不立车辆线索。"
    },
    {
      "movingLine": 5,
      "finding": "九五初兑生体取金日，末震为坎所生。能改任壮而徐有说，不以劓刖或礼名写真人伤情、经历。"
    },
    {
      "movingLine": 6,
      "finding": "上六初兑末乾皆生坎，金日只参收尾，葛藟、臲卼不足定位本人；知悔行吉不能泛作任何行动都吉。"
    }
  ],
