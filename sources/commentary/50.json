{
  "schemaVersion": "1.0.0",
  "contentVersion": "2026.11.10.2",
  "hexagramId": 50,
  "name": "火风鼎",
  "sourceId": "user-detailed-docx",
  "trustScope": "source-commentary-only;not-authoritative-rules-or-proven-outcomes",
  "attributions": "作者名为原稿所署，未核验独立出版版本；新补文字不署作这些作者原话",
  "groups": [
    {
      "key": "intro",
      "label": "卦义",
      "sections": [
        {
          "title": "卦辞、象辞与白话",
          "paragraphs": [
            {
              "id": "p-07127",
              "text": "鼎：元吉，亨。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07127",
                "bodyParagraph": 7063
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07128",
              "text": "【白话】《鼎卦》象征革故鼎新：十分吉祥，亨通。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07128",
                "bodyParagraph": 7064
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07129",
              "text": "《象》曰：木上有火，鼎，君子以正位凝命。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07129",
                "bodyParagraph": 7065
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07130",
              "text": "【白话】《象辞》说：《鼎卦》的卦象是巽（木）下离（火）上，为木上燃着火之表象，是烹饪的象征，称为鼎；君子应当像鼎那样端正而稳重，以此完成使命。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07130",
                "bodyParagraph": 7066
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "卦义与哲学解读",
          "paragraphs": [
            {
              "id": "p-07132",
              "text": "鼎卦离上巽下，木上有火，象征烹饪成物，也引申为革故鼎新、确立秩序。鼎原是炊煮重器，亦象征国家法度与权威。《序卦》说“革物者莫若鼎，故受之以鼎”，强调旧局变革以后，需要有新制度承接。行事要“正位凝命”，位置端正、责任相称，用人得当。事业宜稳中创新；经商要在商业道德与成本纪律之上扩展。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07132",
                "bodyParagraph": 7068
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        }
      ]
    },
    {
      "key": "line-1",
      "position": 1,
      "label": "初六",
      "sections": [
        {
          "title": "爻辞、象辞与白话",
          "paragraphs": [
            {
              "id": "p-07135",
              "text": "初六，鼎颠趾，利出否；得妾以其子无咎。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07135",
                "bodyParagraph": 7071
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07136",
              "text": "【白话】初六，烹饪食物的鼎足颠翻，却顺利地倒出了鼎中陈积的污秽之物；就好像娶妾可以生子一样，不会发生灾祸。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07136",
                "bodyParagraph": 7072
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07137",
              "text": "《象》曰：“鼎颠趾”，未悖也；“利出否”，以从贵也。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07137",
                "bodyParagraph": 7073
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07138",
              "text": "【白话】《象辞》说：“烹饪食物的鼎足颠翻”，看似反常，实则不然；“却顺利地倒出了鼎中陈积的污秽之物”，便于除旧布新，反常的现象得以向好的方面转化。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07138",
                "bodyParagraph": 7074
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "邵雍解（网页吉凶提要）",
          "paragraphs": [
            {
              "id": "p-07140",
              "text": "平。该吉凶提示沿用用户所贴传统占解，仅供作为古代文献的一种理解。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07140",
                "bodyParagraph": 7076
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "爻变与变卦",
          "paragraphs": [
            {
              "id": "p-07142",
              "text": "初六爻动，变为第14卦《大有卦》（火天大有）。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07142",
                "bodyParagraph": 7078
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "爻义与哲学解析",
          "paragraphs": [
            {
              "id": "p-07144",
              "text": "初六“鼎颠趾，利出否”，倾鼎倒出旧秽物，看似反常，实为去旧纳新。纳妾得子是古人以非常方式成全结果之喻。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07144",
                "bodyParagraph": 7080
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        }
      ]
    },
    {
      "key": "line-2",
      "position": 2,
      "label": "九二",
      "sections": [
        {
          "title": "爻辞、象辞与白话",
          "paragraphs": [
            {
              "id": "p-07147",
              "text": "九二，鼎有实；我仇有疾，不我能即，吉。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07147",
                "bodyParagraph": 7083
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07148",
              "text": "【白话】九二，鼎中盛满了烹饪的食物，好比一个人有才干；我的对立面嫉妒我，却不能把我怎么样，是吉祥的。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07148",
                "bodyParagraph": 7084
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07149",
              "text": "《象》曰：“鼎有实”，慎所之也；“我仇有疾”，终无尤也。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07149",
                "bodyParagraph": 7085
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07150",
              "text": "【白话】《象辞》说：“鼎中盛满了烹饪的食物，好比人有才干”，应该谨慎行事，不要走错方向；“我的对立面嫉妒我”，但因无隙可乘，故终将无所怨尤。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07150",
                "bodyParagraph": 7086
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "邵雍解（网页吉凶提要）",
          "paragraphs": [
            {
              "id": "p-07152",
              "text": "吉。该吉凶提示沿用用户所贴传统占解，仅供作为古代文献的一种理解。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07152",
                "bodyParagraph": 7088
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "爻变与变卦",
          "paragraphs": [
            {
              "id": "p-07154",
              "text": "九二爻动，变为第56卦《旅卦》（火山旅）。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07154",
                "bodyParagraph": 7090
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "爻义与哲学解析",
          "paragraphs": [
            {
              "id": "p-07156",
              "text": "九二“鼎有实，我仇有疾，不我能即，吉”，鼎中充实易招妒嫉；只有持中守正、处事谨慎，才可使对手无隙可乘。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07156",
                "bodyParagraph": 7092
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        }
      ]
    },
    {
      "key": "line-3",
      "position": 3,
      "label": "九三",
      "sections": [
        {
          "title": "爻辞、象辞与白话",
          "paragraphs": [
            {
              "id": "p-07159",
              "text": "九三，鼎耳革，其行塞，雉膏不食；方雨亏悔，终吉。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07159",
                "bodyParagraph": 7095
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07160",
              "text": "【白话】九三，鼎器的耳部发生了变化，无法将插杠插入鼎耳移鼎，精美的野鸡肉不能得到无法食用；待到陰陽调和，润雨出现才能消释悔恨，最终还可以获得吉祥。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07160",
                "bodyParagraph": 7096
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07161",
              "text": "《象》曰：“鼎耳革”，失其义也。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07161",
                "bodyParagraph": 7097
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07162",
              "text": "【白话】《象辞》说：“鼎器的耳部发生了变化”，鼎无法移动，也就失去了它虚中纳物的意义。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07162",
                "bodyParagraph": 7098
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "邵雍解（网页吉凶提要）",
          "paragraphs": [
            {
              "id": "p-07164",
              "text": "平。该吉凶提示沿用用户所贴传统占解，仅供作为古代文献的一种理解。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07164",
                "bodyParagraph": 7100
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "爻变与变卦",
          "paragraphs": [
            {
              "id": "p-07166",
              "text": "九三爻动，变为第64卦《未济卦》（火水未济）。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07166",
                "bodyParagraph": 7102
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "爻义与哲学解析",
          "paragraphs": [
            {
              "id": "p-07168",
              "text": "九三“鼎耳革，其行塞，雉膏不食”，因鼎耳有损而好物不得用，说明有才却与位置、沟通或方法不相配。待形势调和，悔可减，终吉。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07168",
                "bodyParagraph": 7104
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        }
      ]
    },
    {
      "key": "line-4",
      "position": 4,
      "label": "九四",
      "sections": [
        {
          "title": "爻辞、象辞与白话",
          "paragraphs": [
            {
              "id": "p-07171",
              "text": "九四，鼎折足，覆公餗，其形渥，凶。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07171",
                "bodyParagraph": 7107
              },
              "patchIds": [
                "detail-edit-0101"
              ],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07172",
              "text": "【白话】九四，鼎的足折断了，王公鼎里的粥饭倾倒出来了，鼎身被玷污，凶险。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07172",
                "bodyParagraph": 7108
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07173",
              "text": "《象》曰：“覆公餗”，信如何也！",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07173",
                "bodyParagraph": 7109
              },
              "patchIds": [
                "detail-edit-0102"
              ],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07174",
              "text": "【白话】《象辞》说：“王公鼎里的粥饭倾倒出来了”，哪里还有什么信誉可言呢！",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07174",
                "bodyParagraph": 7110
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "邵雍解（网页吉凶提要）",
          "paragraphs": [
            {
              "id": "p-07176",
              "text": "凶。该吉凶提示沿用用户所贴传统占解，仅供作为古代文献的一种理解。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07176",
                "bodyParagraph": 7112
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "爻变与变卦",
          "paragraphs": [
            {
              "id": "p-07178",
              "text": "九四爻动，变为第18卦《蛊卦》（山风蛊）。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07178",
                "bodyParagraph": 7114
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "爻义与哲学解析",
          "paragraphs": [
            {
              "id": "p-07180",
              "text": "九四“鼎折足，覆公餗，其形渥，凶”，力小任重或用人不当，可能误了重要托付，毁损公信。职责必须与能力相称。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07180",
                "bodyParagraph": 7116
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        }
      ]
    },
    {
      "key": "line-5",
      "position": 5,
      "label": "六五",
      "sections": [
        {
          "title": "爻辞、象辞与白话",
          "paragraphs": [
            {
              "id": "p-07183",
              "text": "六五，鼎黄耳金铉，利贞。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07183",
                "bodyParagraph": 7119
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07184",
              "text": "【白话】六五，鼎配上黄色的鼎耳，插上坚固的扛鼎之器，利于坚守正道。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07184",
                "bodyParagraph": 7120
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07185",
              "text": "《象》曰：“鼎黄耳”，中以为实也。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07185",
                "bodyParagraph": 7121
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07186",
              "text": "【白话】《象辞》说：“鼎配上黄色的鼎耳”，是由于六五爻居中，自然可获得实惠。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07186",
                "bodyParagraph": 7122
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "邵雍解（网页吉凶提要）",
          "paragraphs": [
            {
              "id": "p-07188",
              "text": "吉。该吉凶提示沿用用户所贴传统占解，仅供作为古代文献的一种理解。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07188",
                "bodyParagraph": 7124
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "爻变与变卦",
          "paragraphs": [
            {
              "id": "p-07190",
              "text": "六五爻动，变为第44卦《姤卦》（天风姤）。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07190",
                "bodyParagraph": 7126
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "爻义与哲学解析",
          "paragraphs": [
            {
              "id": "p-07192",
              "text": "六五“鼎黄耳金铉，利贞”，黄色居中、金铉坚实，比喻领导能够守中纳贤，让制度与用人稳固相接。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07192",
                "bodyParagraph": 7128
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        }
      ]
    },
    {
      "key": "line-6",
      "position": 6,
      "label": "上九",
      "sections": [
        {
          "title": "爻辞、象辞与白话",
          "paragraphs": [
            {
              "id": "p-07195",
              "text": "上九，鼎玉铉，大吉，无不利。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07195",
                "bodyParagraph": 7131
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07196",
              "text": "【白话】上九，鼎配上玉制的鼎杠，十分吉祥，不会有什么不利。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07196",
                "bodyParagraph": 7132
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07197",
              "text": "《象》曰：玉铉在上，刚柔节也。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07197",
                "bodyParagraph": 7133
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            },
            {
              "id": "p-07198",
              "text": "【白话】《象辞》说：“玉制的鼎杠高处上方，表明刚柔相济，互相调节。”",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07198",
                "bodyParagraph": 7134
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "邵雍解（网页吉凶提要）",
          "paragraphs": [
            {
              "id": "p-07200",
              "text": "吉。该吉凶提示沿用用户所贴传统占解，仅供作为古代文献的一种理解。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07200",
                "bodyParagraph": 7136
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "爻变与变卦",
          "paragraphs": [
            {
              "id": "p-07202",
              "text": "上九爻动，变为第32卦《恒卦》（雷风恒）。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07202",
                "bodyParagraph": 7138
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        },
        {
          "title": "爻义与哲学解析",
          "paragraphs": [
            {
              "id": "p-07204",
              "text": "上九“鼎玉铉，大吉，无不利”，玉饰之铉象征刚柔得节、德才兼备。身居高处仍需谦和，不可自傲。",
              "sourceRef": {
                "sourceId": "user-detailed-docx",
                "part": "word/document.xml",
                "paragraphId": "p-07204",
                "bodyParagraph": 7140
              },
              "patchIds": [],
              "contentKind": "historical-commentary;not-verified-outcome"
            }
          ]
        }
      ]
    }
  ],
  "excludedParagraphs": 0
}
