{
  "name": "wengua-meihua-knowledge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Source-traceable Meihua and 64-hexagram knowledge layer for the Wengua temple application",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "validate": "node scripts/validate.mjs",
    "build:data": "node scripts/run-python.mjs scripts/build-all.py",
    "example": "node examples/read.mjs",
    "demo": "node scripts/serve.mjs",
    "build:sqlite": "node scripts/run-python.mjs scripts/export-sqlite.py",
    "validate:details": "node scripts/run-python.mjs scripts/validate-details.py",
    "app:install": "npm --prefix apps/mobile install",
    "app:dev": "npm --prefix apps/mobile run dev",
    "app:test": "npm --prefix apps/mobile test",
    "app:build": "npm --prefix apps/mobile run build"
  }
}
