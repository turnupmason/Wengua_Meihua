{
  "name": "wengua-meihua-knowledge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Source-traceable Meihua and 64-hexagram knowledge layer for the Wengua temple application",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "build:data": "python3 scripts/build-all.py",
    "example": "node examples/read.mjs",
    "demo": "node scripts/serve.mjs",
    "build:sqlite": "python3 scripts/export-sqlite.py",
    "validate:details": "python3 scripts/validate-details.py",
    "validate:stories": "python3 scripts/validate-stories.py",
    "build:stories": "node scripts/build-narratives.mjs",
    "example:story": "node examples/story.mjs",
    "build:timing": "node scripts/build-timing-audit.mjs",
    "validate:timing": "python3 scripts/validate-timing-audit.py",
    "build:calendar": "node scripts/build-day-calendar.mjs",
    "build:questions": "node scripts/build-question-catalog.mjs && python3 scripts/export-questions.py",
    "validate:questions": "python3 scripts/validate-questions.py"
  }
}
