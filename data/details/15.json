      "changedHexagram": {
        "id": 39,
        "name": "水山蹇",
        "bitsBottomUp": [
          0,
          0,
          1,
          0,
          1,
          0
        ]
      },
      "editorialNotes": [
        {
          "text": "六五“不富以其邻，利用侵伐”，说明谦道并非放弃原则；小象“征不服也”应放在古代秩序与征伐语境中理解。",
          "kind": "new-editorial-paraphrase",
          "evidence": {
            "hexagramId": 15,
            "referenceId": "zhouyi-15",
            "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%AC%99&oldid=2106142&variant=zh-hans",
            "structuralRule": "六爻由下至上；奇位阳位、偶位阴位；单动爻只翻转该位"
          }
        }
      ],
      "commentaryGroup": "line-5"
    },
    {
      "position": 6,
      "label": "上六",
      "canonicalLineId": "hex-15-line-6",
      "structure": {
