          0,
          0,
          0
        ]
      },
      "editorialNotes": [
        {
          "text": "六二“鸣谦，贞吉”，小象“中心得也”，重在内心确有谦德而自然表现于外，不是只求谦逊的名声。",
          "kind": "new-editorial-paraphrase",
          "evidence": {
            "hexagramId": 15,
            "referenceId": "zhouyi-15",
            "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%AC%99&oldid=2106142&variant=zh-hans",
            "structuralRule": "六爻由下至上；奇位阳位、偶位阴位；单动爻只翻转该位"
          }
        }
      ],
      "commentaryGroup": "line-2"
    },
    {
      "position": 3,
      "label": "九三",
      "canonicalLineId": "hex-15-line-3",
      "structure": {
        "polarity": "yang",
        "positionType": "yang",
        "correctPosition": true,
        "central": false,
        "respondingPosition": 6,
        "oppositeResponse": true
      },
      "changedHexagram": {
        "id": 2,
        "name": "坤为地",
        "bitsBottomUp": [
          0,
          0,
          0,
          0,
          0,
          0
        ]
      },
      "editorialNotes": [
        {
          "text": "九三“劳谦君子”，有功劳而不自矜；小象“万民服也”将众人信服与这种品德联系起来。",
          "kind": "new-editorial-paraphrase",
          "evidence": {
            "hexagramId": 15,
            "referenceId": "zhouyi-15",
            "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%AC%99&oldid=2106142&variant=zh-hans",
            "structuralRule": "六爻由下至上；奇位阳位、偶位阴位；单动爻只翻转该位"
          }
        }
      ],
      "commentaryGroup": "line-3"
    },
    {
      "position": 4,
      "label": "六四",
      "canonicalLineId": "hex-15-line-4",
      "structure": {
        "polarity": "yin",
        "positionType": "yin",
        "correctPosition": true,
