          0,
          0,
          1
        ]
      },
      "editorialNotes": [
        {
          "text": "上六“鸣谦，利用行师，征邑国”，与志愿未遂、整治自身所属的古代政治语境相连，不是“大有上九”的天佑之辞。",
          "kind": "new-editorial-paraphrase",
          "evidence": {
            "hexagramId": 15,
            "referenceId": "zhouyi-15",
            "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%AC%99&oldid=2106142&variant=zh-hans",
            "structuralRule": "六爻由下至上；奇位阳位、偶位阴位；单动爻只翻转该位"
          }
