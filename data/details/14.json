          1,
          1,
          0,
          1
        ]
      },
      "editorialNotes": [
        {
          "text": "九二“大车以载”，小象“积中不败也”，借能承载之车说明内有积蓄、能够担当。重点是充实能力与谨慎任事。",
          "kind": "new-editorial-paraphrase",
          "evidence": {
            "hexagramId": 14,
            "referenceId": "zhouyi-14",
            "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%A4%A7%E6%9C%89&oldid=10645712&variant=zh-hans",
            "structuralRule": "六爻由下至上；奇位阳位、偶位阴位；单动爻只翻转该位"
          }
        }
      ],
      "commentaryGroup": "line-2"
    },
    {
      "position": 3,
      "label": "九三",
      "canonicalLineId": "hex-14-line-3",
      "structure": {
        "polarity": "yang",
        "positionType": "yang",
        "correctPosition": true,
        "central": false,
        "respondingPosition": 6,
        "oppositeResponse": false
      },
      "changedHexagram": {
        "id": 38,
        "name": "火泽睽",
        "bitsBottomUp": [
          1,
          1,
          0,
          1,
          0,
          1
        ]
      },
      "editorialNotes": [
        {
          "text": "九三“公用亨于天子，小人弗克”，用朝享之礼说明有德者能够承担相应礼遇，小人则难以胜任。亨字的通读需结合所据注本。",
          "kind": "new-editorial-paraphrase",
          "evidence": {
            "hexagramId": 14,
            "referenceId": "zhouyi-14",
            "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%A4%A7%E6%9C%89&oldid=10645712&variant=zh-hans",
            "structuralRule": "六爻由下至上；奇位阳位、偶位阴位；单动爻只翻转该位"
          }
        }
