    "canonicalGrade": "中上卦"
  },
  {
    "id": 21,
    "name": "火雷噬嗑",
    "alias": "噬嗑卦",
    "theme": "刚柔相济",
    "rawGrade": "上上卦",
    "gradeSource": "user-grade-table",
    "poem": "运拙如同身受饥，幸得送饭又送食，适口充腹心欢喜，忧愁从此渐消移。",
    "poemLabel": "用户提供诗象（非周易象传）",
    "description": "这个卦是异卦（下震上离）相叠。离为阴卦；震为阳卦。阴阳相交，咬碎硬物，喻\n恩威并施，宽严结合，刚柔相济。噬嗑（shihe）为上下颚咬合，咀嚼。",
    "sourceRef": {
      "sourceId": "user-grade-table",
