      "endChar": 1275,
      "startLine": 48,
      "endLine": 52
    },
    "trigramNamesFromDescription": [
      "乾",
      "巽"
    ],
    "canonicalGrade": "下下卦"
  },
  {
    "id": 10,
    "name": "天泽履",
    "alias": "履卦",
    "theme": "脚踏实地",
    "rawGrade": "中上卦",
    "gradeSource": "user-grade-table",
    "poem": "凤凰落在西歧山，去鸣几声出圣贤，天降文王开基业，富贵荣华八百年。",
    "poemLabel": "用户提供诗象（非周易象传）",
    "description": "这个卦是异卦（下兑上乾）相叠，乾为天；兑为泽，以天喻君，以泽喻民，原文：\n“履（踩）虎尾、不咥（咬）人。”因此，结果吉利。君上民下，各得其位。兑柔遇乾\n刚，所履危。履意为实践，卦义是脚踏实地的向前进取的意思。",
    "sourceRef": {
      "sourceId": "user-grade-table",
      "startChar": 1275,
      "endChar": 1436,
      "startLine": 53,
      "endLine": 58
    },
    "trigramNamesFromDescription": [
      "兑",
      "乾"
    ],
    "canonicalGrade": "中上卦"
  },
  {
    "id": 11,
    "name": "地天泰",
    "alias": "泰卦",
    "theme": "应时而变",
    "rawGrade": "中中卦",
    "gradeSource": "user-grade-table",
    "poem": "学文满腹入场闱，三元及第得意回，从今解去愁和闷，喜庆平地一声雷。",
    "poemLabel": "用户提供诗象（非周易象传）",
    "description": "这个卦是异卦（下乾上坤）相叠，乾为天，为阳；坤为地，为阴，阴阳交感，上下\n互通，天地相交，万物纷纭。反之则凶。万事万物，皆对立，转化，盛极必衰，衰而转\n盛，故应时而变者泰（通）。",
    "sourceRef": {
      "sourceId": "user-grade-table",
      "startChar": 1436,
      "endChar": 1582,
      "startLine": 59,
      "endLine": 64
    },
    "trigramNamesFromDescription": [
      "乾",
      "坤"
    ],
    "canonicalGrade": "中中卦"
  },
  {
    "id": 12,
    "name": "天地否",
    "alias": "否卦",
    "theme": "不交不通",
    "rawGrade": "中中卦",
    "gradeSource": "user-grade-table",
    "poem": "虎落陷坑不堪言，进前容易退后难，谋望不遂自己便，疾病口舌事牵连。",
    "poemLabel": "用户提供诗象（非周易象传）",
    "description": "这个卦是异卦（下坤上乾）相叠，其结构同泰卦相反，系阳气上升，阴气下降，天\n地不交，万物不通。它们彼此为“综卦”，表明泰极而否，否极泰来，互为因果。",
    "sourceRef": {
      "sourceId": "user-grade-table",
      "startChar": 1582,
      "endChar": 1712,
      "startLine": 65,
      "endLine": 69
    },
    "trigramNamesFromDescription": [
