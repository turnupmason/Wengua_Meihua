      "乾"
    ],
    "canonicalGrade": "中中卦"
  },
  {
    "id": 13,
    "name": "天火同人",
    "alias": "同人卦",
    "theme": "上下和同",
    "rawGrade": "中上卦",
    "gradeSource": "user-grade-table",
    "poem": "心中有事犯猜疑，谋望从前不着实，幸遇明人来指引，诸般忧闷自消之。",
    "poemLabel": "用户提供诗象（非周易象传）",
    "description": "这个卦是异卦（下离上乾）相叠，乾为天，为君；离为火，为臣民百姓，上天下\n火，火性上升，同于天，上下和同，同舟共济，人际关系和谐，天下大同。",
    "sourceRef": {
      "sourceId": "user-grade-table",
      "startChar": 1712,
      "endChar": 1840,
      "startLine": 70,
      "endLine": 74
    },
    "trigramNamesFromDescription": [
