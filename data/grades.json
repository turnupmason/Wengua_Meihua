[
  {
    "id": 1,
    "name": "乾为天",
    "alias": "乾卦",
    "theme": "刚健中正",
    "rawGrade": "上上卦",
    "gradeSource": "user-grade-table",
    "poem": "困龙得水好运交，不由喜气上眉梢，一切谋望皆如意，向后时运渐渐高。",
    "poemLabel": "用户提供诗象（非周易象传）",
    "description": "这个卦是同卦（下乾上乾）相叠。象征天，喻龙（德才的君子），又象征纯粹的阳\n和健，表明兴盛强健。乾卦是根据万物变通的道理，以“元、亨、利、贞”为卦辞，示\n吉祥如意，教导人遵守天道的德行。",
    "sourceRef": {
      "sourceId": "user-grade-table",
      "startChar": 0,
      "endChar": 148,
      "startLine": 1,
      "endLine": 6
    },
    "trigramNamesFromDescription": [
      "乾",
      "乾"
    ],
    "canonicalGrade": "上上卦"
  },
  {
    "id": 2,
    "name": "坤为地",
    "alias": "坤卦",
    "theme": "柔顺伸展",
    "rawGrade": "上上卦",
    "gradeSource": "user-grade-table",
    "poem": "肥羊失群入山岗，饿虎逢之把口张，适口充肠心欢喜，卦若占之大吉昌。",
    "poemLabel": "用户提供诗象（非周易象传）",
    "description": "这个卦是同卦（下坤上坤）相叠，阴性。象征地（与乾卦相反），顺从天。承载万\n物，伸展无穷无尽。坤卦以雌马为象征，表明地道生育抚养万物，而又依天顺时，性情\n温顺。它以“先迷后得”证明“坤”顺从“乾”，依随“乾”，才能把握正确方向，遵\n循正道，获取吉利。",
    "sourceRef": {
      "sourceId": "user-grade-table",
      "startChar": 148,
      "endChar": 328,
      "startLine": 7,
      "endLine": 13
    },
    "trigramNamesFromDescription": [
      "坤",
      "坤"
    ],
    "canonicalGrade": "上上卦"
  },
  {
    "id": 3,
    "name": "水雷屯",
    "alias": "屯卦",
    "theme": "起始维艰",
    "rawGrade": "下下卦",
    "gradeSource": "user-grade-table",
    "poem": "风刮乱丝不见头，颠三倒四犯忧愁，慢从款来左顺遂，急促反惹不自由。",
    "poemLabel": "用户提供诗象（非周易象传）",
    "description": "这个卦是异卦（下震上坎）相叠，震为雷，喻动；坎为雨，喻险。雷雨交加，险象\n丛生，环境恶劣。“屯”原指植物萌生大地。万物始生，充满艰难险阻，然而顺时应\n运，必欣欣向荣。",
    "sourceRef": {
      "sourceId": "user-grade-table",
      "startChar": 328,
      "endChar": 467,
      "startLine": 14,
      "endLine": 19
    },
    "trigramNamesFromDescription": [
      "震",
      "坎"
    ],
    "canonicalGrade": "下下卦"
  },
  {
    "id": 4,
    "name": "山水蒙",
    "alias": "蒙卦",
    "theme": "启蒙奋发",
    "rawGrade": "中下卦",
    "gradeSource": "user-grade-table",
    "poem": "卦中爻象犯小耗，君子占之运不高，婚姻合伙有琐碎，做事必然受苦劳。",
    "poemLabel": "用户提供诗象（非周易象传）",
    "description": "这个卦是异卦（下坎上艮）相叠，艮是山的形象，喻止；坎是水的形象，喻险。卦\n形为山下有险，仍不停止前进，是为蒙昧，故称蒙卦。但因把握时机，行动切合时宜，\n因此，具有启蒙和通达的卦象。",
    "sourceRef": {
      "sourceId": "user-grade-table",
      "startChar": 467,
      "endChar": 613,
      "startLine": 20,
      "endLine": 25
    },
    "trigramNamesFromDescription": [
      "坎",
      "艮"
    ],
    "canonicalGrade": "中下卦"
  },
  {
    "id": 5,
    "name": "水天需",
    "alias": "需卦",
    "theme": "守正待机",
    "rawGrade": "中上卦",
    "gradeSource": "user-grade-table",
    "poem": "明珠土埋日久深，无光无亮到如今，忽然大风吹土去，自然显露有重新。",
    "poemLabel": "用户提供诗象（非周易象传）",
    "description": "这个卦是异卦（下乾上坎）相叠，下卦是乾，刚健之意；上卦是坎，险陷之意。以\n刚逢险，宜稳健之妥，不可冒失行动，观时待变，所往一定成功。",
    "sourceRef": {
      "sourceId": "user-grade-table",
      "startChar": 613,
      "endChar": 735,
      "startLine": 26,
      "endLine": 30
    },
    "trigramNamesFromDescription": [
      "乾",
      "坎"
    ],
    "canonicalGrade": "中上卦"
  },
  {
    "id": 6,
    "name": "天水讼",
    "alias": "讼卦",
    "theme": "慎争戒讼",
    "rawGrade": "中下卦",
    "gradeSource": "user-grade-table",
    "poem": "心中有事事难做，恰是二人争路走，雨下俱是要占先，谁肯让谁走一步。",
    "poemLabel": "用户提供诗象（非周易象传）",
    "description": "这个卦是异卦（下坎上乾）相叠。同需卦相反，互为“综卦”。乾为刚健，坎为险\n陷。刚与险，健与险，彼此反对，定生争讼。争讼非善事，务必慎重戒惧。",
    "sourceRef": {
      "sourceId": "user-grade-table",
      "startChar": 735,
      "endChar": 861,
      "startLine": 31,
      "endLine": 35
    },
    "trigramNamesFromDescription": [
      "坎",
      "乾"
    ],
    "canonicalGrade": "中下卦"
  },
  {
    "id": 7,
    "name": "地水师",
    "alias": "师卦",
    "theme": "行险而顺",
    "rawGrade": "中上卦",
    "gradeSource": "user-grade-table",
    "poem": "将帅领旨去出征，骑着烈马拉硬弓，百步穿杨去得准，箭中金钱喜气生。",
    "poemLabel": "用户提供诗象（非周易象传）",
    "description": "这个卦是异卦（下坎上坤）相叠。“师”指军队。坎为水、为险；坤为地、为顺，\n喻寓兵于农。兵凶战危，用兵乃圣人不得已而为之，但它可以顺利无阻碍地解决矛盾，\n因为顺乎形势，师出有名，故能化凶为吉。",
    "sourceRef": {
      "sourceId": "user-grade-table",
      "startChar": 861,
      "endChar": 1012,
      "startLine": 36,
      "endLine": 41
    },
    "trigramNamesFromDescription": [
      "坎",
      "坤"
    ],
    "canonicalGrade": "中上卦"
  },
  {
    "id": 8,
    "name": "水地比",
    "alias": "比卦",
    "theme": "诚信团结",
    "rawGrade": "上上卦",
    "gradeSource": "user-grade-table",
    "poem": "顺风行船撒起帆，上天又助一蓬风，不用费力逍遥去，任意而行大亨通。",
    "poemLabel": "用户提供诗象（非周易象传）",
    "description": "这个卦是异卦（下坤上坎）相叠，坤为地；坎为水。水附大地，地纳河海，相互依\n赖，亲密无间。此卦与师卦完全相反，互为综卦。它阐述的是相亲相辅，宽宏无私，精\n诚团结的道理。",
    "sourceRef": {
      "sourceId": "user-grade-table",
      "startChar": 1012,
      "endChar": 1151,
      "startLine": 42,
      "endLine": 47
    },
    "trigramNamesFromDescription": [
      "坤",
      "坎"
    ],
    "canonicalGrade": "上上卦"
  },
  {
    "id": 9,
    "name": "风天小畜",
    "alias": "小畜卦",
    "theme": "蓄养待进",
    "rawGrade": "下下卦",
    "gradeSource": "user-grade-table",
    "poem": "苗逢旱天尽焦梢，水想云浓雨不浇，农人仰面长吁气，是从款来莫心高。",
    "poemLabel": "用户提供诗象（非周易象传）",
    "description": "这个卦是异卦（下乾上巽）相叠，乾为天；巽为风。喻风调雨顺，谷物滋长，故卦\n名小畜（蓄）。力量有限，须待发展到一定程度，才可大有作为。",
    "sourceRef": {
      "sourceId": "user-grade-table",
