[
  {
    "recordId": "hex-04-line-6",
    "field": "image",
    "retained": "“利用御寇”，上下顺也。",
    "reference": "利御寇，上下顺也。",
    "referenceId": "zhouyi-04",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%92%99&oldid=10645379&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-05-line-2",
    "field": "image",
    "retained": "“需于沙”，衍在中也；虽有小言，以终吉也。",
    "reference": "需于沙，衍在中也。虽小有言，以吉终也。",
    "referenceId": "zhouyi-05",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%9C%80&oldid=10643261&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-09-line-3",
    "field": "text",
    "retained": "舆说辐，夫妻反目。",
    "reference": "车说輹，夫妻反目。",
    "referenceId": "zhouyi-09",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%B0%8F%E7%95%9C&oldid=10645530&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-09-line-6",
    "field": "text",
    "retained": "既雨既处，尚德载；妇贞厉，月几望；君子征凶。",
    "reference": "既雨既处，尚得载，妇贞厉，月几望，君子征凶。",
    "referenceId": "zhouyi-09",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%B0%8F%E7%95%9C&oldid=10645530&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-10",
    "field": "judgement",
    "retained": "履：履虎尾，不咥人，亨。",
    "reference": "履虎尾，不咥人，亨。",
    "referenceId": "zhouyi-10",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%B1%A5&oldid=10647513&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-10",
    "field": "image",
    "retained": "上天下泽，“履”；君子以辩上下，定民志。",
    "reference": "上天下泽，履；君子以辨上下，定民志。",
    "referenceId": "zhouyi-10",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%B1%A5&oldid=10647513&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-10-line-6",
    "field": "text",
    "retained": "视履考祥，其旋元吉。",
    "reference": "视履考详，其旋元吉。",
    "referenceId": "zhouyi-10",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%B1%A5&oldid=10647513&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-12",
    "field": "judgement",
    "retained": "否：否之匪人，不利，君子贞；大往小来。",
    "reference": "否之匪人，不利君子贞，大往小来。",
    "referenceId": "zhouyi-12",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%90%A6&oldid=10645603&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-12-line-5",
    "field": "text",
    "retained": "休否，大人吉；其亡其亡，系于苞桑。",
    "reference": "休否，大人吉。其亡其亡，系于包桑。",
    "referenceId": "zhouyi-12",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%90%A6&oldid=10645603&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-13",
    "field": "judgement",
    "retained": "同人，同人于野，亨，利涉大川，利君子贞。",
    "reference": "同人于野，亨。 利涉大川，利君子贞。",
    "referenceId": "zhouyi-13",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%90%8C%E4%BA%BA&oldid=10645635&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-13-line-4",
    "field": "text",
    "retained": "乘其墉，弗克攻，吉。",
    "reference": "乘其庸，弗克攻，吉。",
    "referenceId": "zhouyi-13",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%90%8C%E4%BA%BA&oldid=10645635&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-13-line-4",
    "field": "image",
    "retained": "“乘其墉”，义弗克也，其“吉”，则困而反则也。",
    "reference": "乘其庸，义弗克也，其吉，则困而反则也。",
    "referenceId": "zhouyi-13",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%90%8C%E4%BA%BA&oldid=10645635&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-13-line-5",
    "field": "text",
    "retained": "同人，先号咷，而后笑，大师克相遇。",
    "reference": "同人，先号啕而后笑。大师克相遇。",
    "referenceId": "zhouyi-13",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%90%8C%E4%BA%BA&oldid=10645635&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-14-line-2",
    "field": "text",
    "retained": "大车以载，有攸往，无咎。",
    "reference": "大轝以载，有攸往，无咎。",
    "referenceId": "zhouyi-14",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%A4%A7%E6%9C%89&oldid=10645712&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-14-line-2",
    "field": "image",
    "retained": "“大车以载”，积中不败也。",
    "reference": "大轝以载，积中不败也。",
    "referenceId": "zhouyi-14",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%A4%A7%E6%9C%89&oldid=10645712&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-14-line-4",
    "field": "text",
    "retained": "匪其彭，无咎。",
    "reference": "匪其尫，无咎。",
    "referenceId": "zhouyi-14",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%A4%A7%E6%9C%89&oldid=10645712&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-14-line-4",
    "field": "image",
    "retained": "“匪其彭，无咎”，明辨晢也。",
    "reference": "匪其彭，无咎；明辨晰也。",
    "referenceId": "zhouyi-14",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%A4%A7%E6%9C%89&oldid=10645712&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-15-line-4",
    "field": "text",
    "retained": "无不利，挥谦。",
    "reference": "无不利，㧑谦。",
    "referenceId": "zhouyi-15",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%AC%99&oldid=2106142&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-15-line-4",
    "field": "image",
    "retained": "“无不利，挥谦”，不违则也。",
    "reference": "无不利㧑谦；不违则也。",
    "referenceId": "zhouyi-15",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%AC%99&oldid=2106142&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-16-line-4",
    "field": "text",
    "retained": "由豫，大有得；勿疑，朋盍簪。",
    "reference": "由豫，大有得。勿疑。朋盍戠。",
    "referenceId": "zhouyi-16",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%B1%AB&oldid=10645735&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-17-line-2",
    "field": "text",
    "retained": "係小子，失丈夫。",
    "reference": "系小子，失丈夫。",
    "referenceId": "zhouyi-17",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%9A%A8&oldid=10645020&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-17-line-2",
    "field": "image",
    "retained": "“係小子”，弗兼与也。",
    "reference": "系小子，弗兼与也。",
    "referenceId": "zhouyi-17",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%9A%A8&oldid=10645020&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-17-line-3",
    "field": "text",
    "retained": "係丈夫，失小子。随有求得，利居贞。",
    "reference": "系丈夫，失小子。随，有求得利，居贞。",
    "referenceId": "zhouyi-17",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%9A%A8&oldid=10645020&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-17-line-3",
    "field": "image",
    "retained": "“係丈夫”，志舍下也。",
    "reference": "系丈夫，志舍下也。",
    "referenceId": "zhouyi-17",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%9A%A8&oldid=10645020&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-17-line-6",
    "field": "text",
    "retained": "拘係之，乃从，维之；王用亨于西山。",
    "reference": "拘系之，乃从维之。王用亨于西山。",
    "referenceId": "zhouyi-17",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%9A%A8&oldid=10645020&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-17-line-6",
    "field": "image",
    "retained": "“拘係之”，上穷也。",
    "reference": "拘系之，上穷也。",
    "referenceId": "zhouyi-17",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%9A%A8&oldid=10645020&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-20",
    "field": "judgement",
    "retained": "观：盥而不荐，有孚顒若。",
    "reference": "观：盥而不荐，有孚颙若。",
    "referenceId": "zhouyi-20",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%A7%80&oldid=10645159&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-20-line-2",
    "field": "text",
    "retained": "闚观，利女贞。",
    "reference": "窥观，利女贞。",
    "referenceId": "zhouyi-20",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%A7%80&oldid=10645159&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-20-line-2",
    "field": "image",
    "retained": "“闚观，女贞”，亦可丑也。",
    "reference": "窥观女贞，亦可丑也。",
    "referenceId": "zhouyi-20",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%A7%80&oldid=10645159&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-21-line-3",
    "field": "text",
    "retained": "噬腊肉，遇毒；小吝，无咎。",
    "reference": "噬昔肉，遇毒；小吝，无咎。",
    "referenceId": "zhouyi-21",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%99%AC%E5%97%91&oldid=10645753&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-22-line-4",
    "field": "image",
    "retained": "“六四当位，疑也；”“非寇婚媾”，终无尤也。",
    "reference": "六四，当位疑也。匪寇婚媾，终无尤也。",
    "referenceId": "zhouyi-22",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%B3%81&oldid=2405035&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-23",
    "field": "image",
    "retained": "山附于地，剥；上以厚下安宅。",
    "reference": "山附地上，剥；上以厚下，安宅。",
    "referenceId": "zhouyi-23",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%89%9D&oldid=10645800&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-23-line-6",
    "field": "text",
    "retained": "硕果不食，君子得舆，小人剥庐。",
    "reference": "硕果不食，君子德车，小人剥庐。",
    "referenceId": "zhouyi-23",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%89%9D&oldid=10645800&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-24-line-1",
    "field": "text",
    "retained": "不远复，无祗悔，元吉。",
    "reference": "不远复，无祇悔，元吉。",
    "referenceId": "zhouyi-24",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%BE%A9&oldid=10643037&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-26-line-3",
    "field": "text",
    "retained": "良马逐，利艰贞。日闲舆卫，利有攸往。",
    "reference": "良马逐，利艰贞，吉。日闲舆卫，利有攸往。",
    "referenceId": "zhouyi-26",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%A4%A7%E7%95%9C&oldid=10646304&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-26-line-4",
    "field": "text",
    "retained": "童牛之牿，元吉。",
    "reference": "童牛之告，元吉。",
    "referenceId": "zhouyi-26",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%A4%A7%E7%95%9C&oldid=10646304&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-27",
    "field": "image",
    "retained": "山下有雷，君子以慎言语，节饮食。",
    "reference": "山下有雷，颐；君子以慎言语，节饮食。",
    "referenceId": "zhouyi-27",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%A0%A4&oldid=10643091&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-28",
    "field": "image",
    "retained": "“泽灭木，大过；君子以独立不惧，遯世无闷。”",
    "reference": "泽灭木，大过。君子以独立不惧，遁世无闷。",
    "referenceId": "zhouyi-28",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%A4%A7%E9%81%8E&oldid=10645184&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-29-line-4",
    "field": "text",
    "retained": "樽酒，簋贰，用缶，纳约自牖，终无咎。",
    "reference": "尊酒簋，贰用缶。内约自牖，终无咎。",
    "referenceId": "zhouyi-29",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%9D%8E&oldid=10646381&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-29-line-4",
    "field": "image",
    "retained": "“樽酒簋贰”，刚柔际也。",
    "reference": "樽酒簋贰，刚柔济也。",
    "referenceId": "zhouyi-29",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%9D%8E&oldid=10646381&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-29-line-5",
    "field": "text",
    "retained": "坎不盈，祇既平，无咎。",
    "reference": "坎不盈，禔既平，无咎。",
    "referenceId": "zhouyi-29",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%9D%8E&oldid=10646381&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-29-line-6",
    "field": "text",
    "retained": "系用徵纆，置于丛棘，三岁不得，凶。",
    "reference": "系用徽𬙊，寘于丛棘，三岁不得，凶。",
    "referenceId": "zhouyi-29",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%9D%8E&oldid=10646381&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-30-line-3",
    "field": "text",
    "retained": "日昃之离，不鼓缶而歌，则大耋之嗟，凶。",
    "reference": "日昃之离，不鼓缶而歌，则大耋之差，凶。",
    "referenceId": "zhouyi-30",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%9B%A2&oldid=10646424&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-30-line-6",
    "field": "text",
    "retained": "王用出征，用嘉折首，获匪其丑，无咎。",
    "reference": "王用出征，有嘉折首，获匪其丑，无咎。",
    "referenceId": "zhouyi-30",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%9B%A2&oldid=10646424&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-32-line-6",
    "field": "text",
    "retained": "振恒，凶。",
    "reference": "震恒，凶。",
    "referenceId": "zhouyi-32",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E6%81%92&oldid=10646486&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-33",
    "field": "judgement",
    "retained": "遯：亨，小利贞。",
    "reference": "遁：亨。小利贞。",
    "referenceId": "zhouyi-33",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%81%AF&oldid=10645108&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-33",
    "field": "image",
    "retained": "“天下有山，遯；君子以远小人，不恶而严。”",
    "reference": "天下有山，遁；君子以远小人，不恶而严。",
    "referenceId": "zhouyi-33",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%81%AF&oldid=10645108&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-33-line-1",
    "field": "text",
    "retained": "遯尾；厉。勿用有攸往。",
    "reference": "遁尾，厉，勿用有攸往。",
    "referenceId": "zhouyi-33",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%81%AF&oldid=10645108&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-33-line-1",
    "field": "image",
    "retained": "遯尾之厉，不往何灾也？",
    "reference": "遁尾之厉，不往何灾也。",
    "referenceId": "zhouyi-33",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%81%AF&oldid=10645108&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-33-line-3",
    "field": "text",
    "retained": "系遯，有疾厉，畜臣妾，吉。",
    "reference": "系遁，有疾厉，畜臣妾吉。",
    "referenceId": "zhouyi-33",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%81%AF&oldid=10645108&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-33-line-3",
    "field": "image",
    "retained": "“系遯之厉”，有疾惫也。“畜臣妾吉”，不可大事也。",
    "reference": "系遁之厉，有疾惫也。畜臣妾吉，不可大事也。",
    "referenceId": "zhouyi-33",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%81%AF&oldid=10645108&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-33-line-4",
    "field": "text",
    "retained": "好遯，君子吉，小人否。",
    "reference": "好遁君子吉，小人否。",
    "referenceId": "zhouyi-33",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%81%AF&oldid=10645108&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-33-line-4",
    "field": "image",
    "retained": "“君子好遯，小人否也。”",
    "reference": "君子好遁，小人否也。",
    "referenceId": "zhouyi-33",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%81%AF&oldid=10645108&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-33-line-5",
    "field": "text",
    "retained": "嘉遯，贞吉。",
    "reference": "嘉遁，贞吉。",
    "referenceId": "zhouyi-33",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%81%AF&oldid=10645108&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-33-line-5",
    "field": "image",
    "retained": "“嘉遯，贞吉”，以正志也。",
    "reference": "嘉遁贞吉，以正志也。",
    "referenceId": "zhouyi-33",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%81%AF&oldid=10645108&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-33-line-6",
    "field": "text",
    "retained": "肥遯无不利。",
    "reference": "肥遁，无不利。",
    "referenceId": "zhouyi-33",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%81%AF&oldid=10645108&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-33-line-6",
    "field": "image",
    "retained": "“肥遯无不利”，无所疑也。",
    "reference": "肥遁，无不利；无所疑也。",
    "referenceId": "zhouyi-33",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%81%AF&oldid=10645108&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-34-line-1",
    "field": "image",
    "retained": "“壮于趾”，孚穷也。",
    "reference": "壮于趾，其孚穷也。",
    "referenceId": "zhouyi-34",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%A4%A7%E5%A3%AF&oldid=10646529&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-34-line-4",
    "field": "text",
    "retained": "贞吉，悔亡；藩决不羸，壮于大舆之輹。",
    "reference": "贞吉悔亡，藩决不羸，壮于大轝之腹。",
    "referenceId": "zhouyi-34",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%A4%A7%E5%A3%AF&oldid=10646529&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-35-line-1",
    "field": "image",
    "retained": "“晋如摧如”，独行正也；“裕无咎”，未受命。",
    "reference": "晋如，摧如；独行正也。裕无咎；未受命也。",
    "referenceId": "zhouyi-35",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E6%99%89&oldid=10646579&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-35-line-5",
    "field": "text",
    "retained": "悔亡，失得勿恤；往吉，无不利。",
    "reference": "悔亡，矢得勿恤，往吉无不利。",
    "referenceId": "zhouyi-35",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E6%99%89&oldid=10646579&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-36-line-2",
    "field": "image",
    "retained": "“六二之吉”，顺而则也。",
    "reference": "六二之吉，顺以则也。",
    "referenceId": "zhouyi-36",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E6%98%8E%E5%A4%B7&oldid=10644507&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-38-line-3",
    "field": "text",
    "retained": "见舆曳，其牛掣；其人天且劓。无初有终。",
    "reference": "见舆曳，其牛𧤊，其人天且劓，无初有终。",
    "referenceId": "zhouyi-38",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E7%9D%BD&oldid=10646622&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-39-line-4",
    "field": "image",
    "retained": "“往蹇来连”，位当实也。",
    "reference": "往蹇来连，当位实也。",
    "referenceId": "zhouyi-39",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%B9%87&oldid=2405036&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-40-line-5",
    "field": "text",
    "retained": "君子维有解，吉，有孚于小人。",
    "reference": "君子惟有解，吉；有孚于小人。",
    "referenceId": "zhouyi-40",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%A7%A3&oldid=10646666&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-41-line-1",
    "field": "text",
    "retained": "已事遄往，无咎；酌损之。",
    "reference": "祀事遄往，无咎，酌损之。",
    "referenceId": "zhouyi-41",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E6%90%8D&oldid=10646704&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-41-line-6",
    "field": "text",
    "retained": "弗损益之；无咎，贞吉，有攸往，得臣无家。",
    "reference": "弗损益之，无咎，贞吉，利有攸往，得臣无家。",
    "referenceId": "zhouyi-41",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E6%90%8D&oldid=10646704&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-43-line-2",
    "field": "image",
    "retained": "“有戎勿恤”，得中道也。",
    "reference": "莫夜有戎，得中道也。",
    "referenceId": "zhouyi-43",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%A4%AC&oldid=2405003&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-45",
    "field": "judgement",
    "retained": "萃：亨；王假有庙，利见大人，亨利贞，用大牲吉，利有攸往。",
    "reference": "萃：王假有庙，利见大人，亨。利贞。用大牲吉，利有攸往。",
    "referenceId": "zhouyi-45",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%90%83&oldid=10647546&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-45-line-6",
    "field": "text",
    "retained": "赍咨涕洟，无咎。",
    "reference": "赍资涕洟，无咎。",
    "referenceId": "zhouyi-45",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%90%83&oldid=10647546&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-46-line-4",
    "field": "text",
    "retained": "王用亨于岐山，吉，无咎。",
    "reference": "王用享于岐山，吉无咎。",
    "referenceId": "zhouyi-46",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%8D%87&oldid=10646879&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-47-line-2",
    "field": "text",
    "retained": "困于酒食，朱绂方来，利用享祀；征凶，无咎。",
    "reference": "困于酒食，朱绂方来，利用亨祀，征凶，无咎。",
    "referenceId": "zhouyi-47",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%9B%B0&oldid=10647032&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-47-line-3",
    "field": "text",
    "retained": "困于石，据于蒺藜；入于其宫，不见其妻，凶。",
    "reference": "困于石，据于蒺蔾，入于其宫，不见其妻，凶。",
    "referenceId": "zhouyi-47",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%9B%B0&oldid=10647032&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-47-line-4",
    "field": "text",
    "retained": "来徐徐，困于金车，吝，有终。",
    "reference": "来荼荼，困于金轝，吝，有终。",
    "referenceId": "zhouyi-47",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E5%9B%B0&oldid=10647032&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-48-line-5",
    "field": "text",
    "retained": "井洌，寒泉食。",
    "reference": "井冽，寒泉食。",
    "referenceId": "zhouyi-48",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E4%BA%95&oldid=10645240&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-49",
    "field": "judgement",
    "retained": "革：己日乃孚，元亨，利贞，悔亡。",
    "reference": "革：已日乃孚，元亨。利贞。悔亡。",
    "referenceId": "zhouyi-49",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%9D%A9&oldid=10643173&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-49-line-2",
    "field": "text",
    "retained": "己日乃革之，征吉，无咎。",
    "reference": "已日乃革之，征吉，无咎。",
    "referenceId": "zhouyi-49",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%9D%A9&oldid=10643173&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-49-line-2",
    "field": "image",
    "retained": "“己日革之”，行有佳也。",
    "reference": "已日革之，行有嘉也。",
    "referenceId": "zhouyi-49",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%9D%A9&oldid=10643173&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-50-line-4",
    "field": "text",
    "retained": "鼎折足，覆公餗，其形渥，凶。",
    "reference": "鼎折足，覆公𫗧，其刑渥，凶。",
    "referenceId": "zhouyi-50",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%BC%8E&oldid=10647086&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-50-line-4",
    "field": "image",
    "retained": "“覆公餗”，信如何也！",
    "reference": "覆公𫗧，信如何也。",
    "referenceId": "zhouyi-50",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E9%BC%8E&oldid=10647086&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-52-line-3",
    "field": "text",
    "retained": "艮其限，列其夤，厉薰心。",
    "reference": "艮其限，裂其夤，厉阍心。",
    "referenceId": "zhouyi-52",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%89%AE&oldid=10647135&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-52-line-3",
    "field": "image",
    "retained": "“艮其限”，危薰心也。",
    "reference": "艮其限，危熏心也。",
    "referenceId": "zhouyi-52",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%89%AE&oldid=10647135&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-52-line-5",
    "field": "text",
    "retained": "艮其辅，言有序，悔亡。",
    "reference": "艮其辅，言有孚，悔亡。",
    "referenceId": "zhouyi-52",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%89%AE&oldid=10647135&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-55-line-6",
    "field": "text",
    "retained": "丰其屋，蔀其家，闚其户，阒其无人，三岁不觌，凶。",
    "reference": "丰其屋，蔀其家，窥其户，阒其无人，三岁不觌，凶。",
    "referenceId": "zhouyi-55",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%B1%90&oldid=10645290&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-55-line-6",
    "field": "image",
    "retained": "“丰其屋”，天际翔也；“闚其户，阒其无人”，自藏也。",
    "reference": "丰其屋，天际翔也。窥其户，阒其无人，自藏也。",
    "referenceId": "zhouyi-55",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E8%B1%90&oldid=10645290&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-56-line-2",
    "field": "text",
    "retained": "旅即次，怀其资，得童仆，贞。",
    "reference": "旅即次，怀其资，得僮仆贞。",
    "referenceId": "zhouyi-56",
    "url": "https://zh.wikisource.org/w/index.php?title=%E5%91%A8%E6%98%93%2F%E6%97%85&oldid=10647234&variant=zh-hans",
    "status": "difference-retained; not automatically classified as error"
  },
  {
    "recordId": "hex-56-line-3",
    "field": "text",
    "retained": "旅焚其次，丧其童仆；贞厉。",
    "reference": "旅焚其次，丧其僮仆，贞厉。",
    "referenceId": "zhouyi-56",
