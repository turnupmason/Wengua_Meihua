# Copy to .env (never commit .env). Without these keys the app runs on the device only and
# every reading stays open (内测). See docs/IOS_APP_STORE_RELEASE.md.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# RevenueCat → Project → API keys → App Store public key (appl_...)
VITE_REVENUECAT_IOS_KEY=

# Google Cloud → Credentials → OAuth client IDs (iOS client, and the Web client given to Supabase)
VITE_GOOGLE_IOS_CLIENT_ID=
VITE_GOOGLE_WEB_CLIENT_ID=

# Optional: another address for the privacy policy (default https://wengualabs.com/privacy)
VITE_PRIVACY_URL=
# Optional: your own terms; Apple's standard licence is used otherwise
VITE_TERMS_URL=
