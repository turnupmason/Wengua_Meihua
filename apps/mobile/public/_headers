# Cloudflare (app.wengualabs.com) response headers. Ignored by the iOS app.
# Files under /assets/ carry a content hash in their names, so browsers may keep them for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
